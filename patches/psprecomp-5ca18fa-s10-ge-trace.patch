 #include <stdlib.h>
 #include <string.h>
@@ -542,10 +543,18 @@ static int read_vertex(uint32_t addr, uint32_t vtype, int tex_off, int col_off,
 
 /* PSPRECOMP_TRACE_GE=<frame> logs every primitive drawn during that vblank:
  * what it is, its vertex format, and the texture state it is drawn with. */
+static _Atomic uint64_t g_trace_frame = UINT64_MAX;
+
+void psp_ge_trace_next_frame(void) {
+    atomic_store(&g_trace_frame, psp_display_vblanks() + 2);
+}
+
 static int trace_frame(void) {
     static long f = -2;
     if (f == -2) { const char *e = getenv("PSPRECOMP_TRACE_GE"); f = e ? atol(e) : -1; }
-    return f >= 0 && (long)psp_display_vblanks() == f;
+    const uint64_t vb = psp_display_vblanks();
+    const uint64_t target = atomic_load(&g_trace_frame);
+    return (f >= 0 && (long)vb == f) || (vb >= target && vb - target < 4);
 }
 
 static void draw_prim(uint32_t type, uint32_t count) {
@@ -584,6 +593,38 @@ static void draw_prim(uint32_t type, uint32_t count) {
     else     g_ge.vaddr += count * (uint32_t)stride;
 
     if (trace_frame()) {
+        if (!VT_THROUGH(g_ge.vtype)) {
+            int minx = 0, maxx = 0, miny = 0, maxy = 0, visible = 0, front = 0;
+            for (uint32_t j = 0; j < n; j++) {
+                if (v[j].behind) continue;
+                if (!front || v[j].x < minx) minx = v[j].x;
+                if (!front || v[j].x > maxx) maxx = v[j].x;
+                if (!front || v[j].y < miny) miny = v[j].y;
+                if (!front || v[j].y > maxy) maxy = v[j].y;
+                front++;
+                visible += v[j].x >= 0 && v[j].x < 480 && v[j].y >= 0 && v[j].y < 272;
+            }
+            fprintf(stderr, "  bounds x=%d..%d y=%d..%d front=%d onscreen=%d/%u\n",
+                    minx, maxx, miny, maxy, front, visible, n);
+            const float *matrices[] = { g_xf.world, g_xf.view, g_xf.proj };
+            for (int m = 0; m < 3; m++) {
+                fprintf(stderr, "  %s", m == 0 ? "world" : m == 1 ? "view" : "projection");
+                for (int j = 0; j < (m == 2 ? 16 : 12); j++)
+                    fprintf(stderr, " %.7g", (double)matrices[m][j]);
+                fputc('\n', stderr);
+            }
+            fprintf(stderr, "  viewport scale=(%g,%g,%g) pos=(%g,%g,%g) offset=(%g,%g)\n",
+                    (double)g_xf.xscale, (double)g_xf.yscale, (double)g_xf.zscale,
+                    (double)g_xf.xpos, (double)g_xf.ypos, (double)g_xf.zpos,
+                    (double)g_xf.offx, (double)g_xf.offy);
+            for (uint32_t j = 0; !isz && j < n && j < 3; j++) {
+                float p[3];
+                read3(g_ge.vaddr - count * (uint32_t)stride + j * (uint32_t)stride +
+                      (uint32_t)pos_off, (int)VT_POS(g_ge.vtype), 0, p);
+                fprintf(stderr, "  model%u=(%g,%g,%g)\n", j,
+                        (double)p[0], (double)p[1], (double)p[2]);
+            }
+        }
         fprintf(stderr, "  mat %08X cbp %08X lt %d tex0 %08X\n", g_material, g_cbp, g_lt.enable,
                 psp_read32(g_ds.tex_addr));
         for (uint32_t k = 0; k < n && k < 16; k++)
@@ -610,5 +651,9 @@ static void draw_prim(uint32_t type, uint32_t count) {
             fprintf(stderr, "  v%u (%d,%d,%.0f) rgba %08X uv %.1f %.1f texel %08X\n", k, v[k].x, v[k].y,
                     (double)v[k].z, v[k].rgba, v[k].u, v[k].v, psp_tex_fetch(&g_ds, (int)v[k].u, (int)v[k].v));
     }
+    const int tracing = trace_frame();
+    const uint64_t before = tracing ? psp_render_pixels() : 0;
     if (n) psp_render_current()->draw((int)type, v, (int)n, &g_ds);
+    if (tracing) fprintf(stderr, "  drawn pixels=%llu\n",
+                         (unsigned long long)(psp_render_pixels() - before));
 }
