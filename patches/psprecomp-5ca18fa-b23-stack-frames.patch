+static void split_stack_epilogue(void) {
+    const uint32_t body_sp = psp_cpu.r[PSP_REG_SP];
+    psp_cpu.r[PSP_REG_SP] += psp_cpu.r[PSP_REG_A0];
+    if (!psp_ra_is_jump(psp_cpu.r[PSP_REG_RA]))
+        psp_trace_sp(0x08804010u, body_sp, psp_cpu.r[PSP_REG_SP]);
+}
+
+static void split_stack_prologue(void) {
+    psp_cpu.r[PSP_REG_SP] -= 16u;
+    split_stack_epilogue();
+}
+
+static void test_split_stack_return(void) {
+    const uint32_t sp = 0x09FFF000u;
+    const uint64_t violations = psp_sp_violations();
+    psp_register(0x08804000u, split_stack_prologue);
+    psp_cpu.r[PSP_REG_SP] = sp;
+    psp_cpu.r[PSP_REG_A0] = 16u;
+    psp_call_from_host(0x08804000u);
+    CHECK_EQ(psp_cpu.r[PSP_REG_SP], sp, "the epilogue restored the guest stack");
+    CHECK(psp_sp_violations() == violations, "a split epilogue restores the original call frame");
+
+    psp_cpu.r[PSP_REG_A0] = 0;
+    psp_call_from_host(0x08804000u);
+    CHECK_EQ(psp_cpu.r[PSP_REG_SP], sp - 16u, "the second epilogue left the frame allocated");
+    CHECK(psp_sp_violations() == violations + 1, "the stack checker detects a real leak");
+
+    psp_cpu.r[PSP_REG_SP] = sp;
+    psp_cpu.r[PSP_REG_A0] = 20u;
+    psp_call_from_host(0x08804000u);
+    CHECK(psp_sp_violations() == violations + 2, "the stack checker detects over-release");
+
+    psp_frame caller = { .ret = 0x08804100u, .sp = sp };
+    psp_frame helper = { .ret = 0x08804200u, .sp = sp - 16u, .prev = &caller };
+    psp_cpu.frame = &helper;
+    CHECK(!psp_ra_is_jump(caller.ret), "jr $ra unwinds through the helper");
+    psp_trace_sp(0x08804010u, helper.sp, caller.sp);
+    CHECK(psp_sp_violations() == violations + 2, "a nonlocal return uses the destination frame");
+    psp_cpu.frame = NULL;
+    psp_cpu.unwind = 0;
+}
