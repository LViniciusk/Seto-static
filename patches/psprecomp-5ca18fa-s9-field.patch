+/* vcmovt.v / vcmovf.v -- conditional move. `imm` is the instruction's 4-bit
+ * selector (rt bits 16..19): 0..3 pick the per-lane compare bits, 4 the "any"
+ * bit, 5 the "all" bit, 6/7 are the constant false/true, and bit 3 inverts
+ * (the vcmovf form). Nothing is written when the condition fails, which is
+ * what makes it a conditional move rather than a blend. */
+void psp_vcmov(uint32_t vd, uint32_t vs, int size, int imm) {
+    const int bit = imm & 7;
+    int take;
+    if (bit < 6) take = (int)((psp_cpu.vfpu_cc >> bit) & 1u);
+    else         take = bit == 7;
+    if (imm & 8) take = !take;
+    if (take) {
+        float s[4];
+        read_src(0, vs, size, s);
+        write_dst(vd, size, s);
+    }
+    end_op();
+}
+
 /* viim / vfim -- write a single lane from an immediate encoded in the
  * instruction. No prefixes apply: there is no source operand to rewrite. */
 void psp_vimm(uint32_t vd, float value) {
