@@ -65,6 +65,26 @@ int psp_display_capture(const char *path) {
     return 0;
 }
 
+/* Debug: write an arbitrary VRAM buffer with the display's current stride and
+ * format, so both halves of a swapchain can be compared with the presented
+ * frame. */
+int psp_display_dump_at(const char *path, uint32_t addr) {
+    const uint32_t stride = g_fb_width, fmt = g_fb_format;
+    const int bpp = (fmt == PSP_DISPLAY_PIXEL_FORMAT_8888) ? 4 : 2;
+    FILE *f = fopen(path, "wb");
+    if (!f) return -1;
+    fprintf(f, "P6\n%d %d\n255\n", PSP_SCREEN_W, PSP_SCREEN_H);
+    for (int y = 0; y < PSP_SCREEN_H; y++)
+        for (int x = 0; x < PSP_SCREEN_W; x++) {
+            const uint32_t at = addr + (uint32_t)(y * (int)stride + x) * (uint32_t)bpp;
+            const uint32_t c = psp_color_expand(bpp == 4 ? psp_read32(at) : psp_read16(at), (int)fmt);
+            uint8_t rgb[3] = { (uint8_t)c, (uint8_t)(c >> 8), (uint8_t)(c >> 16) };
+            fwrite(rgb, 1, 3, f);
+        }
+    fclose(f);
+    return 0;
+}
+
 /* The front buffer, converted, for a window or a capture. Read while the game
  * runs: a frame being drawn into the *back* buffer is never seen, which is the
  * point of the game double-buffering. */
