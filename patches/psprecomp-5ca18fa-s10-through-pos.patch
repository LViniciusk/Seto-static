-/* One 16-bit-position, 8888-colour vertex. Colour precedes position. */
+/* One 16-bit-position, 8888-colour vertex. Colour precedes position. Through
+ * positions are 12.4 fixed point, so a pixel coordinate is written as x * 16;
+ * the expectations below stay in whole pixels. */
 static void vertex(int idx, int x, int y, uint32_t rgba) {
     uint32_t a = VERTS + (uint32_t)idx * 12;   /* 4 colour + 6 pos, padded to 12 */
     psp_write32(a, rgba);
-    psp_write16(a + 4, (uint16_t)x);
-    psp_write16(a + 6, (uint16_t)y);
+    psp_write16(a + 4, (uint16_t)(x * 16));
+    psp_write16(a + 6, (uint16_t)(y * 16));
     psp_write16(a + 8, 0);
 }
 
@@ -295,8 +297,8 @@
     psp_write16(a + 0, (uint16_t)u);
