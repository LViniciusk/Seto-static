diff --git a/src/hle/ge.c b/src/hle/ge.c
--- a/src/hle/ge.c
+++ b/src/hle/ge.c
@@ -520,10 +520,26 @@
     read3(addr + (uint32_t)pos_off, (int)VT_POS(vtype), through, pos);
     out->behind = 0;
     if (through) {
-        /* Through mode's depth is an unsigned 16-bit value. */
-        out->x = (int)pos[0];
-        out->y = (int)pos[1];
-        out->z = VT_POS(vtype) == 2 ? (float)psp_read16(addr + (uint32_t)pos_off + 4) : pos[2];
+        /* 16-bit through positions are 12.4 fixed point, not whole pixels;
+         * read as pixels they stretch every 2D quad 16x (an earlier field
+         * capture lost its room under "full-screen" HUD rectangles that were
+         * 30x17). 8-bit through positions decode to zero on hardware, float
+         * positions are pixels and their depth is an integer. Sub-pixel
+         * positions are floored: the rasterizer is integer.
+         * shortcut: no sub-pixel precision in through mode, upgrade if 2D
+         * text or sprites visibly jitter. */
+        if (VT_POS(vtype) == 2) {
+            out->x = (int)floorf(pos[0] / 16.0f);
+            out->y = (int)floorf(pos[1] / 16.0f);
+            out->z = (float)psp_read16(addr + (uint32_t)pos_off + 4);
+        } else if (VT_POS(vtype) == 1) {
+            out->x = out->y = 0;
+            out->z = 0;
+        } else {
+            out->x = (int)floorf(pos[0]);
+            out->y = (int)floorf(pos[1]);
+            out->z = pos[2];
+        }
         return 1;
     }
     if (g_lt.enable) {
