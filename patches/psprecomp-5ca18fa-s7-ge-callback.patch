diff --git a/tests/test_hle.c b/tests/test_hle.c
index b41d6ef..3379ac2 100644
--- a/tests/test_hle.c
+++ b/tests/test_hle.c
@@ -534,6 +534,70 @@ static void test_ge_display_list(void) {
           "eDRAM is 2 MB");
 }
 
+/* A finished GE list must run the registered finish callback: the EBOOT's
+ * render queue retires lists there, and without it the queue never drains. */
+static uint32_t g_ge_cb_calls, g_ge_cb_id, g_ge_cb_arg;
+
+static void fake_ge_finish(void) {
+    g_ge_cb_calls++;
+    g_ge_cb_id  = psp_cpu.r[PSP_REG_A0];
+    g_ge_cb_arg = psp_cpu.r[PSP_REG_A1];
+}
+
+static void test_ge_callbacks(void) {
+    psp_ge_reset();
+
+    const uint32_t LIST = 0x08821000u;
+    const uint32_t CB   = 0x08822000u;
+    const uint32_t FN   = 0x08823000u;
+    psp_register(FN, fake_ge_finish);
+
+    psp_write32(LIST + 0, (0x0Fu << 24));   /* FINISH */
+    psp_write32(CB + 0, 0);                 /* signal_func */
+    psp_write32(CB + 4, 0);                 /* signal_arg */
+    psp_write32(CB + 8, FN);                /* finish_func */
+    psp_write32(CB + 12, 0x1234);           /* finish_arg */
+
+    g_ge_cb_calls = 0;
+    uint32_t id = call(psp_nid("sceGeSetCallback"), CB, 0, 0, 0);
+    CHECK(id == 0, "first GE callback id is 0, got 0x%08X", id);
+
+    psp_cpu.r[PSP_REG_S3] = 0x5A5A5A5A;
+    uint32_t qid = call(psp_nid("sceGeListEnQueue"), LIST, 0, id, 0);
+    CHECK(qid != 0, "list enqueued, got 0x%08X", qid);
+    CHECK(g_ge_cb_calls == 1, "the finish callback ran once, got %u", g_ge_cb_calls);
+    CHECK(g_ge_cb_id == id, "the callback receives its id, got %u", g_ge_cb_id);
+    CHECK(g_ge_cb_arg == 0x1234, "the callback receives its registered argument, got 0x%X",
+          g_ge_cb_arg);
+    CHECK(psp_cpu.r[PSP_REG_S3] == 0x5A5A5A5A,
+          "a GE callback does not disturb the caller's registers");
+
+    /* A list that stops at its stall is not finished. Releasing the stall
+     * finishes it once; a second update must not deliver a duplicate. */
+    g_ge_cb_calls = 0;
+    uint32_t stalled = call(psp_nid("sceGeListEnQueue"), LIST, LIST, id, 0);
+    CHECK(stalled != 0, "stalled list enqueued, got 0x%08X", stalled);
+    CHECK(g_ge_cb_calls == 0, "a list stopped at its stall has not finished");
+    CHECK(call(psp_nid("sceGeListUpdateStallAddr"), stalled, 0, 0, 0) == 0,
+          "stall release succeeds");
+    CHECK(g_ge_cb_calls == 1, "the released list finishes once, got %u", g_ge_cb_calls);
+    CHECK(call(psp_nid("sceGeListUpdateStallAddr"), stalled, 0, 0, 0) == 0,
+          "updating a finished list is harmless");
+    CHECK(g_ge_cb_calls == 1, "a finished list does not finish twice");
+
+    /* END releases the queue but is not the finish interrupt. */
+    psp_write32(LIST + 0, (0x0Cu << 24));   /* END */
+    g_ge_cb_calls = 0;
+    call(psp_nid("sceGeListEnQueue"), LIST, 0, id, 0);
+    CHECK(g_ge_cb_calls == 0, "END alone does not raise the finish callback");
+
+    psp_write32(LIST + 0, (0x0Fu << 24));   /* FINISH for the unset check */
+    CHECK(call(psp_nid("sceGeUnsetCallback"), id, 0, 0, 0) == 0, "unset succeeds");
+    g_ge_cb_calls = 0;
+    call(psp_nid("sceGeListEnQueue"), LIST, 0, id, 0);
+    CHECK(g_ge_cb_calls == 0, "an unset callback is not called");
+}
+
 /* A list that jumps to itself must terminate rather than hang the host -- this
  * is a normal transient state while the CPU is still writing the list. */
 static void test_ge_infinite_list(void) {
@@ -903,6 +967,7 @@ int main(void) {
     test_vpl();
     test_guest_strings();
     test_ge_display_list();
+    test_ge_callbacks();
     test_ge_infinite_list();
