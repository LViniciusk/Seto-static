+/* PspGeCallbackData: signal_func, signal_arg, finish_func, finish_arg.
+ * The EBOOT's render queue only advances when the finish callback runs, so
+ * these are real registrations, not bookkeeping. */
+#define MAX_GE_CALLBACKS 4
+typedef struct {
+    int      used;
+    uint32_t signal, signal_arg, finish, finish_arg;
+} ge_callback;
+
 static ge_queue g_queue[MAX_QUEUES];
+static ge_callback g_cb[MAX_GE_CALLBACKS];
 static uint32_t g_next_id;
 
 static uint64_t g_unsupported;     /* vertices in a format we do not read */
