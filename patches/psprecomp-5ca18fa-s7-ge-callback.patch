  *
  * The budget is not paranoia: a list whose JUMP forms a cycle is a normal
@@ -642,18 +673,24 @@ static void run_list(ge_queue *q) {
             break;
 
         case GE_END:
+            /* END releases the queue but is not the finish interrupt; only
+             * FINISH raises the finish callback. */
+            q->done = 1;
+            q->finished = 0;
+            q->used = 0;
+            return;
         case GE_FINISH:
-            if (cmd == GE_FINISH) g_ge.finishes++;
+            g_ge.finishes++;
             /* A finished list gives its slot back. Keeping it used meant the
              * ninth enqueue failed, and WTF then dropped 3,870 of 3,885
              * frames while running at full speed. */
             q->done = 1;
+            q->finished = 1;
             q->used = 0;
             return;
 
         case GE_SIGNAL:
-            /* Raises a callback on hardware. Callbacks are not delivered yet
-             * (no scheduler), so this is recorded and ignored. */
+            ge_deliver(0, q->cbid);
             break;
 
         case GE_BASE:        q->base = (arg & 0xFF0000) << 8; break;
@@ -822,6 +859,7 @@ static void enqueue(int head) {
     q->id    = g_next_id++;
     q->list  = psp_arg(0) & ~3u;
     q->stall = psp_arg(1) & ~3u;
+    q->cbid  = psp_arg(2);
     q->used  = 1;
     (void)head;
 
@@ -829,8 +867,10 @@ static void enqueue(int head) {
      * returning, which is indistinguishable from the game's point of view
      * because every way it can observe progress -- ListSync, DrawSync -- then
      * reports completion. */
+    uint32_t id = q->id, cbid = q->cbid;
     run_list(q);
-    psp_ret(q->id);
+    if (q->finished) ge_deliver(1, cbid);
+    psp_ret(id);
 }
 
 static void hle_ListEnQueue(void)     { enqueue(0); }
@@ -847,7 +887,10 @@ static void hle_ListUpdateStallAddr(void) {
         return;
     }
     q->stall = psp_arg(1) & ~3u;
-    if (!q->done) run_list(q);          /* the new stall released more commands */
+    if (!q->done) {
+        run_list(q);                    /* the new stall released more commands */
+        if (q->finished) ge_deliver(1, q->cbid);
+    }
     psp_ret(SCE_KERNEL_ERROR_OK);
 }
 
@@ -859,8 +902,27 @@ static void hle_DrawSync(void) { psp_ret(SCE_KERNEL_ERROR_OK); }
 static void hle_Break(void)    { psp_ret(SCE_KERNEL_ERROR_OK); }
 static void hle_Continue(void) { psp_ret(SCE_KERNEL_ERROR_OK); }
 
-static void hle_SetCallback(void)   { psp_ret(0); }
-static void hle_UnsetCallback(void) { psp_ret(SCE_KERNEL_ERROR_OK); }
+static void hle_SetCallback(void) {
+    uint32_t cb = psp_arg(0);
+    if (!cb) { psp_ret(SCE_KERNEL_ERROR_ERROR); return; }
+    for (uint32_t i = 0; i < MAX_GE_CALLBACKS; i++) {
+        if (g_cb[i].used) continue;
+        g_cb[i].used = 1;
+        g_cb[i].signal     = psp_read32(cb + 0);
+        g_cb[i].signal_arg = psp_read32(cb + 4);
+        g_cb[i].finish     = psp_read32(cb + 8);
+        g_cb[i].finish_arg = psp_read32(cb + 12);
+        psp_ret(i);
+        return;
+    }
+    psp_ret(SCE_KERNEL_ERROR_NO_MEMORY);
+}
+
+static void hle_UnsetCallback(void) {
+    uint32_t id = psp_arg(0);
+    if (id < MAX_GE_CALLBACKS) g_cb[id].used = 0;
+    psp_ret(SCE_KERNEL_ERROR_OK);
+}
 
