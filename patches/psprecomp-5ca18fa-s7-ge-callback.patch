@@ -583,6 +597,23 @@ static void draw_prim(uint32_t type, uint32_t count) {
  * Taken literally, 0x88000 is main RAM: for a vaddr-0 module, its own code. */
 static uint32_t fb_vram(void) { return PSP_VRAM_BASE | (g_ge.fbp & (PSP_VRAM_SIZE - 1)); }
 
+/* Deliver a GE callback the way the hardware's interrupt does: the guest sees
+ * (callback id, registered argument) and the registers of the code that
+ * enqueued the list are untouched. The EBOOT's render queue is driven by the
+ * finish callback, so skipping these leaves lists that never retire. */
+static void ge_deliver(int finish, uint32_t cbid) {
+    if (cbid >= MAX_GE_CALLBACKS || !g_cb[cbid].used) return;
+    uint32_t fn  = finish ? g_cb[cbid].finish : g_cb[cbid].signal;
+    uint32_t arg = finish ? g_cb[cbid].finish_arg : g_cb[cbid].signal_arg;
+    if (!fn || !psp_lookup(fn)) return;
+    psp_cpu_state saved = psp_cpu;
+    psp_cpu.r[PSP_REG_A0] = cbid;
+    psp_cpu.r[PSP_REG_A1] = arg;
+    psp_cpu.r[PSP_REG_RA] = 0;
+    psp_call_from_host(fn);
+    psp_cpu = saved;
+}
+
