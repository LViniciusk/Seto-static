-#define PSP_EVENT_WAITCLEAR 0x20
+#define PSP_EVENT_WAITAND      0x00
+#define PSP_EVENT_WAITOR       0x01
+#define PSP_EVENT_WAITCLEARALL 0x10   /* clear the whole pattern on match */
+#define PSP_EVENT_WAITCLEAR    0x20   /* clear only the waited bits */
 
