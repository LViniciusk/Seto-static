diff --git a/src/hle/host_thread.h b/src/hle/host_thread.h
index 419b8d2..2c594f1 100644
--- a/src/hle/host_thread.h
+++ b/src/hle/host_thread.h
@@ -20,7 +20,12 @@ static void host_thread_error(void) {
 #include <process.h>
 #include <mmsystem.h>
 
-#define HOST_TLS __declspec(thread)
+/* GCC on MinGW ignores __declspec(thread) ("thread attribute directive
+ * ignored"), which turns the scheduler's per-thread state into globals: every
+ * guest thread inherits the boot thread's baton depth and skips
+ * baton_acquire(), running concurrently on the shared psp_cpu. _Thread_local
+ * is honoured by the same compiler. */
+#define HOST_TLS _Thread_local
 typedef HANDLE host_thread;
 typedef SRWLOCK host_mutex;
 typedef CONDITION_VARIABLE host_cond;
diff --git a/src/hle/threadman.c b/src/hle/threadman.c
index ba2ae51..4178541 100644
--- a/src/hle/threadman.c
+++ b/src/hle/threadman.c
@@ -118,6 +118,7 @@ typedef struct {
     uint32_t arglen;       /* sceKernelStartThread arguments, held for the host */
     uint32_t argp;
     uint32_t gp;           /* the creator's $gp, which the thread starts with */
+    uint32_t k0;           /* the creator's $k0 (thread pointer), for libc reent */
     int      state;
     uint32_t exit_status;
     int      used;
@@ -425,7 +426,11 @@ static int park_us(uint64_t timeout_us) {
         int handed = (g_baton_takes != takes0);   /* someone ran while we were parked */
         int expired = 0;
         if (cpu_wanted_locked()) { expired = handover_wait_locked(); handed = 1; }
-        while (g_baton_owned) host_cond_wait(&g_baton_cv, &g_baton_m);
+        /* A suspended thread stays off the CPU until ResumeThread takes the
+         * state back; suspension is checked here because this is where a
+         * parked thread would otherwise resume guest code. */
+        while (g_baton_owned || (t && t->state == TH_SUSPENDED))
+            host_cond_wait(&g_baton_cv, &g_baton_m);
         g_baton_owned = 1;
         g_switches++;
         host_mutex_unlock(&g_baton_m);
@@ -791,6 +796,11 @@ static void *guest_thread_main(void *arg) {
      * set, everything else starts at zero. */
     psp_cpu_reset();
     psp_cpu.r[PSP_REG_GP] = t->gp;          /* as the kernel does: globals are $gp-relative */
+    /* $k0 is the thread pointer: the module's libc reaches its per-thread reent
+     * through *(k0+4). The boot thread gets one from psp_module_start; a started
+     * thread must inherit its creator's, or newlib reports "no reent structure"
+     * and the C library state is garbage. */
+    psp_cpu.r[PSP_REG_K0] = t->k0;
     psp_cpu.r[PSP_REG_A0] = t->arglen;
     psp_cpu.r[PSP_REG_A1] = t->argp;
     /* Stack pointer starts at the top of the allocation, 16-byte aligned, with
@@ -881,6 +891,7 @@ static void hle_CreateThread(void) {
     t->stack_size = psp_arg(3);
     t->attr       = psp_arg(4);
     t->gp         = psp_cpu.r[PSP_REG_GP];
+    t->k0         = psp_cpu.r[PSP_REG_K0];
 
     if (t->stack_size < 0x1000) t->stack_size = 0x1000;
     /* Stacks grow down, so allocate from the top of the heap: a stack that
@@ -1070,7 +1081,18 @@ static void hle_WakeupThread(void) {
     psp_thread *t = find_thread(psp_arg(0));
     if (!t) { psp_ret(SCE_KERNEL_ERROR_ILLEGAL_THID); return; }
     t->wakeups++;
+#if PSPRECOMP_REAL_THREADS
+    /* One core: waking a higher-priority sleeper runs it before the waker.
+     * The game's module loader relies on this as its yield -- it wakes the
+     * caller, which then suspends the loader. Without the handover the loader
+     * spins and the caller never runs. */
+    int preempt = g_tls_me && t != g_tls_me && t->priority < g_tls_me->priority
+                  && t->state != TH_SUSPENDED && !t->exited && !t->terminated;
+#endif
     wake_thread(t);
+#if PSPRECOMP_REAL_THREADS
+    if (preempt) psp_threadman_yield();
+#endif
     psp_ret(SCE_KERNEL_ERROR_OK);
 }
 
@@ -1118,14 +1140,28 @@ static void hle_GetThreadId(void) { psp_ret(g_current ? g_current->uid : 0); }
 static void hle_SuspendThread(void) {
     psp_thread *t = find_thread(psp_arg(0));
     if (!t) { psp_ret(SCE_KERNEL_ERROR_ILLEGAL_THID); return; }
+#if PSPRECOMP_REAL_THREADS
+    host_mutex_lock(&g_baton_m);
+#endif
     t->state = TH_SUSPENDED;
+#if PSPRECOMP_REAL_THREADS
+    host_cond_broadcast(&g_baton_cv);
+    host_mutex_unlock(&g_baton_m);
+#endif
     psp_ret(SCE_KERNEL_ERROR_OK);
 }
 
 static void hle_ResumeThread(void) {
     psp_thread *t = find_thread(psp_arg(0));
     if (!t) { psp_ret(SCE_KERNEL_ERROR_ILLEGAL_THID); return; }
-    t->state = TH_READY;
+#if PSPRECOMP_REAL_THREADS
+    host_mutex_lock(&g_baton_m);
+#endif
+    if (t->state == TH_SUSPENDED) t->state = TH_READY;
+#if PSPRECOMP_REAL_THREADS
+    host_cond_broadcast(&g_baton_cv);
+    host_mutex_unlock(&g_baton_m);
+#endif
     psp_ret(SCE_KERNEL_ERROR_OK);
 }
 
@@ -1262,9 +1298,10 @@ static void hle_CancelSema(void) {
 
