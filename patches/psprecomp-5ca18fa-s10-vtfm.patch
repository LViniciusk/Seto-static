+/* PSP measurements: pspautotests tests/cpu/vfpu/matrix.{c,expected}.
+ * Its matrix is loaded through R700..R703, not C700..C730. */
+static void test_vtfm_hardware(void) {
+    psp_vfpu_reset();
+    for (int row = 0; row < 4; row++) {
+        int lanes[4];
+        psp_vfpu_regs(0x3C + (uint32_t)row, 4, lanes);
+        for (int col = 0; col < 4; col++)
+            psp_cpu.v[lanes[col]] = (float)(row * 4 + col + 1) * (col & 1 ? -1 : 1);
+    }
+    int src[4], dst[4];
+    psp_vfpu_regs(0x38, 4, src);  /* R600 */
+    const float in[] = { -13, -2111, 33, 40 };
+    const float expected[2][4] = {
+        { -10271, 12362, -14453, 0 }, { -9751, 11802, -13853, 15904 }
+    };
+    for (int n = 3; n <= 4; n++) {
+        for (int i = 0; i < 4; i++) psp_cpu.v[src[i]] = in[i];
+        psp_vtfm(0x24, 0x1C, 0x38, n); /* R100, M700, R600 */
+        psp_vfpu_regs(0x24, n, dst);
+        for (int i = 0; i < n; i++)
+            CHECK(psp_cpu.v[dst[i]] == expected[n - 3][i],
+                  "vtfm%d PSP lane %d: got %g, want %g", n, i,
+                  (double)psp_cpu.v[dst[i]], (double)expected[n - 3][i]);
+    }
+}
