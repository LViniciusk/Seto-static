+/* Fast rectangular clear when clear mode is active. */
+static void sw_clear_sprite(int x0, int y0, int x1, int y1,
+                            const psp_vertex *b, const psp_draw_state *st) {
+    const float zf = b->z;
+    const uint16_t z16 = (uint16_t)(zf < 0.0f ? 0 : (zf > 65535.0f ? 65535 : (int)(zf + 0.5f)));
+    const int have_z = st->zaddr && st->zbw > 0;
+    const int n = x1 - x0;
+    if (st->clear_depth && have_z) {
+        if (g_z_span.data) {
+            for (int y = y0; y < y1; y++) {
+                uint16_t * restrict row = (uint16_t *)(g_z_span.data + (uint32_t)((st->zaddr - g_z_span.addr) +
+                                          (uint32_t)(y * st->zbw + x0) * 2u));
+                for (int x = 0; x < n; x++) row[x] = z16;
+            }
+        } else {
+            for (int y = y0; y < y1; y++) {
+                uint32_t zat = st->zaddr + (uint32_t)(y * st->zbw + x0) * 2u;
+                for (int x = x0; x < x1; x++, zat += 2u) span_write16(&g_z_span, zat, z16);
+            }
+        }
+    }
+    if (!st->clear_color && !st->clear_alpha) return;
+
+    const uint32_t mask = st->write_mask |
+        (!st->clear_color ? 0x00FFFFFFu : 0u) |
+        (!st->clear_alpha ? 0xFF000000u : 0u);
+    const uint32_t bytes = g_fb_fmt == 3 ? 4u : 2u;
+    if (g_fb_span.data && g_fb_fmt == 3) {
+        if (mask == 0u) {
+            const uint32_t col = b->rgba;
+            for (int y = y0; y < y1; y++) {
+                uint32_t * restrict row = (uint32_t *)(g_fb_span.data + (uint32_t)((g_fb_addr - g_fb_span.addr) +
+                                          (uint32_t)(y * (int)g_fb_stride + x0) * 4u));
+                for (int x = 0; x < n; x++) row[x] = col;
+            }
+        } else {
+            const uint32_t set = b->rgba & ~mask;
+            for (int y = y0; y < y1; y++) {
+                uint32_t * restrict row = (uint32_t *)(g_fb_span.data + (uint32_t)((g_fb_addr - g_fb_span.addr) +
+                                          (uint32_t)(y * (int)g_fb_stride + x0) * 4u));
+                for (int x = 0; x < n; x++) row[x] = (row[x] & mask) | set;
+            }
+        }
+        g_pixels += (uint64_t)n * (uint64_t)(y1 - y0);
+        return;
+    }
+    if (g_fb_span.data && mask == 0u) {
+        const uint16_t p = (uint16_t)color_pack(b->rgba, g_fb_fmt);
+        for (int y = y0; y < y1; y++) {
+            uint16_t * restrict row = (uint16_t *)(g_fb_span.data + (uint32_t)((g_fb_addr - g_fb_span.addr) +
+                                      (uint32_t)(y * (int)g_fb_stride + x0) * 2u));
+            for (int x = 0; x < n; x++) row[x] = p;
+        }
+        g_pixels += (uint64_t)n * (uint64_t)(y1 - y0);
+        return;
+    }
+    for (int y = y0; y < y1; y++) {
+        uint32_t at = g_fb_addr + (uint32_t)(y * (int)g_fb_stride + x0) * bytes;
+        for (int x = x0; x < x1; x++, at += bytes) fb_write(at, b->rgba, mask);
+    }
+}
