+    void *dp = psp_mem_ptr(dst, size);
+    const void *sp = psp_mem_ptr(src, size);
+    if (dp && sp) {
+        memmove(dp, sp, size);
+    } else {
+        uint8_t *tmp = (uint8_t *)malloc(size);
+        if (!tmp) { psp_ret(0x80020190u); return; }
+        for (uint32_t i = 0; i < size; i++) tmp[i] = psp_read8(src + i);
+        for (uint32_t i = 0; i < size; i++) psp_write8(dst + i, tmp[i]);
+        free(tmp);
+    }
+    psp_ret(0);
+}
+
+static void hle_UtilityGetSystemParamString(void) {
+    const uint32_t id = psp_arg(0), buf = psp_arg(1), len = psp_arg(2);
+    if (!buf || !len) { psp_ret(0x80110103u); return; }
+    const char *val = NULL;
+    if (id == 1u) val = "Seto";
+    else { psp_ret(0x80110103u); return; }
+    uint32_t n = (uint32_t)strlen(val);
+    if (n >= len) n = len - 1u;
+    for (uint32_t i = 0; i < n; i++) psp_write8(buf + i, (uint8_t)val[i]);
+    psp_write8(buf + n, 0);
+    psp_ret(0);
+}
+
+/* Modules 0..7 are AV codecs/interfaces (AVCODEC..G729); return
+ * SCE_ERROR_AV_MODULE_BAD_ID (0x80110F01) for any other id. */
+static void hle_UtilityLoadAvModule(void) {
+    const uint32_t mod = psp_arg(0);
+    psp_ret(mod <= 7u ? 0u : 0x80110F01u);
+}
+
+static void hle_UtilityUnloadAvModule(void) {
+    const uint32_t mod = psp_arg(0);
+    psp_ret(mod <= 7u ? 0u : 0x80110F01u);
+}
