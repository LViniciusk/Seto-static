+static const uint32_t *sw_tex_resolve_linear(const psp_draw_state *st) {
+    if (g_tex_lin_tried) return g_tex_lin;
+    g_tex_lin_tried = 1;
+    if (!g_tex_base || st->tex_w <= 0 || st->tex_h <= 0 || st->tex_bw < st->tex_w) {
+        return NULL;
+    }
+    if (st->tex_fmt == PSP_TPSM_8888 && !st->tex_swizzle && st->tex_bw == st->tex_w) {
+        g_tex_lin = (const uint32_t *)g_tex_base;
+        return g_tex_lin;
+    }
+    const int is_clut = (st->tex_fmt == PSP_TPSM_T8 || st->tex_fmt == PSP_TPSM_T4);
+    const int is_dxt = (st->tex_fmt >= PSP_TPSM_DXT1 && st->tex_fmt <= PSP_TPSM_DXT5);
+    if ((is_clut && !g_clut_fast) || (!is_clut && !is_dxt && st->tex_fmt > PSP_TPSM_8888) ||
+        (is_dxt && (st->tex_bw & 3) != 0) || (!is_dxt && st->tex_swizzle && g_tex_rowb < 16u) ||
+        st->tex_w > 512 || st->tex_h > 512 || g_tex_raw_size == 0 || g_tex_raw_size > LIN_CACHE_MAX_RAW) {
+        return NULL;
+    }
+    const uint32_t raw_sz = (uint32_t)g_tex_raw_size;
+    const uint32_t clut_bytes = st->tex_fmt == PSP_TPSM_T4 ? 64u : (st->tex_fmt == PSP_TPSM_T8 ? 1024u : 0u);
+    int evict = 0;
+    for (int i = 0; i < LIN_CACHE_SLOTS; i++) {
+        lin_tex_slot *s = &g_lin_cache[i];
+        if (s->rgba && s->tex_addr == st->tex_addr && s->tex_bw == (uint32_t)st->tex_bw &&
+            s->tex_w == st->tex_w && s->tex_h == st->tex_h && s->tex_fmt == st->tex_fmt &&
+            s->tex_swizzle == st->tex_swizzle && s->raw_size == raw_sz && s->clut_bytes == clut_bytes &&
+            memcmp(s->raw_snap, g_tex_base, raw_sz) == 0 &&
+            (!clut_bytes || memcmp(s->clut_snap, g_clut_lut, clut_bytes) == 0)) {
+            s->tick = ++g_lin_tick;
+            g_tex_lin = s->rgba;
+            return g_tex_lin;
+        }
+        if (s->tick < g_lin_cache[evict].tick) evict = i;
+    }
+    lin_tex_slot *s = &g_lin_cache[evict];
+    const size_t need_px = (size_t)st->tex_w * (size_t)st->tex_h;
+    if (raw_sz > s->raw_cap) {
+        uint8_t *p = (uint8_t *)realloc(s->raw_snap, raw_sz);
+        if (!p) return NULL;
+        s->raw_snap = p;
+        s->raw_cap = raw_sz;
+    }
+    if (need_px > s->rgba_cap) {
+        uint32_t *p = (uint32_t *)realloc(s->rgba, need_px * sizeof(uint32_t));
+        if (!p) return NULL;
+        s->rgba = p;
+        s->rgba_cap = need_px;
+    }
+    memcpy(s->raw_snap, g_tex_base, raw_sz);
+    if (clut_bytes) memcpy(s->clut_snap, g_clut_lut, clut_bytes);
+    sw_tex_decode_linear(st, s->rgba);
+    s->tex_addr = st->tex_addr;
+    s->tex_bw = (uint32_t)st->tex_bw;
+    s->raw_size = raw_sz;
+    s->clut_bytes = clut_bytes;
+    s->tex_w = st->tex_w;
+    s->tex_h = st->tex_h;
+    s->tex_fmt = st->tex_fmt;
+    s->tex_swizzle = st->tex_swizzle;
+    s->tick = ++g_lin_tick;
+    g_tex_lin = s->rgba;
+    return g_tex_lin;
+}
