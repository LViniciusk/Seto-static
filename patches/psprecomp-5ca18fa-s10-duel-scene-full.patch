+static void test_separate_specular(void) {
+    /* With black texture (0) + modulate, LMODE=0 loses specular when multiplied
+     * by texel 0; LMODE=1 adds white specular after texturing. */
+    psp_write32(TEX, 0xFF000000u);
+    for (int lmode = 0; lmode <= 1; lmode++) {
+        psp_ge_reset();
+        clear_fb();
+        g_pc = 0;
+        cmd(0x10, (VERTS >> 8) & 0xFF0000);
+        cmd(0x9C, FB & 0xFFFFFF);
+        cmd(0x9D, ((FB >> 8) & 0xFF0000) | 480);
+        cmd(0x12, (3u << 0) | (3u << 5) | (3u << 7)); /* float uv, norm, pos */
+        cmd(0x01, VERTS & 0xFFFFFF);
+        fcmd(0x42, 240.0f);  fcmd(0x43, -136.0f);
+        fcmd(0x45, 2048.0f); fcmd(0x46, 2048.0f);
+        cmd(0x4C, (2048 - 240) << 4);
+        cmd(0x4D, (2048 - 136) << 4);
+        cmd(0x1E, 1);
+        cmd(0xA0, TEX & 0xFFFFFF);
+        cmd(0xA8, ((TEX >> 8) & 0xFF0000) | 1);
+        cmd(0xB8, 0);                              /* 1x1 black */
+        cmd(0xC3, 3);
+        cmd(0xC9, 0);                              /* modulate */
+        cmd(0x17, 1);                              /* LTE */
+        cmd(0x18, 1);                              /* light 0 on */
+        cmd(0x5E, (uint32_t)lmode);                /* LMODE */
+        cmd(0x5F, 1);                              /* directional + specular */
+        fcmd(0x63, 0); fcmd(0x64, 0); fcmd(0x65, 1.0f);
+        cmd(0x8F, 0); cmd(0x90, 0); cmd(0x91, 0xFFFFFF); /* white specular light */
+        cmd(0x57, 0xFFFFFF);                       /* white specular material */
+        fcmd(0x5B, 1.0f);
+        cmd(0x5C, 0);
+        const float q[4][2] = { { -0.5f, 0.5f }, { 0.5f, 0.5f }, { -0.5f, -0.5f }, { 0.5f, -0.5f } };
+        for (int i = 0; i < 4; i++) {
+            uint32_t a = VERTS + (uint32_t)i * 32;
+            psp_write32(a + 0, 0); psp_write32(a + 4, 0);
+            psp_write32(a + 8, 0); psp_write32(a + 12, 0); psp_write32(a + 16, fbits(1.0f));
+            psp_write32(a + 20, fbits(q[i][0])); psp_write32(a + 24, fbits(q[i][1])); psp_write32(a + 28, 0);
+        }
+        cmd(0x04, (4u << 16) | 4);
+        end_list();
+        uint32_t p = pixel(240, 136);
+        if (lmode == 0) CHECK(p == 0u, "LMODE=0 modulated by black texture: 0x%08X", p);
+        else            CHECK(p == 0x00FFFFFFu, "LMODE=1 adds white specular post-texture: 0x%08X", p);
+    }
+}
