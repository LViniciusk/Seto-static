+static uint32_t apply_logic_op(int op, uint32_t s, uint32_t d) {
+    uint32_t r;
+    s &= 0x00FFFFFFu;
+    d &= 0x00FFFFFFu;
+    switch (op & 0xF) {
+    case 0:  r = 0; break;
+    case 1:  r = s & d; break;
+    case 2:  r = s & ~d; break;
+    case 3:  r = s; break;
+    case 4:  r = ~s & d; break;
+    case 5:  r = d; break;
+    case 6:  r = s ^ d; break;
+    case 7:  r = s | d; break;
+    case 8:  r = ~(s | d); break;
+    case 9:  r = ~(s ^ d); break;
+    case 10: r = ~d; break;
+    case 11: r = s | ~d; break;
+    case 12: r = ~s; break;
+    case 13: r = ~s | d; break;
+    case 14: r = ~(s & d); break;
+    default: r = 0x00FFFFFFu; break;
+    }
+    return r & 0x00FFFFFFu;
+}
