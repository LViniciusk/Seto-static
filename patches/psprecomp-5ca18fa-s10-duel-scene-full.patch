+static void test_region_minz_bilinear(void) {
+    /* REGION1/2 + MINZ/MAXZ clipping and TFLT=0x101 bilinear blend. */
+    psp_ge_reset();
+    clear_fb();
+    psp_write32(TEX,     0xFF000000u);
+    psp_write32(TEX + 4, 0xFFFFFFFFu);
+    psp_write32(TEX + 8, 0xFF000000u);
+    psp_write32(TEX + 12, 0xFFFFFFFFu);
+    begin_list();
+    cmd(0x15, 2 | (2 << 10));                      /* REGION1: (2,2) */
+    cmd(0x16, 8 | (8 << 10));                      /* REGION2: (8,8) */
+    cmd(0xD6, 10);                                 /* MINZ */
+    cmd(0xD7, 100);                                /* MAXZ */
+    cmd(0x1E, 1);
+    cmd(0xA0, TEX & 0xFFFFFF);
+    cmd(0xA8, ((TEX >> 8) & 0xFF0000) | 2);
+    cmd(0xB8, (1u << 8) | 1u);
+    cmd(0xC3, 3);
+    cmd(0xC6, 0x101);                              /* linear min/mag */
+    cmd(0xC9, 3);                                  /* replace */
+    /* Inside Z=[10..100] */
+    uint32_t a = VERTS;
+    psp_write16(a, 0); psp_write16(a + 2, 0);
+    psp_write32(a + 4, 0xFFFFFFFFu);
+    psp_write16(a + 8, 0); psp_write16(a + 10, 0); psp_write16(a + 12, 50);
+    uint32_t b = VERTS + 16;
+    psp_write16(b, 2); psp_write16(b + 2, 2);
+    psp_write32(b + 4, 0xFFFFFFFFu);
+    psp_write16(b + 8, 10); psp_write16(b + 10, 10); psp_write16(b + 12, 50);
+    cmd(0x12, 2u | (7u << 2) | (2u << 7) | (1u << 23));
+    cmd(0x01, VERTS & 0xFFFFFF);
+    cmd(0x04, (6u << 16) | 2);
+    end_list();
+    CHECK(pixel(1, 1) == 0 && pixel(9, 9) == 0, "REGION1/2 clipped outside (2..8)");
+    CHECK(pixel(5, 5) != 0, "inside REGION drawn: 0x%08X", pixel(5, 5));
+    /* Sprite 0..10 over 0..2 uv gives du=0.2; pixel 5 has u=1.1 -> blends black/white (~0x80..). */
+    uint8_t ch = (uint8_t)(pixel(5, 5) & 0xFF);
+    CHECK(ch > 0 && ch < 255, "bilinear TFLT=0x101 blends texels at u=1.1 (ch=%d)", ch);
+    /* Through-mode sprites ignore MINZ/MAXZ (2D overlays commonly have z=0). */
+    psp_ge_reset();
+    clear_fb();
+    begin_list();
+    cmd(0xD6, 10); cmd(0xD7, 100);
+    vertex(0, 0, 0, 0xFF00FF00u);
+    vertex(1, 4, 4, 0xFF00FF00u);
+    cmd(0x04, (6u << 16) | 2);
+    end_list();
+    CHECK(pixel(2, 2) == 0x0000FF00u, "through mode ignores MINZ=10 at z=0: 0x%08X", pixel(2, 2));
+    /* Transformed primitives outside MINZ/MAXZ are discarded; inside are kept. */
+    const float tri_xy[3][2] = { {-0.9f, 0.9f}, {-0.5f, 0.9f}, {-0.9f, 0.5f} };
+    for (int pass = 0; pass < 2; pass++) {
+        psp_ge_reset();
+        clear_fb();
+        begin_list();
+        cmd(0xD6, 10); cmd(0xD7, 100);
+        fcmd(0x42, 240.0f); fcmd(0x43, -136.0f); fcmd(0x44, 0.0f);
+        fcmd(0x45, 2048.0f); fcmd(0x46, 2048.0f); fcmd(0x47, pass ? 50.0f : 200.0f);
+        cmd(0x4C, (2048 - 240) << 4); cmd(0x4D, (2048 - 136) << 4);
+        cmd(0x12, (7u << 2) | (3u << 7));
+        for (int i = 0; i < 3; i++) {
+            uint32_t va = VERTS + (uint32_t)i * 16;
+            psp_write32(va + 0, 0xFF00FF00u);
+            psp_write32(va + 4, fbits(tri_xy[i][0]));
+            psp_write32(va + 8, fbits(tri_xy[i][1]));
+            psp_write32(va + 12, 0);
+        }
+        cmd(0x04, (3u << 16) | 3);
+        end_list();
+        uint32_t px = pixel(40, 30);
+        if (pass == 0) CHECK(px == 0, "MAXZ=100 rejected transformed z=200: 0x%08X", px);
+        else           CHECK(px == 0x0000FF00u, "MINZ..MAXZ kept transformed z=50: 0x%08X", px);
+    }
+}
