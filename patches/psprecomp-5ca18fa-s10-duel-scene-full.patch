+    fcmd(0x45, 2048.0f); fcmd(0x46, 2048.0f);
+    cmd(0x4C, (2048 - 240) << 4);
+    cmd(0x4D, (2048 - 136) << 4);
+    cmd(0x17, 1);                                  /* LTE */
+    cmd(0x18, 0);                                  /* lights off */
+    cmd(0x21, 1);                                  /* ABE: blend source alpha over black fb */
+    cmd(0xDF, 2u | (3u << 4));                     /* ADD, SRC_ALPHA, INV_SRC_ALPHA */
+    cmd(0x55, 0xFFFFFF);                           /* material ambient RGB: white */
+    cmd(0x58, 0xFF);                               /* material ambient alpha */
+    cmd(0x5C, 0xFFFFFF);                           /* ambient light RGB: white */
+    cmd(0x5D, 0x80);                               /* ambient light alpha: ~50% */
+    const float q[4][2] = { { -0.5f, 0.5f }, { 0.5f, 0.5f }, { -0.5f, -0.5f }, { 0.5f, -0.5f } };
+    for (int i = 0; i < 4; i++) {
+        uint32_t a = VERTS + (uint32_t)i * 24;
+        psp_write32(a + 0, 0); psp_write32(a + 4, 0); psp_write32(a + 8, fbits(1.0f));
+        psp_write32(a + 12, fbits(q[i][0])); psp_write32(a + 16, fbits(q[i][1])); psp_write32(a + 20, 0);
+    }
+    cmd(0x04, (4u << 16) | 4);
+    end_list();
+    const uint32_t ch = pixel(220, 120) & 0xFFu;
+    CHECK(ch >= 0x7Fu && ch <= 0x81u, "ALA modulates alpha in blend: 0x%08X", pixel(220, 120));
+}
