+    psp_vavg(0x04, 0x00, 4);
+    CHECK_F(psp_cpu.v[r[0]], 5.0f, "vavg.q");
+    psp_vavg(0x04, 0x00, 3);
+    CHECK_F(psp_cpu.v[r[0]], 4.0f, "vavg.t");
+    psp_vavg(0x04, 0x00, 1);
+    CHECK_F(psp_cpu.v[r[0]], 0.0f, "vavg.s returns 0.0f on Allegrex");
+
+    /* vsrt1..4 pairwise sorts. */
+    const float us[4] = { 3.0f, 1.0f, 4.0f, 2.0f };
+    set_quad(0x00, us);
