+            } else {
+                const int sy0 = (int)(fv >> 24);
+                const int64_t fu_end = fu + (int64_t)(x1 - 1 - x0) * dfudx;
+                const int sx0_a = (int)(fu >> 24);
+                const int sx0_b = (int)(fu_end >> 24);
+                if ((unsigned)sy0 < (unsigned)tex_h &&
+                    (unsigned)sx0_a < (unsigned)tex_w &&
+                    (unsigned)sx0_b < (unsigned)tex_w) {
+                    const uint8_t * restrict tex_y0 = tex_swz_row_ptr(tex_base, tex_blocks, (uint32_t)sy0);
+                    uint8_t * restrict px_ptr = fb_base + (fb_row_off + (uint32_t)x0) * 4u;
+                    px_drawn += (uint64_t)(x1 - x0);
+                    for (int x = x0; x < x1; x++, px_ptr += 4, fu += dfudx) {
+                        if (early_z) {
+                            uint16_t zd;
+                            memcpy(&zd, z_base + (z_row_off + (uint32_t)x) * 2u, 2);
+                            if (!depth_pass(zfunc, z, zd)) continue;
+                            if (zwrite) { const uint16_t zw = (uint16_t)z; memcpy(z_base + (z_row_off + (uint32_t)x) * 2u, &zw, 2); }
+                        }
+                        uint32_t c = tex_swz_row_read(tex_y0, (uint32_t)(fu >> 24), clut, is_t4);
+                        if (mod_white) c = st->tex_alpha ? c : (c | 0xFF000000u);
+                        else           c = simple_mod ? swar_modulate(c, flat_c) : tex_combine(st, c, flat_c);
+                        if (do_atest && !alpha_pass(st, c)) continue;
+                        if (!early_z && ztest) {
+                            uint16_t zd;
+                            memcpy(&zd, z_base + (z_row_off + (uint32_t)x) * 2u, 2);
+                            if (!depth_pass(zfunc, z, zd)) continue;
+                            if (zwrite) { const uint16_t zw = (uint16_t)z; memcpy(z_base + (z_row_off + (uint32_t)x) * 2u, &zw, 2); }
+                        }
+                        sw_tri_t8_write_ptr(st, px_ptr, c, k_blend, do_stencil);
+                    }
+                    continue;
+                }
+            }
+        }
+        for (int x = x0; x < x1; x++, fu += dfudx) {
+            if (early_z) {
+                uint16_t zd;
+                memcpy(&zd, z_base + (z_row_off + (uint32_t)x) * 2u, 2);
+                if (!depth_pass(zfunc, z, zd)) continue;
+            }
+            uint32_t c = flat_c;
+            if (do_tex) {
+                const uint32_t t = k_swz_fmt == 3
+                    ? (k_bilin
+                        ? tex_lin_bilin_fp(lin_tex, tex_w, tex_h, clamp_u, clamp_v, fu, fv)
+                        : tex_lin_near_fp(lin_tex, tex_w, tex_h, clamp_u, clamp_v, fu, fv))
+                    : (k_swz_fmt
+                        ? (k_bilin
+                            ? tex_sample_clut_swz_bilin_fp(tex_base, clut, tex_blocks, tex_w, tex_h, clamp_u, clamp_v, fu, fv, is_t4)
+                            : tex_sample_clut_swz_near_fp(tex_base, clut, tex_blocks, tex_w, tex_h, clamp_u, clamp_v, fu, fv, is_t4))
+                        : (use_fp
+                            ? tex_sample_fp(st, fu, fv)
+                            : tex_sample(st, a->u + ((float)(x - a->x) + 0.5f) * du, (float)vy)));
+                if (mod_white) {
+                    c = st->tex_alpha ? t : (t | 0xFF000000u);
+                } else {
+                    c = simple_mod ? swar_modulate(t, c) : tex_combine(st, t, c);
+                }
+            }
+            if (do_atest && !alpha_pass(st, c)) continue;
+            const uint32_t off_px = fb_row_off + (uint32_t)x;
+            if (do_stencil) {
+                uint32_t dst;
+                memcpy(&dst, fb_base + off_px * 4u, 4);
+                int stencil = (int)(dst >> 24);
+                if (!depth_pass(st->stencil_func, st->stencil_ref & st->stencil_mask, stencil & st->stencil_mask)) {
+                    stencil = stencil_op(st->stencil_fail, stencil, st->stencil_ref);
+                    dst = (dst & 0x00FFFFFFu) | ((uint32_t)stencil << 24);
+                    memcpy(fb_base + off_px * 4u, &dst, 4);
+                    px_drawn++;
+                    continue;
+                }
+                if (ztest) {
+                    uint16_t zd;
+                    memcpy(&zd, z_base + (z_row_off + (uint32_t)x) * 2u, 2);
+                    if (!depth_pass(zfunc, z, zd)) {
+                        stencil = stencil_op(st->stencil_zfail, stencil, st->stencil_ref);
+                        dst = (dst & 0x00FFFFFFu) | ((uint32_t)stencil << 24);
+                        memcpy(fb_base + off_px * 4u, &dst, 4);
+                        px_drawn++;
+                        continue;
+                    }
+                }
+                if (zwrite) {
+                    const uint16_t zv = (uint16_t)z;
+                    memcpy(z_base + (z_row_off + (uint32_t)x) * 2u, &zv, 2);
+                }
+                stencil = stencil_op(st->stencil_zpass, stencil, st->stencil_ref);
+                if (do_blend) {
+                    if (std_blend) {
+                        const uint32_t al = A(c);
+                        if (al == 0u) c = dst;
+                        else if (al != 255u) c = swar_std_blend(c, dst, al);
+                    } else {
+                        c = blend(st, c, dst);
+                    }
+                }
+                dst = (c & 0x00FFFFFFu) | ((uint32_t)stencil << 24);
+                memcpy(fb_base + off_px * 4u, &dst, 4);
+                px_drawn++;
+                continue;
+            }
+            if (!early_z && ztest) {
+                uint16_t zd;
+                memcpy(&zd, z_base + (z_row_off + (uint32_t)x) * 2u, 2);
+                if (!depth_pass(zfunc, z, zd)) continue;
+            }
+            if (zwrite) {
+                const uint16_t zv = (uint16_t)z;
+                memcpy(z_base + (z_row_off + (uint32_t)x) * 2u, &zv, 2);
+            }
+            if (k_fast_pipe && !(do_stencil && ztest) && fb_is_8888) {
+                sw_tri_t8_write_ptr(st, fb_base + off_px * 4u, c, k_blend, do_stencil);
+                px_drawn++;
+                continue;
+            }
+            if (do_blend && fb_is_8888) {
+                uint32_t dst;
+                memcpy(&dst, fb_base + off_px * 4u, 4);
+                if (std_blend) {
+                    const uint32_t al = A(c);
+                    if (al == 0u) {
+                        px_drawn++;
+                        continue;
+                    }
+                    if (al != 255u) c = swar_std_blend(c, dst, al);
+                } else {
+                    c = blend(st, c, dst);
+                }
+                dst = (c & 0x00FFFFFFu) | (dst & 0xFF000000u);
+                memcpy(fb_base + off_px * 4u, &dst, 4);
+                px_drawn++;
+                continue;
+            }
+            if (do_blend) c = blend(st, c, fb_read_fast(fb_base, off_px));
+            fb_write_fast_keep_alpha(fb_base, off_px, c);
+            px_drawn++;
+        }
+    }
+    g_pixels += px_drawn;
+}
+
+#define DEFINE_SPRITE_LIN_MW(NAME, BMODE, ATEST, BILIN) \
+static __attribute__((noinline)) void NAME( \
+    int x0, int y0, int x1, int y1, \
+    const psp_vertex *a, const psp_vertex *b, \
+    const psp_draw_state *st, float du, float dv, int mod_white) { \
+    if (mod_white) sw_sprite_simple_kernel(x0, y0, x1, y1, a, b, st, du, dv, 1, BMODE, 0, 3, 1, 0, 0, ATEST, BILIN); \
+    else           sw_sprite_simple_kernel(x0, y0, x1, y1, a, b, st, du, dv, 1, BMODE, 0, 3, 0, 0, 0, ATEST, BILIN); \
+}
+
+DEFINE_SPRITE_LIN_MW(sw_sprite_lin_op_near, 0, 0, 0)
+DEFINE_SPRITE_LIN_MW(sw_sprite_lin_op_bilin, 0, 0, 1)
+DEFINE_SPRITE_LIN_MW(sw_sprite_lin_bl_near, 1, 0, 0)
+DEFINE_SPRITE_LIN_MW(sw_sprite_lin_bl_bilin, 1, 0, 1)
+DEFINE_SPRITE_LIN_MW(sw_sprite_lin_add_bilin, 2, 0, 1)
+DEFINE_SPRITE_LIN_MW(sw_sprite_lin_op_at_near, 0, 1, 0)
+DEFINE_SPRITE_LIN_MW(sw_sprite_lin_op_at_bilin, 0, 1, 1)
+DEFINE_SPRITE_LIN_MW(sw_sprite_lin_bl_at_near, 1, 1, 0)
+DEFINE_SPRITE_LIN_MW(sw_sprite_lin_bl_at_bilin, 1, 1, 1)
+#undef DEFINE_SPRITE_LIN_MW
+
+static __attribute__((noinline)) void sw_sprite_swz_fn(
+    int x0, int y0, int x1, int y1,
+    const psp_vertex *a, const psp_vertex *b,
+    const psp_draw_state *st, float du, float dv,
+    int k_swz_fmt, int k_blend, int k_stencil, int ztest, int zwrite, int atest, int bilin, int mod_white) {
+    if (k_swz_fmt == 3) {
+        sw_sprite_simple_kernel(x0, y0, x1, y1, a, b, st, du, dv, 1, k_blend, k_stencil, 3, mod_white, ztest, zwrite, atest, bilin);
+    } else if (k_swz_fmt == 2) {
+        sw_sprite_simple_kernel(x0, y0, x1, y1, a, b, st, du, dv, 1, k_blend, k_stencil, 2, mod_white, ztest, zwrite, atest, bilin);
+    } else {
+        sw_sprite_simple_kernel(x0, y0, x1, y1, a, b, st, du, dv, 1, k_blend, k_stencil, 1, mod_white, ztest, zwrite, atest, bilin);
+    }
+}
