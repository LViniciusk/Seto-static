+static inline __attribute__((always_inline)) void sw_lin_span_1to1(
+    uint8_t * restrict px_ptr, const uint32_t * restrict src, int count,
+    uint32_t flat_col, int k_blend, int k_mod_white, int k_tex_alpha) {
+    int i = 0;
+#ifdef __SSE2__
+    const __m128i zero = _mm_setzero_si128();
+    const __m128i flat_lo = !k_mod_white ? _mm_unpacklo_epi8(_mm_set1_epi32((int)flat_col), zero) : zero;
+    for (; i + 4 <= count; i += 4, px_ptr += 16, src += 4) {
+        sw_store_4px_sse2(px_ptr, _mm_loadu_si128((const __m128i *)src),
+                          flat_lo, k_blend, k_mod_white, k_tex_alpha);
+    }
+#endif
+    for (; i < count; i++, px_ptr += 4, src++) {
+        uint32_t col = *src;
+        if (!k_tex_alpha) col |= 0xFF000000u;
+        if (!k_mod_white) col = swar_modulate(col, flat_col);
+        sw_tri_t8_write_ptr(NULL, px_ptr, col, k_blend, 0);
+    }
+}
