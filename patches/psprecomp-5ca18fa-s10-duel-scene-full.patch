+static inline __attribute__((always_inline)) __m128i load_pair_sse2(
+    const uint32_t * restrict row, uint32_t ux, uint32_t wmask, int k_wrap_u) {
+    if (!k_wrap_u || __builtin_expect(ux < wmask, 1))
+        return _mm_loadl_epi64((const __m128i *)(row + ux));
+    return _mm_unpacklo_epi32(_mm_cvtsi32_si128((int)row[ux]),
+                              _mm_cvtsi32_si128((int)row[0]));
+}
+#endif
