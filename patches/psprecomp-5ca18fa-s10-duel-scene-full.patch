+#ifdef __SSE2__
+static inline __attribute__((always_inline)) void sw_store_4px_sse2(
+    uint8_t * restrict px_ptr, __m128i s4, __m128i flat_lo,
+    int k_blend, int k_mod_white, int k_tex_alpha) {
+    const __m128i amask = _mm_set1_epi32((int)0xFF000000u);
+    const __m128i zero = _mm_setzero_si128();
+    const __m128i c128 = _mm_set1_epi16(128);
+    const __m128i c255_16 = _mm_set1_epi16(255);
+    if (!k_tex_alpha && k_blend != 0) s4 = _mm_or_si128(s4, amask);
+    if (!k_mod_white) {
+        __m128i s_lo = _mm_add_epi16(_mm_mullo_epi16(_mm_unpacklo_epi8(s4, zero), flat_lo), c128);
+        s_lo = _mm_srli_epi16(_mm_add_epi16(s_lo, _mm_srli_epi16(s_lo, 8)), 8);
+        __m128i s_hi = _mm_add_epi16(_mm_mullo_epi16(_mm_unpackhi_epi8(s4, zero), flat_lo), c128);
+        s_hi = _mm_srli_epi16(_mm_add_epi16(s_hi, _mm_srli_epi16(s_hi, 8)), 8);
+        s4 = _mm_packus_epi16(s_lo, s_hi);
+    }
+    if (k_blend == 0) {
+        __m128i d4 = _mm_loadu_si128((const __m128i *)px_ptr);
+        _mm_storeu_si128((__m128i *)px_ptr, _mm_or_si128(_mm_andnot_si128(amask, s4), _mm_and_si128(d4, amask)));
+        return;
+    }
+    if (k_blend == 1) {
+        const __m128i sa = _mm_and_si128(s4, amask);
+        if ((_mm_movemask_epi8(_mm_cmpeq_epi8(sa, zero)) & 0x8888) == 0x8888) return;
+        __m128i d4 = _mm_loadu_si128((const __m128i *)px_ptr);
+        if ((_mm_movemask_epi8(_mm_cmpeq_epi8(sa, amask)) & 0x8888) == 0x8888) {
+            _mm_storeu_si128((__m128i *)px_ptr, _mm_or_si128(_mm_andnot_si128(amask, s4), _mm_and_si128(d4, amask)));
+            return;
+        }
+        __m128i s_lo = _mm_unpacklo_epi8(s4, zero);
+        __m128i s_hi = _mm_unpackhi_epi8(s4, zero);
+        __m128i d_lo = _mm_unpacklo_epi8(d4, zero);
+        __m128i d_hi = _mm_unpackhi_epi8(d4, zero);
+        __m128i a_lo = _mm_shufflehi_epi16(_mm_shufflelo_epi16(s_lo, 0xFF), 0xFF);
+        __m128i a_hi = _mm_shufflehi_epi16(_mm_shufflelo_epi16(s_hi, 0xFF), 0xFF);
+        __m128i inv_lo = _mm_sub_epi16(c255_16, a_lo);
+        __m128i inv_hi = _mm_sub_epi16(c255_16, a_hi);
+        __m128i m_lo = _mm_add_epi16(_mm_add_epi16(_mm_mullo_epi16(s_lo, a_lo), _mm_mullo_epi16(d_lo, inv_lo)), c128);
+        __m128i m_hi = _mm_add_epi16(_mm_add_epi16(_mm_mullo_epi16(s_hi, a_hi), _mm_mullo_epi16(d_hi, inv_hi)), c128);
+        m_lo = _mm_srli_epi16(_mm_add_epi16(m_lo, _mm_srli_epi16(m_lo, 8)), 8);
+        m_hi = _mm_srli_epi16(_mm_add_epi16(m_hi, _mm_srli_epi16(m_hi, 8)), 8);
+        __m128i out4 = _mm_packus_epi16(m_lo, m_hi);
+        out4 = _mm_or_si128(_mm_andnot_si128(amask, out4), _mm_and_si128(d4, amask));
+        _mm_storeu_si128((__m128i *)px_ptr, out4);
+        return;
+    }
+    if (k_blend == 2) {
+        if ((_mm_movemask_epi8(_mm_cmpeq_epi8(_mm_and_si128(s4, amask), zero)) & 0x8888) == 0x8888) return;
+        __m128i d4 = _mm_loadu_si128((const __m128i *)px_ptr);
+        __m128i s_lo = _mm_unpacklo_epi8(s4, zero);
+        __m128i s_hi = _mm_unpackhi_epi8(s4, zero);
+        __m128i a_lo = _mm_shufflehi_epi16(_mm_shufflelo_epi16(s_lo, 0xFF), 0xFF);
+        __m128i a_hi = _mm_shufflehi_epi16(_mm_shufflelo_epi16(s_hi, 0xFF), 0xFF);
+        __m128i m_lo = _mm_add_epi16(_mm_mullo_epi16(s_lo, a_lo), c128);
+        __m128i m_hi = _mm_add_epi16(_mm_mullo_epi16(s_hi, a_hi), c128);
+        m_lo = _mm_srli_epi16(_mm_add_epi16(m_lo, _mm_srli_epi16(m_lo, 8)), 8);
+        m_hi = _mm_srli_epi16(_mm_add_epi16(m_hi, _mm_srli_epi16(m_hi, 8)), 8);
+        __m128i sc4 = _mm_andnot_si128(amask, _mm_packus_epi16(m_lo, m_hi));
+        _mm_storeu_si128((__m128i *)px_ptr, _mm_adds_epu8(sc4, d4));
+        return;
+    }
+    __m128i d4 = _mm_loadu_si128((const __m128i *)px_ptr);
+    _mm_storeu_si128((__m128i *)px_ptr, _mm_adds_epu8(_mm_andnot_si128(amask, s4), d4));
+}
