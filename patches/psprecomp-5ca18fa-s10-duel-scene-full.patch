+static inline __attribute__((always_inline)) void sw_lin_bilin_inner(
+    uint8_t * restrict px_ptr, const uint32_t * restrict lin_y0, const uint32_t * restrict lin_y1,
+    uint32_t wmask, int64_t su, int64_t dfudx, int fy, int count,
+    uint32_t flat_col, int k_blend, int k_mod_white, int k_tex_alpha, int k_wrap_u) {
+    int i = 0;
+#ifdef __SSE2__
+    const __m128i zero = _mm_setzero_si128();
+    const __m128i fy16 = _mm_set1_epi16((int16_t)fy);
+    const __m128i flat_lo = !k_mod_white ? _mm_unpacklo_epi8(_mm_set1_epi32((int)flat_col), zero) : zero;
+    for (; i + 4 <= count; i += 4, px_ptr += 16) {
+        const int64_t su0 = su;
+        const int64_t su1 = su0 + dfudx;
+        const int64_t su2 = su1 + dfudx;
+        const int64_t su3 = su2 + dfudx;
+        su = su3 + dfudx;
+        const uint32_t ux0 = k_wrap_u ? ((uint32_t)(su0 >> 24) & wmask) : (uint32_t)(su0 >> 24);
+        const uint32_t ux1 = k_wrap_u ? ((uint32_t)(su1 >> 24) & wmask) : (uint32_t)(su1 >> 24);
+        const uint32_t ux2 = k_wrap_u ? ((uint32_t)(su2 >> 24) & wmask) : (uint32_t)(su2 >> 24);
+        const uint32_t ux3 = k_wrap_u ? ((uint32_t)(su3 >> 24) & wmask) : (uint32_t)(su3 >> 24);
+        const int fx0 = (int)(((su0 & 0xFFFFFFLL) + (1LL << 19)) >> 20);
+        const int fx1 = (int)(((su1 & 0xFFFFFFLL) + (1LL << 19)) >> 20);
+        const int fx2 = (int)(((su2 & 0xFFFFFFLL) + (1LL << 19)) >> 20);
+        const int fx3 = (int)(((su3 & 0xFFFFFFLL) + (1LL << 19)) >> 20);
+        const __m128i fx01 = _mm_unpacklo_epi64(_mm_shufflelo_epi16(_mm_cvtsi32_si128(fx0), 0),
+                                              _mm_shufflelo_epi16(_mm_cvtsi32_si128(fx1), 0));
+        const __m128i fx23 = _mm_unpacklo_epi64(_mm_shufflelo_epi16(_mm_cvtsi32_si128(fx2), 0),
+                                              _mm_shufflelo_epi16(_mm_cvtsi32_si128(fx3), 0));
+        const __m128i lo16 = bilinear_mix_2px_16_sse2(
+            load_pair_sse2(lin_y0, ux0, wmask, k_wrap_u), load_pair_sse2(lin_y0, ux1, wmask, k_wrap_u),
+            load_pair_sse2(lin_y1, ux0, wmask, k_wrap_u), load_pair_sse2(lin_y1, ux1, wmask, k_wrap_u),
+            fx01, fy16);
+        const __m128i hi16 = bilinear_mix_2px_16_sse2(
+            load_pair_sse2(lin_y0, ux2, wmask, k_wrap_u), load_pair_sse2(lin_y0, ux3, wmask, k_wrap_u),
+            load_pair_sse2(lin_y1, ux2, wmask, k_wrap_u), load_pair_sse2(lin_y1, ux3, wmask, k_wrap_u),
+            fx23, fy16);
+        sw_store_4px_sse2(px_ptr, _mm_packus_epi16(lo16, hi16), flat_lo, k_blend, k_mod_white, k_tex_alpha);
+    }
+#endif
+    for (; i < count; i++, px_ptr += 4, su += dfudx) {
+        const uint32_t ux = k_wrap_u ? ((uint32_t)(su >> 24) & wmask) : (uint32_t)(su >> 24);
+        const int fx = (int)(((su & 0xFFFFFFLL) + (1LL << 19)) >> 20);
+        uint32_t col;
+        if (!k_wrap_u || __builtin_expect(ux < wmask, 1)) {
+            col = bilinear_mix_row2(lin_y0 + ux, lin_y1 + ux, fx, fy);
+        } else {
+            col = bilinear_mix(lin_y0[ux], lin_y0[0], lin_y1[ux], lin_y1[0], fx, fy);
+        }
+        if (!k_tex_alpha) col |= 0xFF000000u;
+        if (!k_mod_white) col = swar_modulate(col, flat_col);
+        sw_tri_t8_write_ptr(NULL, px_ptr, col, k_blend, 0);
+    }
+}
