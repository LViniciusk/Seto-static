+static void test_render_spans(void) {
+    psp_ge_reset();
+    clear_fb();
+    CHECK(psp_mem_unwatched_ptr(FB, 480 * 272 * 4) != NULL, "valid VRAM span resolves");
+    CHECK(psp_mem_unwatched_ptr(PSP_VRAM_BASE + PSP_VRAM_SIZE - 2, 4) == NULL,
+          "span crossing VRAM end is rejected");
+    psp_mem_watch_write(FB);
+    CHECK(psp_mem_unwatched_ptr(FB, 4) == NULL, "watched memory uses checked accesses");
+    begin_list();
+    vertex(0, 0, 0, 0xFFFFFFFFu);
+    vertex(1, 1, 1, 0xFFFFFFFFu);
+    cmd(0x04, (6u << 16) | 2);
+    end_list();
+    CHECK(psp_mem_watch_hits() == 1, "render write still reaches memory watch");
+    psp_mem_watch_write(0);
+    psp_mem_watch_read(FB);
+    CHECK(psp_mem_unwatched_ptr(FB, 4) == NULL, "read watch disables bulk reads too");
+    psp_mem_watch_read(0);
+
+    /* A partly unmapped span must still allow individual valid accesses. */
+    const uint32_t last = PSP_VRAM_BASE + PSP_VRAM_SIZE - 4;
+    psp_draw_state st = {0};
+    st.sc_x1 = 479; st.sc_y1 = 271;
+    const psp_vertex quad[] = {
+        {0, 0, 0, 0xFFFFFFFFu, 0, 0, 0, 0, 1.0f}, {1, 1, 0, 0xFFFFFFFFu, 0, 0, 0, 0, 1.0f}
+    };
+    psp_write32(last, 0x12000000u);
+    psp_render_current()->set_target(last, 512, 3);
+    psp_render_current()->draw(PSP_PRIM_SPRITES, quad, 2, &st);
+    CHECK(psp_read32(last) == 0x12FFFFFFu, "valid edge pixel uses checked fallback");
+    st.tex_enable = 1; st.tex_addr = last; st.tex_fmt = 3;
+    st.tex_bw = st.tex_w = 2; st.tex_h = 1; st.tex_func = 3;
+    psp_render_current()->set_target(FB, 512, 3);
+    psp_write32(FB, 0);
+    psp_render_current()->draw(PSP_PRIM_SPRITES, quad, 2, &st);
+    CHECK(psp_read32(FB) == 0x00FFFFFFu, "valid texel uses checked fallback");
+    CHECK(psp_mem_bad_access == 0, "rejected bulk spans do not cause spurious faults");
+
+    const uint32_t region = 0x08980000u;
+    CHECK(psp_mem_map_extra(region + 128, 128) == 0, "test overlay maps");
+    CHECK(psp_mem_unwatched_ptr(region, 512) == NULL, "span cannot skip an internal overlay");
+    CHECK(psp_mem_unwatched_ptr(region + 128, 128) != NULL, "span inside overlay resolves");
+}
