+static inline __attribute__((always_inline)) uint32_t swar_modulate(uint32_t t, uint32_t c) {
+#ifdef __SSE2__
+    const __m128i z = _mm_setzero_si128();
+    const __m128i t16 = _mm_unpacklo_epi8(_mm_cvtsi32_si128((int)t), z);
+    const __m128i c16 = _mm_unpacklo_epi8(_mm_cvtsi32_si128((int)c), z);
+    __m128i m = _mm_add_epi16(_mm_mullo_epi16(t16, c16), _mm_set1_epi16(128));
+    m = _mm_srli_epi16(_mm_add_epi16(m, _mm_srli_epi16(m, 8)), 8);
+    return (uint32_t)_mm_cvtsi128_si32(_mm_packus_epi16(m, z));
+#else
+    return (uint32_t)mul8(R(t), R(c))
+        | ((uint32_t)mul8(G(t), G(c)) << 8)
+        | ((uint32_t)mul8(B(t), B(c)) << 16)
+        | ((uint32_t)mul8(A(t), A(c)) << 24);
+#endif
+}
+
+static inline __attribute__((always_inline)) void sw_tri_t8_write_ptr(
+    const psp_draw_state * restrict st, uint8_t * restrict px_ptr,
+    uint32_t col, int k_blend, int k_stencil) {
+    if (k_stencil) {
+        if (k_blend == 0 && st->stencil_func == 1 && st->stencil_zpass == 2) {
+            uint32_t dst = (col & 0x00FFFFFFu) | ((uint32_t)st->stencil_ref << 24);
+            memcpy(px_ptr, &dst, 4);
+            return;
+        }
+        uint32_t dst;
+        memcpy(&dst, px_ptr, 4);
+        int stencil = (int)(dst >> 24);
+        if (!depth_pass(st->stencil_func, st->stencil_ref & st->stencil_mask, stencil & st->stencil_mask)) {
+            if (st->stencil_fail != 0) {
+                stencil = stencil_op(st->stencil_fail, stencil, st->stencil_ref);
+                dst = (dst & 0x00FFFFFFu) | ((uint32_t)stencil << 24);
+                memcpy(px_ptr, &dst, 4);
+            }
+            return;
+        }
+        stencil = stencil_op(st->stencil_zpass, stencil, st->stencil_ref);
+        if (k_blend == 1) {
+            const uint32_t al = A(col);
+            if (al == 0u) col = dst;
+            else if (al != 255u) col = swar_std_blend(col, dst, al);
+        } else if (k_blend == 2) {
+            const uint32_t al = A(col);
+            if (al == 0u) col = dst;
+            else col = (al == 255u) ? swar_add_one(col, dst) : swar_add_alpha(col, dst, al);
+        } else if (k_blend == 3) {
+            col = swar_add_one(col, dst);
+        }
+        dst = (col & 0x00FFFFFFu) | ((uint32_t)stencil << 24);
+        memcpy(px_ptr, &dst, 4);
+        return;
+    }
+    if (k_blend == 1) {
+        const uint32_t al = A(col);
+        if (al == 0u) return;
+        uint32_t dst;
+        memcpy(&dst, px_ptr, 4);
+        if (al != 255u) col = swar_std_blend(col, dst, al);
+        dst = (col & 0x00FFFFFFu) | (dst & 0xFF000000u);
+        memcpy(px_ptr, &dst, 4);
+        return;
+    }
+    if (k_blend == 2) {
+        const uint32_t al = A(col);
+        if (al == 0u) return;
+        uint32_t dst;
+        memcpy(&dst, px_ptr, 4);
+        col = (al == 255u) ? swar_add_one(col, dst) : swar_add_alpha(col, dst, al);
+        dst = (col & 0x00FFFFFFu) | (dst & 0xFF000000u);
+        memcpy(px_ptr, &dst, 4);
+        return;
+    }
+    if (k_blend == 3) {
+        uint32_t dst;
+        memcpy(&dst, px_ptr, 4);
+        col = swar_add_one(col, dst);
+        dst = (col & 0x00FFFFFFu) | (dst & 0xFF000000u);
+        memcpy(px_ptr, &dst, 4);
+        return;
+    }
+    uint32_t dst;
+    memcpy(&dst, px_ptr, 4);
+    dst = (col & 0x00FFFFFFu) | (dst & 0xFF000000u);
+    memcpy(px_ptr, &dst, 4);
+}
