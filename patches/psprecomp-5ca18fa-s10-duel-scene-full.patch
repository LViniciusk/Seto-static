+        switch (op) {
+        case PSP_VRND_I:  bits = r; break;
+        case PSP_VRND_F1: bits = 0x3F800000u | (r & 0x7FFFFFu); break;
+        case PSP_VRND_F2: bits = 0x40000000u | (r & 0x7FFFFFu); break;
+        default:          psp_vfpu_unimplemented(psp_cpu.pc, "vrnd"); end_op(); return;
+        }
+        out[i] = psp_bits_to_f32(bits);
+    }
+    write_dst(vd, size, out);
+    end_op();
+}
+
+/* ---- Horizontal vector reductions & sort pairs ----------------------------- */
+
+void psp_vfad(uint32_t vd, uint32_t vs, int size) {
+    if (size < 1 || size > 4) size = 4;
+    float s[4];
+    read_src(0, vs, size, s);
+    float sum = 0.0f;
+    for (int i = 0; i < size; i++) sum += s[i];
+    if (g_prefix_set[0]) {
+        const uint32_t p = g_prefix[0];
+        for (int i = size; i < 4; i++) {
+            if ((p >> (12 + i)) & 1) {
+                float c = PFX_CONST[((p >> (2 * i)) & 3) | (((p >> (8 + i)) & 1) << 2)];
+                if ((p >> (16 + i)) & 1) c = -c;
+                sum += c;
+            }
+        }
+    }
+    float out[4] = { sum, 0.0f, 0.0f, 0.0f };
+    write_dst(vd, 1, out);
+    end_op();
+}
+
+void psp_vavg(uint32_t vd, uint32_t vs, int size) {
+    static const float AVG_SCALE[4] = { 0.0f, 0.5f, 1.0f / 3.0f, 0.25f };
+    if (size < 1 || size > 4) size = 4;
+    float s[4];
+    read_src(0, vs, size, s);
+    float sum = 0.0f;
+    for (int i = 0; i < size; i++) sum += s[i];
+    if (g_prefix_set[0]) {
+        const uint32_t p = g_prefix[0];
+        for (int i = size; i < 4; i++) {
+            if ((p >> (12 + i)) & 1) {
+                float c = PFX_CONST[((p >> (2 * i)) & 3) | (((p >> (8 + i)) & 1) << 2)];
+                if ((p >> (16 + i)) & 1) c = -c;
+                sum += c;
+            }
+        }
+    }
+    float out[4] = { sum * AVG_SCALE[size - 1], 0.0f, 0.0f, 0.0f };
+    write_dst(vd, 1, out);
+    end_op();
+}
+
+void psp_vsrt(int op, uint32_t vd, uint32_t vs, int size) {
+    float s[4] = { 0 }, out[4] = { 0 };
+    if (size < 1 || size > 4) size = 4;
+    read_src(0, vs, size, s);
+    switch (op) {
+    case PSP_VSRT1:
+        out[0] = fminf(s[1], s[0]); out[1] = fmaxf(s[1], s[0]);
+        out[2] = fminf(s[3], s[2]); out[3] = fmaxf(s[3], s[2]);
+        break;
+    case PSP_VSRT2:
+        out[0] = fminf(s[3], s[0]); out[1] = fminf(s[2], s[1]);
+        out[2] = fmaxf(s[1], s[2]); out[3] = fmaxf(s[0], s[3]);
+        break;
+    case PSP_VSRT3:
+        out[0] = fmaxf(s[0], s[1]); out[1] = fminf(s[1], s[0]);
+        out[2] = fmaxf(s[2], s[3]); out[3] = fminf(s[3], s[2]);
+        break;
+    case PSP_VSRT4:
+        out[0] = fmaxf(s[0], s[3]); out[1] = fmaxf(s[1], s[2]);
+        out[2] = fminf(s[2], s[1]); out[3] = fminf(s[3], s[0]);
+        break;
+    default:
+        psp_vfpu_unimplemented(psp_cpu.pc, "vsrt");
+        end_op();
+        return;
+    }
+    write_dst(vd, size, out);
+    end_op();
+}
