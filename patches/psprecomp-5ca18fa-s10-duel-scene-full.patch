+static inline __attribute__((always_inline)) void sw_tri_t8_fast_kernel_ex(
+    const psp_vertex *a, const psp_vertex *b, const psp_vertex *c,
+    const psp_draw_state * restrict st, int minx, int maxx, int miny, int maxy,
+    int area, float h0, float h1, float h2,
+    int k_blend, int k_stencil, int k_gouraud, int k_mod_white,
+    int k_ztest, int k_zwrite, int k_atest, int k_bilin,
+    int k_tex_mode, int k_tex_alpha, int k_fog, int k_decal) {
+    const int k_is_t4 = (k_tex_mode == 1);
+    const int has_tex = (k_tex_mode != 3);
+    const int dy0 = b->y - a->y, dy1 = c->y - b->y, dy2 = a->y - c->y;
+    const uint32_t flat_col = c->rgba;
+    const uint32_t fog_rgb = st->fog_color & 0x00FFFFFFu;
+    uint8_t * restrict fb_base = g_fb_span.data + (uint32_t)(g_fb_addr - g_fb_span.addr);
+    uint8_t * restrict z_base = k_ztest ? (g_z_span.data + (uint32_t)(st->zaddr - g_z_span.addr)) : NULL;
+    const uint8_t * restrict tex_base = g_tex_base;
+    const uint32_t * restrict clut = g_clut_lut;
+    const uint32_t * restrict lin_tex = g_tex_lin;
+    const uint32_t tex_blocks = g_tex_blocks;
+    const int tex_w = st->tex_w, tex_h = st->tex_h;
+    const int clamp_u = st->tex_clamp_u, clamp_v = st->tex_clamp_v;
+    const int zfunc = st->zfunc;
+    const int early_z = k_ztest && !k_atest && (!k_stencil || (st->stencil_func == 1 && st->stencil_zfail == 0));
+    const uint32_t fb_stride = g_fb_stride;
+    const double inv_d = 1.0 / (double)area;
+    const double dudx = has_tex ? (-(double)dy1 * a->u - (double)dy2 * b->u - (double)dy0 * c->u) * inv_d : 0.0;
+    const double dvdx = has_tex ? (-(double)dy1 * a->v - (double)dy2 * b->v - (double)dy0 * c->v) * inv_d : 0.0;
+    const float dzdx = k_ztest ? (float)((-(double)dy1 * a->z - (double)dy2 * b->z - (double)dy0 * c->z) * inv_d) : 0.0f;
+    const int64_t dfogdx = k_fog ? (int64_t)(((-(double)dy1 * a->fog - (double)dy2 * b->fog - (double)dy0 * c->fog) * inv_d) * (255.0 * 65536.0)) : 0;
+    const int64_t dfudx = has_tex ? (int64_t)(dudx * 16777216.0) : 0;
+    const int64_t dfvdx = has_tex ? (int64_t)(dvdx * 16777216.0) : 0;
+    (void)tex_base; (void)clut; (void)lin_tex; (void)tex_blocks;
+    (void)tex_w; (void)tex_h; (void)clamp_u; (void)clamp_v; (void)k_is_t4; (void)fog_rgb; (void)dfogdx;
+    const int32_t drdx = k_gouraud ? (int32_t)(((-(double)dy1 * (int)R(a->rgba) - (double)dy2 * (int)R(b->rgba) - (double)dy0 * (int)R(c->rgba)) * inv_d) * 65536.0) : 0;
