+static int sw_tri_tex(const psp_vertex *a, const psp_vertex *b, const psp_vertex *c,
+                      const psp_draw_state *st, int minx, int maxx, int miny, int maxy,
+                      int area, float inv, float h0, float h1, float h2, int gouraud, int fog) {
+    const int dy0 = b->y - a->y, dy1 = c->y - b->y, dy2 = a->y - c->y;
+    const uint32_t flat_col = c->rgba;
+    const int have_z = st->zaddr && st->zbw > 0;
+    uint8_t *fb_base = g_fb_span.data + (uint32_t)(g_fb_addr - g_fb_span.addr);
+    uint8_t *z_base = have_z && g_z_span.data
+        ? g_z_span.data + (uint32_t)(st->zaddr - g_z_span.addr) : NULL;
+    const int zrange = zrange_needed(a, b, c, st);
+    const int ztest = st->ztest && have_z;
+    const int zwrite = ztest && st->zwrite;
+    const int zfunc = st->zfunc;
+    const int zmin = st->zmin, zmax = st->zmax;
+    const int need_z = ztest || zrange;
+    const int white_verts = !gouraud
+        ? ((flat_col & 0x00FFFFFFu) == 0x00FFFFFFu)
+        : (((a->rgba & b->rgba & c->rgba) & 0x00FFFFFFu) == 0x00FFFFFFu);
+    const int mod_white = !st->tex_double &&
+        ((st->tex_func == 0 && white_verts) || st->tex_func == 3 ||
+         (st->tex_func == 1 && !st->tex_alpha));
+    const int simple_mod = !st->tex_double && st->tex_func == 0;
+    const int is_decal = !st->tex_double && st->tex_func == 1 && st->tex_alpha;
+    const int tex_ok = mod_white || simple_mod || is_decal;
+    const int bilin = (st->tex_filter & 0x101) != 0;
+    const int is_t4 = st->tex_fmt == PSP_TPSM_T4;
+    const int swz_fast = g_tex_base && (st->tex_fmt == PSP_TPSM_T8 || is_t4) && g_clut_fast &&
+        st->tex_swizzle && st->tex_bw >= st->tex_w && g_tex_rowb >= 16u &&
+        st->tex_w > 0 && st->tex_h > 0 && uv_fp_eligible(a, b, c) && tex_ok;
+    const uint32_t *lin = (!zrange && g_fb_fmt == 3 && (!ztest || g_z_span.data) &&
+        uv_fp_eligible(a, b, c) && tex_ok)
+        ? sw_tex_resolve_linear(st) : NULL;
+    if (lin) {
+        if (!fog && !is_decal && bilin && !ztest) {
+            if (!gouraud && mod_white) sw_tri_lin_opaque_mw(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+            else if (!gouraud)         sw_tri_lin_opaque_flat(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+            else if (mod_white)        sw_tri_lin_opaque_gmw(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+            else                       sw_tri_lin_opaque_gouraud(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+        } else if (!fog && !is_decal && bilin && ztest && zwrite) {
+            if (!gouraud && mod_white) sw_tri_lin_z_opaque_mw(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+            else if (!gouraud)         sw_tri_lin_z_opaque_flat(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+            else if (mod_white)        sw_tri_lin_z_opaque_gmw(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+            else                       sw_tri_lin_z_opaque_gouraud(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+        } else if (fog && !is_decal && bilin && ztest && zwrite) {
+            if (!gouraud && mod_white) sw_tri_lin_z_fog_opaque_mw(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+            else if (!gouraud)         sw_tri_lin_z_fog_opaque_flat(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+            else if (mod_white)        sw_tri_lin_z_fog_opaque_gmw(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+            else                       sw_tri_lin_z_fog_opaque_gouraud(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+        } else if (!fog && !is_decal && !bilin && !ztest) {
+            sw_tri_lin_near_opaque_gm(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2, gouraud, mod_white);
+        } else if (!fog && !is_decal && !bilin && ztest && zwrite) {
+            sw_tri_lin_near_z_opaque_gm(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2, gouraud, mod_white);
+        } else if (!fog && !is_decal && bilin && ztest && !zwrite) {
+            sw_tri_lin_znw_opaque_gm(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2, gouraud, mod_white);
+        } else if (!fog && is_decal && bilin && !ztest) {
+            sw_tri_lin_decal_opaque_gm(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2, gouraud, mod_white);
+        } else if (fog && is_decal && bilin && ztest && zwrite) {
+            sw_tri_lin_z_fog_decal_gm(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2, gouraud, mod_white);
+        } else {
+            sw_tri_lin_za_opaque_fn(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2,
+                                    ztest, zwrite, bilin, gouraud, mod_white, fog, is_decal);
+        }
+        return 1;
+    }
+    if (!fog && !is_decal && !is_t4 && swz_fast && bilin && !ztest && !zrange && g_fb_fmt == 3) {
+        if (mod_white && !gouraud) sw_tri_t8_opaque_mw(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+        else                       sw_tri_t8_opaque_fn(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2, gouraud, mod_white);
+        return 1;
+    }
+    if (swz_fast && !zrange && g_fb_fmt == 3 && (!ztest || g_z_span.data)) {
+        if (!is_t4 && !is_decal && bilin && ztest && zwrite && !fog)
+            sw_tri_t8_z_opaque_gm(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2, gouraud, mod_white);
+        else if (!is_t4 && !is_decal && bilin && ztest && zwrite && fog)
+            sw_tri_t8_z_fog_opaque_gm(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2, gouraud, mod_white);
+        else if (is_t4)
+            sw_tri_t4_za_opaque_fn(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2,
+                                   ztest, zwrite, bilin, gouraud, mod_white, fog, is_decal);
+        else
+            sw_tri_t8_za_opaque_fn(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2,
+                                   ztest, zwrite, bilin, gouraud, mod_white, fog, is_decal);
+        return 1;
+    }
+    if (fog) return 0;
+    const double inv_d = 1.0 / (double)area;
+    const double dudx = (-(double)dy1 * a->u - (double)dy2 * b->u - (double)dy0 * c->u) * inv_d;
+    const double dvdx = (-(double)dy1 * a->v - (double)dy2 * b->v - (double)dy0 * c->v) * inv_d;
+    const float dzdx = need_z ? (float)((-(double)dy1 * a->z - (double)dy2 * b->z - (double)dy0 * c->z) * inv_d) : 0.0f;
+    const int use_fp = uv_fp_eligible(a, b, c);
+    const int64_t dfudx = use_fp ? (int64_t)(dudx * 16777216.0) : 0;
+    const int64_t dfvdx = use_fp ? (int64_t)(dvdx * 16777216.0) : 0;
+    const int32_t drdx = gouraud ? (int32_t)(((-(double)dy1 * (int)R(a->rgba) - (double)dy2 * (int)R(b->rgba) - (double)dy0 * (int)R(c->rgba)) * inv_d) * 65536.0) : 0;
+    const int32_t dgdx = gouraud ? (int32_t)(((-(double)dy1 * (int)G(a->rgba) - (double)dy2 * (int)G(b->rgba) - (double)dy0 * (int)G(c->rgba)) * inv_d) * 65536.0) : 0;
+    const int32_t dbdx = gouraud ? (int32_t)(((-(double)dy1 * (int)B(a->rgba) - (double)dy2 * (int)B(b->rgba) - (double)dy0 * (int)B(c->rgba)) * inv_d) * 65536.0) : 0;
+    const int32_t dadx = gouraud ? (int32_t)(((-(double)dy1 * (int)A(a->rgba) - (double)dy2 * (int)A(b->rgba) - (double)dy0 * (int)A(c->rgba)) * inv_d) * 65536.0) : 0;
+    uint64_t px_drawn = 0;
+    (void)inv;
+
+    for (int y = miny; y <= maxy; y++) {
+        int xs, xe, w0, w1, w2;
+        if (!tri_row_span(a, b, c, area, minx, maxx, y, &xs, &xe, &w0, &w1, &w2)) continue;
+        const uint32_t fb_row_off = (uint32_t)(y * (int)g_fb_stride);
+        const uint32_t z_row_off = (uint32_t)(y * st->zbw);
+        const double la = ((double)w1 + (double)h1) * inv_d;
+        const double lb = ((double)w2 + (double)h2) * inv_d;
+        const double lc = ((double)w0 + (double)h0) * inv_d;
+        const double u0 = a->u * la + b->u * lb + c->u * lc;
+        const double v0 = a->v * la + b->v * lb + c->v * lc;
+        int64_t fu = use_fp ? (int64_t)(u0 * 16777216.0) : 0;
+        int64_t fv = use_fp ? (int64_t)(v0 * 16777216.0) : 0;
+        float u = (float)u0, v = (float)v0;
+        float zf = need_z ? (float)(a->z * la + b->z * lb + c->z * lc) : 0.0f;
+        int32_t cr = gouraud ? (int32_t)((R(a->rgba) * la + R(b->rgba) * lb + R(c->rgba) * lc) * 65536.0 + 0.5) : 0;
+        int32_t cg = gouraud ? (int32_t)((G(a->rgba) * la + G(b->rgba) * lb + G(c->rgba) * lc) * 65536.0 + 0.5) : 0;
+        int32_t cb = gouraud ? (int32_t)((B(a->rgba) * la + B(b->rgba) * lb + B(c->rgba) * lc) * 65536.0 + 0.5) : 0;
+        int32_t ca = gouraud ? (int32_t)((A(a->rgba) * la + A(b->rgba) * lb + A(c->rgba) * lc) * 65536.0 + 0.5) : 0;
+        for (int x = xs; x <= xe; x++, fu += dfudx, fv += dfvdx, u += (float)dudx, v += (float)dvdx, zf += dzdx,
+                                      cr += drdx, cg += dgdx, cb += dbdx, ca += dadx) {
+            int z = 0;
+            if (need_z) {
+                z = zf < 0.0f ? 0 : (zf > 65535.0f ? 65535 : (int)(zf + 0.5f));
+                if (zrange && (z < zmin || z > zmax)) continue;
+                if (ztest) {
+                    uint16_t zd;
+                    memcpy(&zd, z_base + (z_row_off + (uint32_t)x) * 2u, 2);
+                    if (!depth_pass(zfunc, z, zd)) continue;
+                }
+            }
+            uint32_t col = use_fp ? tex_sample_fp(st, fu, fv) : tex_sample(st, u, v);
+            if (!mod_white) {
+                const uint32_t vc = gouraud
+                    ? ((uint32_t)clamp8((cr + 32768) >> 16) |
+                       ((uint32_t)clamp8((cg + 32768) >> 16) << 8) |
+                       ((uint32_t)clamp8((cb + 32768) >> 16) << 16) |
+                       ((uint32_t)clamp8((ca + 32768) >> 16) << 24))
+                    : flat_col;
+                col = tex_combine(st, col, vc);
+            }
+            if (zwrite) {
+                const uint16_t zv = (uint16_t)z;
+                memcpy(z_base + (z_row_off + (uint32_t)x) * 2u, &zv, 2);
+            }
+            fb_write_fast_keep_alpha(fb_base, fb_row_off + (uint32_t)x, col);
+            px_drawn++;
+        }
+    }
+    g_pixels += px_drawn;
+    return 1;
+}
