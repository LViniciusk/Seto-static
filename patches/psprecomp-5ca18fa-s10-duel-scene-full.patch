+static void sw_tri_tex_ab_generic(const psp_vertex *a, const psp_vertex *b, const psp_vertex *c,
+                                  const psp_draw_state * restrict st, int minx, int maxx, int miny, int maxy,
+                                  int area, float h0, float h1, float h2, int gouraud, int mod_white) {
+    const int dy0 = b->y - a->y, dy1 = c->y - b->y, dy2 = a->y - c->y;
+    const uint32_t flat_col = c->rgba;
+    const int have_z = st->zaddr && st->zbw > 0;
+    uint8_t * restrict fb_base = g_fb_span.data + (uint32_t)(g_fb_addr - g_fb_span.addr);
+    uint8_t * restrict z_base = have_z && g_z_span.data
+        ? g_z_span.data + (uint32_t)(st->zaddr - g_z_span.addr) : NULL;
+    const int zrange = zrange_needed(a, b, c, st);
+    const int ztest = st->ztest && have_z;
+    const int zwrite = ztest && st->zwrite;
+    const int zfunc = st->zfunc;
+    const int zmin = st->zmin, zmax = st->zmax;
+    const int do_stencil = st->stencil;
+    const int early_z = ztest && !st->atest && !do_stencil;
+    const int need_z = ztest || zrange;
+    const int tex_en = st->tex_enable;
+    const int atest = st->atest;
+    const int do_blend = st->blend;
+    const int std_blend = do_blend && st->blend_src == 2 && st->blend_dst == 3 && st->blend_op == 0;
+    const int fb_is_8888 = (g_fb_fmt == 3);
+    const uint32_t fb_stride = g_fb_stride;
+    const double inv_d = 1.0 / (double)area;
+    const double dudx = tex_en ? (-(double)dy1 * a->u - (double)dy2 * b->u - (double)dy0 * c->u) * inv_d : 0.0;
+    const double dvdx = tex_en ? (-(double)dy1 * a->v - (double)dy2 * b->v - (double)dy0 * c->v) * inv_d : 0.0;
+    const float dzdx = need_z ? (float)((-(double)dy1 * a->z - (double)dy2 * b->z - (double)dy0 * c->z) * inv_d) : 0.0f;
+    const int use_fp = tex_en && uv_fp_eligible(a, b, c);
+    const int64_t dfudx = use_fp ? (int64_t)(dudx * 16777216.0) : 0;
+    const int64_t dfvdx = use_fp ? (int64_t)(dvdx * 16777216.0) : 0;
+    const int32_t drdx = gouraud ? (int32_t)(((-(double)dy1 * (int)R(a->rgba) - (double)dy2 * (int)R(b->rgba) - (double)dy0 * (int)R(c->rgba)) * inv_d) * 65536.0) : 0;
+    const int32_t dgdx = gouraud ? (int32_t)(((-(double)dy1 * (int)G(a->rgba) - (double)dy2 * (int)G(b->rgba) - (double)dy0 * (int)G(c->rgba)) * inv_d) * 65536.0) : 0;
+    const int32_t dbdx = gouraud ? (int32_t)(((-(double)dy1 * (int)B(a->rgba) - (double)dy2 * (int)B(b->rgba) - (double)dy0 * (int)B(c->rgba)) * inv_d) * 65536.0) : 0;
+    const int32_t dadx = gouraud ? (int32_t)(((-(double)dy1 * (int)A(a->rgba) - (double)dy2 * (int)A(b->rgba) - (double)dy0 * (int)A(c->rgba)) * inv_d) * 65536.0) : 0;
+    uint64_t px_drawn = 0;
+
+    for (int y = miny; y <= maxy; y++) {
+        int xs, xe, w0, w1, w2;
+        if (!tri_row_span(a, b, c, area, minx, maxx, y, &xs, &xe, &w0, &w1, &w2)) continue;
+        const uint32_t fb_row_off = (uint32_t)(y * (int)fb_stride);
+        const uint32_t z_row_off = (uint32_t)(y * st->zbw);
+        double la = 0.0, lb = 0.0, lc = 0.0;
+        if (tex_en || need_z || gouraud) {
+            la = ((double)w1 + (double)h1) * inv_d;
+            lb = ((double)w2 + (double)h2) * inv_d;
+            lc = ((double)w0 + (double)h0) * inv_d;
+        }
+        const double u0 = tex_en ? (a->u * la + b->u * lb + c->u * lc) : 0.0;
+        const double v0 = tex_en ? (a->v * la + b->v * lb + c->v * lc) : 0.0;
+        int64_t fu = use_fp ? (int64_t)(u0 * 16777216.0) : 0;
+        int64_t fv = use_fp ? (int64_t)(v0 * 16777216.0) : 0;
+        float u = (float)u0, v = (float)v0;
+        float zf = need_z ? (float)(a->z * la + b->z * lb + c->z * lc) : 0.0f;
+        int32_t cr = gouraud ? (int32_t)((R(a->rgba) * la + R(b->rgba) * lb + R(c->rgba) * lc) * 65536.0 + 0.5) : 0;
+        int32_t cg = gouraud ? (int32_t)((G(a->rgba) * la + G(b->rgba) * lb + G(c->rgba) * lc) * 65536.0 + 0.5) : 0;
+        int32_t cb = gouraud ? (int32_t)((B(a->rgba) * la + B(b->rgba) * lb + B(c->rgba) * lc) * 65536.0 + 0.5) : 0;
+        int32_t ca = gouraud ? (int32_t)((A(a->rgba) * la + A(b->rgba) * lb + A(c->rgba) * lc) * 65536.0 + 0.5) : 0;
+
+        for (int x = xs; x <= xe; x++, fu += dfudx, fv += dfvdx, u += (float)dudx, v += (float)dvdx, zf += dzdx,
+                                      cr += drdx, cg += dgdx, cb += dbdx, ca += dadx) {
+            int z = 0;
+            if (early_z || zrange) {
+                z = zf < 0.0f ? 0 : (zf > 65535.0f ? 65535 : (int)(zf + 0.5f));
+                if (zrange && (z < zmin || z > zmax)) continue;
+                if (early_z) {
+                    uint16_t zd;
+                    memcpy(&zd, z_base + (z_row_off + (uint32_t)x) * 2u, 2);
+                    if (!depth_pass(zfunc, z, zd)) continue;
+                }
+            }
+            uint32_t col;
+            if (tex_en) {
+                col = use_fp ? tex_sample_fp(st, fu, fv) : tex_sample(st, u, v);
+                if (!mod_white) {
+                    const uint32_t vc = gouraud
+                        ? ((uint32_t)clamp8((cr + 32768) >> 16) |
+                           ((uint32_t)clamp8((cg + 32768) >> 16) << 8) |
+                           ((uint32_t)clamp8((cb + 32768) >> 16) << 16) |
+                           ((uint32_t)clamp8((ca + 32768) >> 16) << 24))
+                        : flat_col;
+                    col = tex_combine(st, col, vc);
+                }
+            } else {
+                col = gouraud
+                    ? ((uint32_t)clamp8((cr + 32768) >> 16) |
+                       ((uint32_t)clamp8((cg + 32768) >> 16) << 8) |
+                       ((uint32_t)clamp8((cb + 32768) >> 16) << 16) |
+                       ((uint32_t)clamp8((ca + 32768) >> 16) << 24))
+                    : flat_col;
+            }
+            if (atest && !alpha_pass(st, col)) continue;
+            const uint32_t fb_off = fb_row_off + (uint32_t)x;
+            if (do_stencil) {
+                uint32_t dst;
+                memcpy(&dst, fb_base + fb_off * 4u, 4);
+                int stencil = (int)(dst >> 24);
+                if (!depth_pass(st->stencil_func, st->stencil_ref & st->stencil_mask, stencil & st->stencil_mask)) {
+                    stencil = stencil_op(st->stencil_fail, stencil, st->stencil_ref);
+                    dst = (dst & 0x00FFFFFFu) | ((uint32_t)stencil << 24);
+                    memcpy(fb_base + fb_off * 4u, &dst, 4);
+                    px_drawn++;
+                    continue;
+                }
+                if (ztest) {
+                    if (!zrange) z = zf < 0.0f ? 0 : (zf > 65535.0f ? 65535 : (int)(zf + 0.5f));
+                    uint16_t zd;
+                    memcpy(&zd, z_base + (z_row_off + (uint32_t)x) * 2u, 2);
+                    if (!depth_pass(zfunc, z, zd)) {
+                        stencil = stencil_op(st->stencil_zfail, stencil, st->stencil_ref);
+                        dst = (dst & 0x00FFFFFFu) | ((uint32_t)stencil << 24);
+                        memcpy(fb_base + fb_off * 4u, &dst, 4);
+                        px_drawn++;
+                        continue;
+                    }
+                }
+                if (zwrite) {
+                    const uint16_t zv = (uint16_t)z;
+                    memcpy(z_base + (z_row_off + (uint32_t)x) * 2u, &zv, 2);
+                }
+                stencil = stencil_op(st->stencil_zpass, stencil, st->stencil_ref);
+                if (do_blend) {
+                    if (std_blend) {
+                        const uint32_t al = A(col);
+                        if (al == 0u) col = dst;
+                        else if (al != 255u) col = swar_std_blend(col, dst, al);
+                    } else {
+                        col = blend(st, col, dst);
+                    }
+                }
+                dst = (col & 0x00FFFFFFu) | ((uint32_t)stencil << 24);
+                memcpy(fb_base + fb_off * 4u, &dst, 4);
+                px_drawn++;
+                continue;
+            }
+            if (!early_z && ztest) {
+                if (!zrange) z = zf < 0.0f ? 0 : (zf > 65535.0f ? 65535 : (int)(zf + 0.5f));
+                uint16_t zd;
+                memcpy(&zd, z_base + (z_row_off + (uint32_t)x) * 2u, 2);
+                if (!depth_pass(zfunc, z, zd)) continue;
+            }
+            if (zwrite) {
+                const uint16_t zv = (uint16_t)z;
+                memcpy(z_base + (z_row_off + (uint32_t)x) * 2u, &zv, 2);
+            }
+            if (do_blend && fb_is_8888) {
+                uint32_t dst;
+                memcpy(&dst, fb_base + fb_off * 4u, 4);
+                if (std_blend) {
+                    const uint32_t al = A(col);
+                    if (al == 0u) {
+                        px_drawn++;
+                        continue;
+                    }
+                    if (al != 255u) col = swar_std_blend(col, dst, al);
+                } else {
+                    col = blend(st, col, dst);
+                }
+                dst = (col & 0x00FFFFFFu) | (dst & 0xFF000000u);
+                memcpy(fb_base + fb_off * 4u, &dst, 4);
+                px_drawn++;
+                continue;
+            }
+            if (do_blend) col = blend(st, col, fb_read_fast(fb_base, fb_off));
+            fb_write_fast_keep_alpha(fb_base, fb_off, col);
+            px_drawn++;
+        }
+    }
+    g_pixels += px_drawn;
+}
+
+static int sw_tri_tex_ab(const psp_vertex *a, const psp_vertex *b, const psp_vertex *c,
+                         const psp_draw_state *st, int minx, int maxx, int miny, int maxy,
+                         int area, float inv, float h0, float h1, float h2, int gouraud, int fog) {
+    const int have_z = st->zaddr && st->zbw > 0;
+    const int ztest = st->ztest && have_z;
+    const int eff_stencil = effective_stencil(st, ztest);
+    const int eff_atest = effective_atest(st);
+    const int zrange = zrange_needed(a, b, c, st);
+    const int bmode = fast_blend_mode(st);
+    const int std_blend = (bmode == 1);
+    const uint32_t flat_col = c->rgba;
+    const int all_white = !gouraud
+        ? (flat_col == 0xFFFFFFFFu)
+        : ((a->rgba & b->rgba & c->rgba) == 0xFFFFFFFFu);
+    const int mod_white = !st->tex_double &&
+        ((st->tex_func == 0 && all_white) || (st->tex_func == 3 && st->tex_alpha));
+    const int simple_mod = !st->tex_double && st->tex_func == 0;
+    const int is_decal = !st->tex_double && st->tex_func == 1;
+    const int tex_ok = mod_white || simple_mod || is_decal;
+    const int bilin = (st->tex_filter & 0x101) != 0;
+    const int is_t4 = st->tex_fmt == PSP_TPSM_T4;
+    const int swz_fast = st->tex_enable && g_tex_base && (st->tex_fmt == PSP_TPSM_T8 || is_t4) && g_clut_fast &&
+        st->tex_swizzle && st->tex_bw >= st->tex_w && g_tex_rowb >= 16u &&
+        st->tex_w > 0 && st->tex_h > 0 && uv_fp_eligible(a, b, c) && tex_ok;
+    (void)inv;
+    if (!zrange && g_fb_fmt == 3 && bmode >= 0 && (!ztest || g_z_span.data) && fast_stencil_z_ok(st, eff_stencil, ztest, st->zwrite)) {
+        if (!st->tex_enable) {
+            if (!fog && !eff_stencil && !gouraud && !ztest && !eff_atest && bmode == 1) {
+                const uint32_t al = A(flat_col);
+                uint8_t * restrict fb_base = g_fb_span.data + (uint32_t)(g_fb_addr - g_fb_span.addr);
+                const uint32_t fb_stride = g_fb_stride;
+                uint64_t px_drawn = 0;
+                for (int y = miny; y <= maxy; y++) {
+                    int xs, xe, w0, w1, w2;
+                    if (!tri_row_span(a, b, c, area, minx, maxx, y, &xs, &xe, &w0, &w1, &w2)) continue;
+                    px_drawn += (uint64_t)(xe - xs + 1);
+                    if (al == 0u) continue;
+                    uint8_t * restrict px_ptr = fb_base + ((uint32_t)(y * (int)fb_stride) + (uint32_t)xs) * 4u;
+                    if (al == 255u) {
+                        const uint32_t rgb = flat_col & 0x00FFFFFFu;
+                        for (int x = xs; x <= xe; x++, px_ptr += 4) {
+                            uint32_t dst;
+                            memcpy(&dst, px_ptr, 4);
+                            dst = rgb | (dst & 0xFF000000u);
+                            memcpy(px_ptr, &dst, 4);
+                        }
+                    } else {
+                        for (int x = xs; x <= xe; x++, px_ptr += 4) {
+                            uint32_t dst;
+                            memcpy(&dst, px_ptr, 4);
+                            uint32_t c0 = swar_std_blend(flat_col, dst, al);
+                            dst = (c0 & 0x00FFFFFFu) | (dst & 0xFF000000u);
+                            memcpy(px_ptr, &dst, 4);
+                        }
+                    }
+                }
+                g_pixels += px_drawn;
+                return 1;
+            } else if (!fog && !eff_stencil && gouraud && !ztest && !eff_atest && bmode == 1) {
+                sw_tri_solid_blend_gouraud(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+                return 1;
+            }
+            sw_tri_solid_za_fn(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2,
+                               bmode, eff_stencil, ztest, ztest && st->zwrite, eff_atest, gouraud, fog);
+            return 1;
+        }
+        if (uv_fp_eligible(a, b, c) && tex_ok) {
+            const uint32_t *lin = sw_tex_resolve_linear(st);
+            if (lin) {
+                if (!fog && !is_decal && !eff_stencil && !ztest && !eff_atest && bilin && st->tex_alpha && bmode == 1) {
+                    if (!gouraud && mod_white) sw_tri_lin_blend_mw(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+                    else if (!gouraud)         sw_tri_lin_blend_flat(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+                    else if (mod_white)        sw_tri_lin_blend_gmw(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+                    else                       sw_tri_lin_blend_gouraud(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+                } else if (!fog && !is_decal && !eff_stencil && !ztest && !eff_atest && !bilin && st->tex_alpha && bmode == 1) {
+                    sw_tri_lin_near_blend_gm(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2, gouraud, mod_white);
+                } else if (!fog && !is_decal && !eff_stencil && !ztest && !eff_atest && !bilin && !st->tex_alpha && bmode == 1) {
+                    sw_tri_lin_near_blend_noa_gm(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2, gouraud, mod_white);
+                } else if (!fog && !is_decal && !eff_stencil && !ztest && !eff_atest && bilin && !st->tex_alpha && bmode == 1) {
+                    sw_tri_lin_blend_noa_gm(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2, gouraud, mod_white);
+                } else if (!fog && !is_decal && !eff_stencil && !ztest && !eff_atest && bilin && st->tex_alpha && bmode == 2) {
+                    if (!gouraud && mod_white) sw_tri_lin_add_mw(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+                    else if (!gouraud)         sw_tri_lin_add_flat(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+                    else                       sw_tri_lin_add_gouraud(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+                } else if (!fog && !is_decal && !eff_stencil && !ztest && !eff_atest && !bilin && st->tex_alpha && bmode == 2) {
+                    sw_tri_lin_near_add_gm(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2, gouraud, mod_white);
+                } else if (!fog && !is_decal && !eff_stencil && !ztest && !eff_atest && bilin && !st->tex_alpha && bmode == 2) {
+                    sw_tri_lin_add_noa_gm(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2, gouraud, mod_white);
+                } else if (!fog && !is_decal && !eff_stencil && !ztest && !eff_atest && !bilin && !st->tex_alpha && bmode == 2) {
+                    sw_tri_lin_near_add_noa_gm(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2, gouraud, mod_white);
+                } else if (!fog && !is_decal && !eff_stencil && !ztest && !eff_atest && st->tex_alpha && bmode == 3) {
+                    if (bilin) sw_tri_lin_add1_gm(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2, gouraud, mod_white);
+                    else       sw_tri_lin_near_add1_gm(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2, gouraud, mod_white);
