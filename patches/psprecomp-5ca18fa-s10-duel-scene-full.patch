+    get_quad(0x04, out);
+    CHECK_F(out[0], 1.0f, "vsrt1[0]"); CHECK_F(out[1], 3.0f, "vsrt1[1]");
+    CHECK_F(out[2], 2.0f, "vsrt1[2]"); CHECK_F(out[3], 4.0f, "vsrt1[3]");
+
+    psp_vsrt(PSP_VSRT4, 0x04, 0x00, 4);
+    get_quad(0x04, out);
+    CHECK_F(out[0], 3.0f, "vsrt4[0]"); CHECK_F(out[1], 4.0f, "vsrt4[1]");
+    CHECK_F(out[2], 1.0f, "vsrt4[2]"); CHECK_F(out[3], 2.0f, "vsrt4[3]");
+
+    psp_vsrt(PSP_VSRT3, 0x04, 0x00, 4);
+    get_quad(0x04, out);
+    CHECK_F(out[0], 3.0f, "vsrt3[0]"); CHECK_F(out[1], 1.0f, "vsrt3[1]");
+    CHECK_F(out[2], 4.0f, "vsrt3[2]"); CHECK_F(out[3], 2.0f, "vsrt3[3]");
+}
