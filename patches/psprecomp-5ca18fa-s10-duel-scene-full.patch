+static void test_bone_skinning(void) {
+    psp_ge_reset();
+    clear_fb();
+    g_pc = 0;
+    cmd(0x10, (VERTS >> 8) & 0xFF0000);
+    cmd(0x9C, FB & 0xFFFFFF);
+    cmd(0x9D, ((FB >> 8) & 0xFF0000) | 480);
+    cmd(0x12, 3u | (7u << 2) | (3u << 7) | (3u << 9));
+    cmd(0x01, VERTS & 0xFFFFFF);
+    fcmd(0x42, 240.0f);  fcmd(0x43, -136.0f);
+    fcmd(0x45, 2048.0f); fcmd(0x46, 2048.0f);
+    cmd(0x4C, (2048 - 240) << 4);
+    cmd(0x4D, (2048 - 136) << 4);
+    cmd(0x2A, 0);
+    const float bone0[12] = { 1, 0, 0,  0, 1, 0,  0, 0, 1,  0.25f, 0, 0 };
+    for (int k = 0; k < 12; k++) fcmd(0x2B, bone0[k]);
+    const float q[4][2] = { { -0.5f, 0.5f }, { 0.5f, 0.5f }, { -0.5f, -0.5f }, { 0.5f, -0.5f } };
+    for (int i = 0; i < 4; i++) {
+        uint32_t a = VERTS + (uint32_t)i * 28;
+        psp_write32(a + 0, fbits(1.0f));
+        psp_write32(a + 4, 0);
+        psp_write32(a + 8, 0);
+        psp_write32(a + 12, 0xFF00FF00u);
+        psp_write32(a + 16, fbits(q[i][0]));
+        psp_write32(a + 20, fbits(q[i][1]));
+        psp_write32(a + 24, 0);
+    }
+    cmd(0x04, (4u << 16) | 4);
+    end_list();
+    CHECK(pixel(185, 100) == 0x0000FF00u, "bone-skinned quad filled at translated x=185: 0x%08X", pixel(185, 100));
+    CHECK(pixel(150, 100) == 0, "bone-skinned quad moved past x=150: 0x%08X", pixel(150, 100));
+}
