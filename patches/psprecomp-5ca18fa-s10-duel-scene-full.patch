+
+static void hle_SavedataInitStart(void) {
+    uint32_t param = psp_arg(0);
+    if (g_active_dialog != DIALOG_NONE && g_save_dlg.status != UTIL_STATUS_NONE) {
+        psp_ret(ERR_UTIL_INVALID_STATUS);
+        return;
+    }
+    if (!param || (param & 3u)) { psp_ret(ERR_UTIL_INVALID_ADDRESS); return; }
+    uint32_t size = psp_read32(param + OFF_SIZE);
+    if (size != SAVEDATA_PARAM_SIZE && size != 1480u && size != 1500u && size != 1536u) {
+        psp_ret(ERR_UTIL_INVALID_PARAM_SIZE);
+        return;
+    }
+    g_active_dialog = DIALOG_SAVEDATA;
+    g_save_dlg.status = UTIL_STATUS_INITIALIZE;
+    g_save_dlg.param_addr = param;
+    g_save_dlg.param_size = size;
+    g_save_dlg.executed = 0;
+    psp_ret(0);
+}
+
+static void hle_SavedataGetStatus(void) {
+    if (g_active_dialog != DIALOG_SAVEDATA) {
+        psp_ret(ERR_UTIL_WRONG_TYPE);
+        return;
+    }
+    int cur = g_save_dlg.status;
+    if (cur == UTIL_STATUS_INITIALIZE) {
+        g_save_dlg.status = UTIL_STATUS_RUNNING;
+    } else if (cur == UTIL_STATUS_SHUTDOWN) {
+        g_save_dlg.status = UTIL_STATUS_NONE;
+    } else if (cur == UTIL_STATUS_NONE) {
+        g_active_dialog = DIALOG_NONE;
+    }
+    psp_ret((uint32_t)cur);
+}
+
+static void hle_SavedataUpdate(void) {
+    if (g_active_dialog != DIALOG_SAVEDATA) {
+        psp_ret(ERR_UTIL_WRONG_TYPE);
+        return;
+    }
+    if (g_save_dlg.status != UTIL_STATUS_RUNNING) {
+        psp_ret(ERR_UTIL_INVALID_STATUS);
+        return;
+    }
+    if (!g_save_dlg.executed) {
+        uint32_t res = execute_savedata(g_save_dlg.param_addr);
+        psp_write32(g_save_dlg.param_addr + OFF_RESULT, res);
+        g_save_dlg.executed = 1;
+    }
+    g_save_dlg.status = UTIL_STATUS_FINISHED;
+    psp_ret(0);
+}
+
+static void hle_SavedataShutdownStart(void) {
+    if (g_active_dialog != DIALOG_SAVEDATA) {
+        psp_ret(ERR_UTIL_WRONG_TYPE);
+        return;
+    }
+    g_save_dlg.status = UTIL_STATUS_SHUTDOWN;
+    psp_ret(0);
+}
+
+static void hle_MsgDialogInitStart(void) {
+    uint32_t param = psp_arg(0);
+    if (g_active_dialog != DIALOG_NONE && g_msg_dlg.status != UTIL_STATUS_NONE) {
+        psp_ret(ERR_UTIL_INVALID_STATUS);
+        return;
+    }
+    if (!param || (param & 3u)) { psp_ret(ERR_UTIL_INVALID_ADDRESS); return; }
+    uint32_t size = psp_read32(param + OFF_SIZE);
+    if (size != MSG_SIZE_V1 && size != MSG_SIZE_V2 && size != MSG_SIZE_V3) {
+        psp_ret(ERR_UTIL_INVALID_PARAM_SIZE);
+        return;
+    }
+
+    uint32_t type = psp_read32(param + MSG_OFF_TYPE);
+    uint32_t err  = psp_read32(param + MSG_OFF_ERRORNUM);
+    uint32_t opts = size >= MSG_SIZE_V2 ? psp_read32(param + MSG_OFF_OPTIONS) : 0u;
+    uint32_t res  = 0u;
+
+    if (type == 0u && !(err & 0x80000000u)) {
+        res = ERR_MSG_ERRORCODEINVALID;
+    } else if (size == MSG_SIZE_V3 && ((opts & ~MSG_OPT_SUPPORTED) != 0u ||
+               ((opts & MSG_OPT_DEFAULT_NO) && !(opts & MSG_OPT_YESNO)))) {
+        res = ERR_MSG_BADOPTION;
+    }
+
+    if (type == 1u) {
+        char msg[512];
+        read_guest_str(param + MSG_OFF_STRING, msg, sizeof msg);
+        fprintf(stderr, "sceUtilityMsgDialog: \"%s\"\n", msg);
+    } else {
+        fprintf(stderr, "sceUtilityMsgDialog: error 0x%08X\n", err);
+    }
+
+    psp_write32(param + OFF_RESULT, 0u);
+    psp_write32(param + MSG_OFF_RESULT, res);
+
+    g_active_dialog = DIALOG_MSG;
+    g_msg_dlg.status = UTIL_STATUS_INITIALIZE;
+    g_msg_dlg.param_addr = param;
+    g_msg_dlg.param_size = size;
+    g_msg_dlg.executed = (res != 0u);
+    psp_ret(0);
+}
+
+static void hle_MsgDialogGetStatus(void) {
+    if (g_active_dialog != DIALOG_MSG) {
+        psp_ret(ERR_UTIL_WRONG_TYPE);
+        return;
+    }
+    int cur = g_msg_dlg.status;
+    if (cur == UTIL_STATUS_INITIALIZE) {
+        g_msg_dlg.status = UTIL_STATUS_RUNNING;
+    } else if (cur == UTIL_STATUS_SHUTDOWN) {
+        g_msg_dlg.status = UTIL_STATUS_NONE;
+    } else if (cur == UTIL_STATUS_NONE) {
+        g_active_dialog = DIALOG_NONE;
+    }
+    psp_ret((uint32_t)cur);
+}
+
+static void hle_MsgDialogUpdate(void) {
+    if (g_active_dialog != DIALOG_MSG) {
+        psp_ret(ERR_UTIL_WRONG_TYPE);
+        return;
+    }
+    if (g_msg_dlg.status != UTIL_STATUS_RUNNING) {
+        psp_ret(ERR_UTIL_INVALID_STATUS);
+        return;
+    }
+    if (!g_msg_dlg.executed && g_msg_dlg.param_size >= MSG_SIZE_V2) {
+        uint32_t opts = psp_read32(g_msg_dlg.param_addr + MSG_OFF_OPTIONS);
+        uint32_t btn = MSG_BTN_NONE;
+        if (opts & (MSG_OPT_YESNO | MSG_OPT_OK)) {
+            btn = (opts & MSG_OPT_DEFAULT_NO) ? MSG_BTN_NO : MSG_BTN_YES;
+        }
+        psp_write32(g_msg_dlg.param_addr + MSG_OFF_BUTTON, btn);
+        psp_write32(g_msg_dlg.param_addr + MSG_OFF_RESULT, 0u);
+        g_msg_dlg.executed = 1;
+    }
+    g_msg_dlg.status = UTIL_STATUS_FINISHED;
+    psp_ret(0);
+}
+
+static void hle_MsgDialogShutdownStart(void) {
+    if (g_active_dialog != DIALOG_MSG) {
+        psp_ret(ERR_UTIL_WRONG_TYPE);
+        return;
+    }
+    g_msg_dlg.status = UTIL_STATUS_SHUTDOWN;
+    psp_ret(0);
+}
+
+static void hle_MsgDialogAbort(void) {
+    if (g_active_dialog != DIALOG_MSG || g_msg_dlg.status != UTIL_STATUS_RUNNING) {
+        psp_ret(ERR_UTIL_WRONG_TYPE);
+        return;
+    }
+    g_msg_dlg.status = UTIL_STATUS_FINISHED;
+    psp_ret(0);
+}
+
+void psp_savedata_register(void) {
+    psp_hle_register(0x50C4CD57, "sceUtility", "sceUtilitySavedataInitStart",     hle_SavedataInitStart);
+    psp_hle_register(0x8874DBE0, "sceUtility", "sceUtilitySavedataGetStatus",     hle_SavedataGetStatus);
+    psp_hle_register(0xD4B95FFB, "sceUtility", "sceUtilitySavedataUpdate",        hle_SavedataUpdate);
+    psp_hle_register(0x9790B33C, "sceUtility", "sceUtilitySavedataShutdownStart", hle_SavedataShutdownStart);
+
+    psp_hle_register(0x2AD8E239, "sceUtility", "sceUtilityMsgDialogInitStart",     hle_MsgDialogInitStart);
+    psp_hle_register(0x9A1C91D7, "sceUtility", "sceUtilityMsgDialogGetStatus",     hle_MsgDialogGetStatus);
+    psp_hle_register(0x95FC253B, "sceUtility", "sceUtilityMsgDialogUpdate",        hle_MsgDialogUpdate);
+    psp_hle_register(0x67AF3428, "sceUtility", "sceUtilityMsgDialogShutdownStart", hle_MsgDialogShutdownStart);
+    psp_hle_register(0x4928BD96, "sceUtility", "sceUtilityMsgDialogAbort",         hle_MsgDialogAbort);
+}
