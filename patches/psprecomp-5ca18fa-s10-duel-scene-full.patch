+static inline __attribute__((always_inline)) void sw_lin_bilin_span_fast(
+    uint8_t * restrict px_ptr, const uint32_t * restrict lin_tex,
+    int tex_w, int tex_h, int clamp_u, int clamp_v,
+    int64_t fu, int64_t fv, int64_t dfudx, int count,
+    uint32_t flat_col, int k_blend, int k_mod_white, int k_tex_alpha) {
+    const int64_t sv = fv - (1LL << 23);
+    const int y0 = (int)(sv >> 24);
+    int64_t su = fu - (1LL << 23);
+    const int64_t su_end = su + (int64_t)(count - 1) * dfudx;
+    const int x0_a = (int)(su >> 24);
+    const int x0_b = (int)(su_end >> 24);
+    const uint32_t wy0 = (unsigned)y0 < (unsigned)tex_h ? (uint32_t)y0 : (uint32_t)wrap(y0, tex_h, clamp_v);
+    const int pow2_wrap_u = !clamp_u && ((tex_w & (tex_w - 1)) == 0);
+    const uint32_t wmask = (uint32_t)(tex_w - 1);
+    if (dfudx == (1LL << 24) && (sv & 0xFFFFFFLL) < 0x80000LL && (su & 0xFFFFFFLL) < 0x80000LL) {
+        const uint32_t * restrict lin_y0 = lin_tex + wy0 * (uint32_t)tex_w;
+        if ((unsigned)x0_a < (unsigned)tex_w && (unsigned)x0_b < (unsigned)tex_w) {
+            sw_lin_span_1to1(px_ptr, lin_y0 + (uint32_t)x0_a, count, flat_col, k_blend, k_mod_white, k_tex_alpha);
+            return;
+        }
+        if (pow2_wrap_u) {
+            uint32_t wx = (uint32_t)x0_a & wmask;
+            int rem = count;
+            while (rem > 0) {
+                const int chunk = (rem <= tex_w - (int)wx) ? rem : (tex_w - (int)wx);
+                sw_lin_span_1to1(px_ptr, lin_y0 + wx, chunk, flat_col, k_blend, k_mod_white, k_tex_alpha);
+                px_ptr += chunk * 4;
+                rem -= chunk;
+                wx = 0;
+            }
+            return;
+        }
+    }
+    const int fy = (int)(((sv & 0xFFFFFFLL) + (1LL << 19)) >> 20);
+    const uint32_t wy1 = (unsigned)(y0 + 1) < (unsigned)tex_h ? (uint32_t)(y0 + 1) : (uint32_t)wrap(y0 + 1, tex_h, clamp_v);
+    const uint32_t * restrict lin_y0 = lin_tex + wy0 * (uint32_t)tex_w;
+    const uint32_t * restrict lin_y1 = lin_tex + wy1 * (uint32_t)tex_w;
+    if ((unsigned)x0_a < (unsigned)(tex_w - 1) && (unsigned)x0_b < (unsigned)(tex_w - 1)) {
+        sw_lin_bilin_inner(px_ptr, lin_y0, lin_y1, wmask, su, dfudx, fy, count,
+                           flat_col, k_blend, k_mod_white, k_tex_alpha, 0);
+        return;
+    }
+    if (pow2_wrap_u) {
+        sw_lin_bilin_inner(px_ptr, lin_y0, lin_y1, wmask, su, dfudx, fy, count,
+                           flat_col, k_blend, k_mod_white, k_tex_alpha, 1);
+        return;
+    }
+    int i = 0;
+    if (dfudx > 0 && count >= 4) {
+        for (; i < count && (int)(su >> 24) < 0; i++, px_ptr += 4, su += dfudx, fu += dfudx) {
+            uint32_t col = tex_lin_bilin_fp(lin_tex, tex_w, tex_h, clamp_u, clamp_v, fu, fv);
+            if (!k_tex_alpha) col |= 0xFF000000u;
+            if (!k_mod_white) col = swar_modulate(col, flat_col);
+            sw_tri_t8_write_ptr(NULL, px_ptr, col, k_blend, 0);
+        }
+        if (i < count && (int)(su >> 24) < tex_w - 1) {
+            const int64_t su_rem_end = su + (int64_t)(count - 1 - i) * dfudx;
+            int safe_n = ((int)(su_rem_end >> 24) < tex_w - 1)
+                ? (count - i)
+                : (1 + (int)((((int64_t)(tex_w - 1) << 24) - 1 - su) / dfudx));
+            if (safe_n > count - i) safe_n = count - i;
+            if (safe_n > 0) {
+                sw_lin_bilin_inner(px_ptr, lin_y0, lin_y1, wmask, su, dfudx, fy, safe_n,
+                                   flat_col, k_blend, k_mod_white, k_tex_alpha, 0);
+                px_ptr += safe_n * 4;
+                su += (int64_t)safe_n * dfudx;
+                fu = su + (1LL << 23);
+                i += safe_n;
+            }
+        }
+    }
+    for (; i < count; i++, px_ptr += 4, fu += dfudx) {
+        uint32_t col = tex_lin_bilin_fp(lin_tex, tex_w, tex_h, clamp_u, clamp_v, fu, fv);
+        if (!k_tex_alpha) col |= 0xFF000000u;
+        if (!k_mod_white) col = swar_modulate(col, flat_col);
+        sw_tri_t8_write_ptr(NULL, px_ptr, col, k_blend, 0);
+    }
+}
