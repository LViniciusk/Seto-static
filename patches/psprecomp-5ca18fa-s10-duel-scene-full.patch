+static void test_savedata_and_msgdialog(void) {
+    const uint32_t PARAM = 0x08950000u;
+    const uint32_t DBUF  = 0x08960000u;
+    const uint32_t AUX   = 0x08970000u;
+
+    psp_io_set_root("tmp_test_io");
+
+    /* Ensure clean starting state by deleting test slot if left over. */
+    zero_guest(PARAM, 1536);
+    psp_write32(PARAM + 0, 1536u);
+    psp_write32(PARAM + 48, 10u); /* DELETE */
+    write_gstr(PARAM + 60, "ULUS99999");
+    write_gstr(PARAM + 76, "DATA0");
+    run_savedata_op(PARAM);
+
+    /* 1. GETSIZE on non-existent directory -> RW_NO_DATA (0x80110327), free info populated. */
+    zero_guest(PARAM, 1536);
+    zero_guest(AUX, 256);
+    psp_write32(PARAM + 0, 1536u);
+    psp_write32(PARAM + 48, 22u); /* GETSIZE */
+    write_gstr(PARAM + 60, "ULUS99999");
+    write_gstr(PARAM + 76, "DATA0");
+    psp_write32(PARAM + 1532, AUX);
+    run_savedata_op(PARAM);
+    CHECK(psp_read32(PARAM + 28) == 0x80110327u, "GETSIZE missing save -> RW_NO_DATA");
+    CHECK(psp_read32(AUX + 16) == 32768u && psp_read32(AUX + 24) > 0u, "GETSIZE fills sectorSize & freeKB");
+
+    /* 2. AUTOLOAD missing save -> LOAD_NO_DATA (0x80110307). */
+    zero_guest(PARAM, 1536);
+    psp_write32(PARAM + 0, 1536u);
+    psp_write32(PARAM + 48, 0u); /* AUTOLOAD */
+    write_gstr(PARAM + 60, "ULUS99999");
+    write_gstr(PARAM + 76, "DATA0");
+    write_gstr(PARAM + 100, "DATA.BIN");
+    psp_write32(PARAM + 116, DBUF);
+    psp_write32(PARAM + 120, 4096u);
+    run_savedata_op(PARAM);
+    CHECK(psp_read32(PARAM + 28) == 0x80110307u, "AUTOLOAD missing save -> LOAD_NO_DATA");
+
+    /* 3. SAVE writes DATA.BIN + PARAM.SFO. */
+    zero_guest(DBUF, 4096);
+    psp_write32(DBUF + 0, 0x00010002u);
+    psp_write32(DBUF + 4, 0x12345678u);
+    zero_guest(PARAM, 1536);
+    psp_write32(PARAM + 0, 1536u);
+    psp_write32(PARAM + 48, 3u); /* SAVE */
+    write_gstr(PARAM + 60, "ULUS99999");
+    write_gstr(PARAM + 76, "DATA0");
+    write_gstr(PARAM + 100, "DATA.BIN");
+    psp_write32(PARAM + 116, DBUF);
+    psp_write32(PARAM + 120, 4096u);
+    psp_write32(PARAM + 124, 128u);
+    write_gstr(PARAM + 128, "Test Game");
+    write_gstr(PARAM + 256, "Save 0");
+    write_gstr(PARAM + 384, "Roundtrip check");
+    run_savedata_op(PARAM);
+    CHECK(psp_read32(PARAM + 28) == 0u, "SAVE succeeded");
+
+    /* 4. GETSIZE & SIZES on existing save -> 0. */
+    zero_guest(AUX, 256);
+    psp_write32(PARAM + 48, 22u);
+    psp_write32(PARAM + 1532, AUX);
+    run_savedata_op(PARAM);
+    CHECK(psp_read32(PARAM + 28) == 0u && psp_read32(AUX + 16) == 32768u, "GETSIZE existing -> 0");
+
+    /* 5. AUTOLOAD reads DATA.BIN + PARAM.SFO back accurately. */
+    zero_guest(DBUF, 4096);
+    zero_guest(PARAM + 128, 1280);
+    psp_write32(PARAM + 48, 0u);
+    psp_write32(PARAM + 124, 0u);
+    run_savedata_op(PARAM);
+    CHECK(psp_read32(PARAM + 28) == 0u && psp_read32(PARAM + 124) == 128u, "AUTOLOAD restored dataSize");
+    CHECK(psp_read32(DBUF + 0) == 0x00010002u && psp_read32(DBUF + 4) == 0x12345678u, "AUTOLOAD restored bytes");
+    CHECK(psp_read8(PARAM + 128) == 'T' && psp_read8(PARAM + 256) == 'S', "AUTOLOAD restored PARAM.SFO");
+
+    /* 6. LIST returns the matching directory. */
+    zero_guest(AUX, 512);
+    psp_write32(PARAM + 48, 11u);
+    write_gstr(PARAM + 76, "DATA*");
+    psp_write32(PARAM + 1524, AUX);
+    psp_write32(AUX + 0, 4u);
+    psp_write32(AUX + 8, AUX + 16);
+    run_savedata_op(PARAM);
+    CHECK(psp_read32(PARAM + 28) == 0u && psp_read32(AUX + 4) >= 1u, "LIST found saved slot");
+
+    /* 7. DELETE cleans up and subsequent AUTOLOAD returns LOAD_NO_DATA. */
+    psp_write32(PARAM + 48, 10u);
+    write_gstr(PARAM + 76, "DATA0");
+    run_savedata_op(PARAM);
+    CHECK(psp_read32(PARAM + 28) == 0u, "DELETE removed slot");
+    psp_write32(PARAM + 48, 0u);
+    run_savedata_op(PARAM);
+    CHECK(psp_read32(PARAM + 28) == 0x80110307u, "AUTOLOAD after DELETE -> LOAD_NO_DATA");
+
+    /* 8. MsgDialog lifecycle (V2 with YES/NO). */
+    zero_guest(PARAM, 580);
+    psp_write32(PARAM + 0, 580u);
+    psp_write32(PARAM + 52, 1u); /* message */
+    write_gstr(PARAM + 60, "Unit test prompt");
+    psp_write32(PARAM + 572, 0x10u); /* YES/NO */
+    CHECK(call(psp_nid("sceUtilityMsgDialogInitStart"), PARAM, 0, 0, 0) == 0, "msgdialog init ok");
+    CHECK(call(psp_nid("sceUtilityMsgDialogGetStatus"), 0, 0, 0, 0) == 1u, "msgdialog INIT");
+    CHECK(call(psp_nid("sceUtilityMsgDialogGetStatus"), 0, 0, 0, 0) == 2u, "msgdialog RUNNING");
+    CHECK(call(psp_nid("sceUtilityMsgDialogUpdate"), 1, 0, 0, 0) == 0, "msgdialog update ok");
+    CHECK(psp_read32(PARAM + 576) == 1u, "msgdialog YES selected");
+    CHECK(call(psp_nid("sceUtilityMsgDialogGetStatus"), 0, 0, 0, 0) == 3u, "msgdialog FINISHED");
+    CHECK(call(psp_nid("sceUtilityMsgDialogShutdownStart"), 0, 0, 0, 0) == 0, "msgdialog shutdown ok");
+    CHECK(call(psp_nid("sceUtilityMsgDialogGetStatus"), 0, 0, 0, 0) == 4u, "msgdialog SHUTDOWN");
+    CHECK(call(psp_nid("sceUtilityMsgDialogGetStatus"), 0, 0, 0, 0) == 0u, "msgdialog NONE after shutdown");
+    CHECK(call(psp_nid("sceUtilityMsgDialogGetStatus"), 0, 0, 0, 0) == 0x80110005u, "msgdialog WRONG_TYPE when idle");
+}
