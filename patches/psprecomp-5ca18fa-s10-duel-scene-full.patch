+static inline __attribute__((always_inline)) uint32_t tex_sample_clut_swz_bilin_fp(
+    const uint8_t * restrict tex, const uint32_t * restrict clut,
+    uint32_t blocks, int tex_w, int tex_h, int clamp_u, int clamp_v,
+    int64_t fu, int64_t fv, int k_is_t4) {
+    const int64_t su = fu - (1LL << 23), sv = fv - (1LL << 23);
+    const int x0 = (int)(su >> 24), y0 = (int)(sv >> 24);
+    const int fx = (int)(((su & 0xFFFFFFLL) + (1LL << 19)) >> 20);
+    const int fy = (int)(((sv & 0xFFFFFFLL) + (1LL << 19)) >> 20);
+    uint32_t c00, c10, c01, c11;
+    if ((unsigned)x0 < (unsigned)(tex_w - 1) && (unsigned)y0 < (unsigned)(tex_h - 1)) {
+        const uint32_t ux = (uint32_t)x0, uy = (uint32_t)y0;
+        const uint32_t block_mask = k_is_t4 ? 31u : 15u;
+        if ((ux & block_mask) != block_mask && (uy & 7u) != 7u) {
+            const uint8_t *p0 = tex + (((uy >> 3) * blocks + (k_is_t4 ? (ux >> 5) : (ux >> 4))) << 7) +
+                                ((uy & 7u) << 4) + (k_is_t4 ? ((ux >> 1) & 15u) : (ux & 15u));
+            const uint8_t *p1 = p0 + 16;
+            if (k_is_t4) {
+                if ((ux & 1u) == 0u) {
+                    const uint8_t b0 = p0[0], b1 = p1[0];
+                    c00 = clut[b0 & 0xFu]; c10 = clut[b0 >> 4];
+                    c01 = clut[b1 & 0xFu]; c11 = clut[b1 >> 4];
+                } else {
+                    c00 = clut[p0[0] >> 4]; c10 = clut[p0[1] & 0xFu];
+                    c01 = clut[p1[0] >> 4]; c11 = clut[p1[1] & 0xFu];
+                }
+            } else {
+                c00 = clut[p0[0]]; c10 = clut[p0[1]];
+                c01 = clut[p1[0]]; c11 = clut[p1[1]];
+            }
+        } else {
+            const uint8_t *r0 = tex_swz_row_ptr(tex, blocks, uy);
+            const uint8_t *r1 = tex_swz_row_ptr(tex, blocks, uy + 1u);
+            c00 = tex_swz_row_read(r0, ux, clut, k_is_t4);
+            c10 = tex_swz_row_read(r0, ux + 1u, clut, k_is_t4);
+            c01 = tex_swz_row_read(r1, ux, clut, k_is_t4);
+            c11 = tex_swz_row_read(r1, ux + 1u, clut, k_is_t4);
+        }
+    } else {
+        const uint32_t wx0 = (uint32_t)wrap(x0, tex_w, clamp_u);
+        const uint32_t wx1 = (uint32_t)wrap(x0 + 1, tex_w, clamp_u);
+        const uint8_t *r0 = tex_swz_row_ptr(tex, blocks, (uint32_t)wrap(y0, tex_h, clamp_v));
+        const uint8_t *r1 = tex_swz_row_ptr(tex, blocks, (uint32_t)wrap(y0 + 1, tex_h, clamp_v));
+        c00 = tex_swz_row_read(r0, wx0, clut, k_is_t4);
+        c10 = tex_swz_row_read(r0, wx1, clut, k_is_t4);
+        c01 = tex_swz_row_read(r1, wx0, clut, k_is_t4);
+        c11 = tex_swz_row_read(r1, wx1, clut, k_is_t4);
+    }
+    return bilinear_mix(c00, c10, c01, c11, fx, fy);
+}
+
+static inline __attribute__((always_inline)) uint32_t tex_sample_clut_swz_near_fp(
+    const uint8_t * restrict tex, const uint32_t * restrict clut,
+    uint32_t blocks, int tex_w, int tex_h, int clamp_u, int clamp_v,
+    int64_t fu, int64_t fv, int k_is_t4) {
+    int x = (int)(fu >> 24), y = (int)(fv >> 24);
+    if ((unsigned)x >= (unsigned)tex_w) x = wrap(x, tex_w, clamp_u);
+    if ((unsigned)y >= (unsigned)tex_h) y = wrap(y, tex_h, clamp_v);
+    return tex_swz_row_read(tex_swz_row_ptr(tex, blocks, (uint32_t)y), (uint32_t)x, clut, k_is_t4);
+}
+
+static inline __attribute__((always_inline)) uint32_t tex_lin_bilin_fp(
+    const uint32_t * restrict tex, int tex_w, int tex_h, int clamp_u, int clamp_v,
+    int64_t fu, int64_t fv) {
+    const int64_t su = fu - (1LL << 23), sv = fv - (1LL << 23);
+    const int x0 = (int)(su >> 24), y0 = (int)(sv >> 24);
+    const int fx = (int)(((su & 0xFFFFFFLL) + (1LL << 19)) >> 20);
+    const int fy = (int)(((sv & 0xFFFFFFLL) + (1LL << 19)) >> 20);
+    if ((unsigned)x0 < (unsigned)(tex_w - 1) && (unsigned)y0 < (unsigned)(tex_h - 1)) {
+        const uint32_t * restrict r0 = tex + (uint32_t)y0 * (uint32_t)tex_w + (uint32_t)x0;
+        const uint32_t * restrict r1 = r0 + (uint32_t)tex_w;
+        return bilinear_mix_row2(r0, r1, fx, fy);
+    }
+    const int wx0 = wrap(x0, tex_w, clamp_u), wx1 = wrap(x0 + 1, tex_w, clamp_u);
+    const uint32_t * restrict r0 = tex + (uint32_t)wrap(y0, tex_h, clamp_v) * (uint32_t)tex_w;
+    const uint32_t * restrict r1 = tex + (uint32_t)wrap(y0 + 1, tex_h, clamp_v) * (uint32_t)tex_w;
+    return bilinear_mix(r0[wx0], r0[wx1], r1[wx0], r1[wx1], fx, fy);
+}
+
+static inline __attribute__((always_inline)) uint32_t tex_lin_near_fp(
+    const uint32_t * restrict tex, int tex_w, int tex_h, int clamp_u, int clamp_v,
+    int64_t fu, int64_t fv) {
+    int x = (int)(fu >> 24), y = (int)(fv >> 24);
+    if ((unsigned)x >= (unsigned)tex_w) x = wrap(x, tex_w, clamp_u);
+    if ((unsigned)y >= (unsigned)tex_h) y = wrap(y, tex_h, clamp_v);
+    return tex[(uint32_t)y * (uint32_t)tex_w + (uint32_t)x];
+}
