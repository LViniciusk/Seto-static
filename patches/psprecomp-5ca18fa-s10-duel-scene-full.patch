diff --git a/src/hle/atrac.c b/src/hle/atrac.c
new file mode 100644
index 0000000..2d76123
--- /dev/null
+++ b/src/hle/atrac.c
@@ -0,0 +1,303 @@
+/* psprecomp -- sceAtrac3plus (RIFF/WAVE ATRAC3 & ATRAC3+ metadata & PCM frame pacing).
+ *
+ * Parses RIFF/WAVE fmt, fact, smpl, and data headers matching PPSSPP
+ * Core/HLE/sceAtrac.cpp so games querying sample counts, loop bounds, max
+ * samples per frame, and decode completion receive hardware-accurate values
+ * and end-of-stream termination. Audio decode outputs silent 16-bit PCM while
+ * advancing sample position and honoring loop counts.
+ */
+
+#include "psprecomp/hle.h"
+
+#include <string.h>
+
+#define MAX_ATRAC_IDS 6
+
+#define SCE_ERROR_ATRAC_NO_ATRACID        0x80630003u
+#define SCE_ERROR_ATRAC_BAD_ATRACID       0x80630005u
+#define SCE_ERROR_ATRAC_UNKNOWN_FORMAT    0x80630006u
+#define SCE_ERROR_ATRAC_INVALID_SIZE      0x80630010u
+#define SCE_ERROR_ATRAC_BAD_SAMPLE        0x80630015u
+#define SCE_ERROR_ATRAC_NO_LOOP_INFO      0x80630021u
+#define SCE_ERROR_ATRAC_ALL_DATA_DECODED  0x80630024u
+
+#define WAVE_FORMAT_ATRAC3     0x0270u
+#define WAVE_FORMAT_ATRAC3PLUS 0xFFFEu
+
+typedef struct {
+    int      used;
+    uint16_t channels;
+    uint16_t bytes_per_frame;
+    uint32_t samples_per_frame;
+    uint32_t current_sample;
+    uint32_t end_sample;
+    int32_t  loop_start;
+    int32_t  loop_end;
+    int32_t  loop_num;
+    int      finished;
+} atrac_slot;
+
+static atrac_slot g_atrac[MAX_ATRAC_IDS];
+
+void psp_atrac_reset(void) {
+    memset(g_atrac, 0, sizeof g_atrac);
+}
+
+void psp_atrac_init(void) { psp_atrac_reset(); }
+
+static atrac_slot *get_slot(int id) {
+    if (id < 0 || id >= MAX_ATRAC_IDS || !g_atrac[id].used) return NULL;
+    return &g_atrac[id];
+}
+
+/* 0x132F1ECA sceAtracReinit(int numAT3PlusIds, int numAT3Ids) */
+static void hle_AtracReinit(void) {
+    psp_atrac_reset();
+    psp_ret(0);
+}
+
+/* 0x7A20E7AF sceAtracSetDataAndGetID(void *buf, SceSize bufSize) */
+static void hle_AtracSetDataAndGetID(void) {
+    const uint32_t buf  = psp_arg(0);
+    const uint32_t size = psp_arg(1);
+    if (!buf || size < 44u) {
+        psp_ret(SCE_ERROR_ATRAC_INVALID_SIZE);
+        return;
+    }
+
+    /* RIFF .... WAVE */
+    if (psp_read32(buf + 0) != 0x46464952u || psp_read32(buf + 8) != 0x45564157u) {
+        psp_ret(SCE_ERROR_ATRAC_UNKNOWN_FORMAT);
+        return;
+    }
+
+    int      have_fmt = 0;
+    uint16_t channels = 2;
+    uint16_t bpf = 0;
+    uint32_t spf = 0;
+    uint32_t fact_samples = 0;
+    uint32_t fact_offset = 0;
+    uint32_t data_size = 0;
+    int32_t  loop_start = -1;
+    int32_t  loop_end = -1;
+
+    uint32_t pos = 12;
+    while (pos + 8u <= size) {
+        const uint32_t cid  = psp_read32(buf + pos);
+        const uint32_t csz  = psp_read32(buf + pos + 4);
+        const uint32_t pay  = buf + pos + 8u;
+        const uint32_t avail = size - (pos + 8u);
+        const uint32_t len  = csz < avail ? csz : avail;
+
+        if (cid == 0x20746D66u && len >= 16u) {          /* "fmt " */
+            const uint16_t tag = psp_read16(pay + 0);
+            channels = psp_read16(pay + 2);
+            if (channels == 0 || channels > 2) channels = 2;
+            bpf = psp_read16(pay + 12);
+            if (tag == WAVE_FORMAT_ATRAC3) {
+                spf = 1024u;
+                have_fmt = 1;
+            } else if (tag == WAVE_FORMAT_ATRAC3PLUS) {
+                spf = 2048u;
+                have_fmt = 1;
+            }
+        } else if (cid == 0x74636166u && len >= 4u) {    /* "fact" */
+            fact_samples = psp_read32(pay + 0);
+            if (len >= 8u) fact_offset = psp_read32(pay + 4);
+        } else if (cid == 0x6C706D73u && len >= 60u) {   /* "smpl" */
+            const uint32_t nloops = psp_read32(pay + 28);
+            if (nloops > 0) {
+                loop_start = (int32_t)psp_read32(pay + 36 + 8);
+                loop_end   = (int32_t)psp_read32(pay + 36 + 12);
+            }
+        } else if (cid == 0x61746164u) {                 /* "data" */
+            data_size = csz;
+        }
+
+        const uint64_t next = (uint64_t)pos + 8ull + (((uint64_t)csz + 1ull) & ~1ull);
+        if (next <= pos || next > size) break;
+        pos = (uint32_t)next;
+    }
+
+    if (!have_fmt) {
+        psp_ret(SCE_ERROR_ATRAC_UNKNOWN_FORMAT);
+        return;
+    }
+
+    int id = -1;
+    for (int i = 0; i < MAX_ATRAC_IDS; i++) {
+        if (!g_atrac[i].used) { id = i; break; }
+    }
+    if (id < 0) {
+        psp_ret(SCE_ERROR_ATRAC_NO_ATRACID);
+        return;
+    }
+
+    uint32_t end_sample = fact_samples;
+    if (end_sample == 0 && bpf > 0)
+        end_sample = (data_size / bpf) * spf;
+    if (end_sample == 0)
+        end_sample = spf;
+
+    /* Adjust smpl loop points by ATRAC encoder delay (fact[1]), keeping 0-based inclusive indices. */
+    if (loop_start >= 0) {
+        if (fact_offset > 0) {
+            loop_start -= (int32_t)fact_offset;
+            loop_end   -= (int32_t)fact_offset;
+            if (loop_start < 0) loop_start = 0;
+            if (loop_end < 0) loop_end = 0;
+        }
+        if (loop_end >= (int32_t)end_sample)
+            loop_end = (int32_t)end_sample - 1;
+    }
+
+    atrac_slot *s = &g_atrac[id];
+    memset(s, 0, sizeof *s);
+    s->used = 1;
+    s->channels = channels;
+    s->bytes_per_frame = bpf;
+    s->samples_per_frame = spf;
+    s->current_sample = 0;
+    s->end_sample = end_sample;
+    s->loop_start = loop_start;
+    s->loop_end = loop_end;
+    s->loop_num = 0;
+    s->finished = 0;
+
+    psp_ret((uint32_t)id);
+}
+
+/* 0x61EB33F5 sceAtracReleaseAtracID(int atracID) */
+static void hle_AtracReleaseAtracID(void) {
+    atrac_slot *s = get_slot((int)psp_arg(0));
+    if (!s) { psp_ret(SCE_ERROR_ATRAC_BAD_ATRACID); return; }
+    s->used = 0;
+    psp_ret(0);
+}
+
+/* 0xD6A5F2F7 sceAtracGetMaxSample(int atracID, int *outMax) */
+static void hle_AtracGetMaxSample(void) {
+    atrac_slot *s = get_slot((int)psp_arg(0));
+    if (!s) { psp_ret(SCE_ERROR_ATRAC_BAD_ATRACID); return; }
+    const uint32_t out = psp_arg(1);
+    if (out) psp_write32(out, s->samples_per_frame);
+    psp_ret(0);
+}
+
+/* 0xA2BBA8BE sceAtracGetSoundSample(int id, int *endSample, int *loopStart, int *loopEnd) */
+static void hle_AtracGetSoundSample(void) {
+    atrac_slot *s = get_slot((int)psp_arg(0));
+    if (!s) { psp_ret(SCE_ERROR_ATRAC_BAD_ATRACID); return; }
+    const uint32_t p_end = psp_arg(1);
+    const uint32_t p_ls  = psp_arg(2);
+    const uint32_t p_le  = psp_arg(3);
+    if (p_end) psp_write32(p_end, s->end_sample > 0 ? s->end_sample - 1u : 0u);
+    if (p_ls)  psp_write32(p_ls,  (uint32_t)s->loop_start);
+    if (p_le)  psp_write32(p_le,  (uint32_t)s->loop_end);
+    psp_ret(0);
+}
+
+/* 0x868120B5 sceAtracSetLoopNum(int atracID, int nloops) */
+static void hle_AtracSetLoopNum(void) {
+    atrac_slot *s = get_slot((int)psp_arg(0));
+    const int32_t nloops = (int32_t)psp_arg(1);
+    if (!s) { psp_ret(SCE_ERROR_ATRAC_BAD_ATRACID); return; }
+    if (s->loop_start < 0 && nloops != 0) {
+        psp_ret(SCE_ERROR_ATRAC_NO_LOOP_INFO);
+        return;
+    }
+    s->loop_num = nloops;
+    psp_ret(0);
+}
+
+/* 0x644E5607 sceAtracResetPlayPosition(int atracID, u32 sample, u32 wr1, u32 wr2) */
+static void hle_AtracResetPlayPosition(void) {
+    atrac_slot *s = get_slot((int)psp_arg(0));
+    const uint32_t sample = psp_arg(1);
+    if (!s) { psp_ret(SCE_ERROR_ATRAC_BAD_ATRACID); return; }
+    if (sample >= s->end_sample) { psp_ret(SCE_ERROR_ATRAC_BAD_SAMPLE); return; }
+    s->current_sample = sample;
+    s->finished = 0;
+    psp_ret(0);
+}
+
+/* 0xFAA4F89B sceAtracGetLoopStatus(int atracID, int *loopNum, u32 *status) */
+static void hle_AtracGetLoopStatus(void) {
+    atrac_slot *s = get_slot((int)psp_arg(0));
+    if (!s) { psp_ret(SCE_ERROR_ATRAC_BAD_ATRACID); return; }
+    const uint32_t p_num    = psp_arg(1);
+    const uint32_t p_status = psp_arg(2);
+    if (p_num) psp_write32(p_num, (uint32_t)s->loop_num);
+    if (p_status) psp_write32(p_status, (s->loop_start >= 0 && s->loop_num != 0) ? 1u : 0u);
+    psp_ret(0);
+}
+
+/* 0x6A8C3CD5 sceAtracDecodeData(int id, u16 *outSamples, int *outNum, int *outEnd, int *outRemainFrame) */
+static void hle_AtracDecodeData(void) {
+    atrac_slot *s = get_slot((int)psp_arg(0));
+    const uint32_t out_buf    = psp_arg(1);
+    const uint32_t out_num    = psp_arg(2);
+    const uint32_t out_end    = psp_arg(3);
+    const uint32_t out_remain = psp_arg(4);
+    if (!s) { psp_ret(SCE_ERROR_ATRAC_BAD_ATRACID); return; }
+
+    if (s->finished) {
+        if (out_num)    psp_write32(out_num, 0);
+        if (out_end)    psp_write32(out_end, 1);
+        if (out_remain) psp_write32(out_remain, 0);
+        /* Avoid busy-loop starvation if a polling audio thread keeps decoding past EOF. */
+        psp_threadman_yield();
+        psp_ret(SCE_ERROR_ATRAC_ALL_DATA_DECODED);
+        return;
+    }
+
+    uint32_t limit = s->end_sample;
+    const int looping = (s->loop_num != 0 && s->loop_start >= 0 && s->loop_end >= s->loop_start);
+    if (looping && (uint32_t)s->loop_end + 1u < limit)
+        limit = (uint32_t)s->loop_end + 1u;
+
+    uint32_t avail = limit > s->current_sample ? limit - s->current_sample : 0;
+    uint32_t n = s->samples_per_frame < avail ? s->samples_per_frame : avail;
+
+    if (out_buf && n > 0) {
+        const uint32_t bytes = n * s->channels * 2u;
+        for (uint32_t i = 0; i < bytes; i += 4u) {
+            if (i + 4u <= bytes) psp_write32(out_buf + i, 0);
+            else for (uint32_t j = i; j < bytes; j++) psp_write8(out_buf + j, 0);
+        }
+    }
+
+    s->current_sample += n;
+    int end_flag = 0;
+    if (s->current_sample >= limit) {
+        if (looping) {
+            if (s->loop_num > 0) s->loop_num--;
+            s->current_sample = (uint32_t)s->loop_start;
+        } else {
+            s->finished = 1;
+            end_flag = 1;
+        }
+    }
+
+    if (out_num) psp_write32(out_num, n);
+    if (out_end) psp_write32(out_end, (uint32_t)end_flag);
+    if (out_remain) {
+        uint32_t rem = 0;
+        if (!end_flag && s->end_sample > s->current_sample)
+            rem = (s->end_sample - s->current_sample + s->samples_per_frame - 1u) / s->samples_per_frame;
+        psp_write32(out_remain, rem);
+    }
+    psp_ret(0);
+}
+
+void psp_atrac_register(void) {
+    psp_hle_register(0x132F1ECA, "sceAtrac3plus", "sceAtracReinit",             hle_AtracReinit);
+    psp_hle_register(0x7A20E7AF, "sceAtrac3plus", "sceAtracSetDataAndGetID",    hle_AtracSetDataAndGetID);
+    psp_hle_register(0x61EB33F5, "sceAtrac3plus", "sceAtracReleaseAtracID",     hle_AtracReleaseAtracID);
+    psp_hle_register(0xD6A5F2F7, "sceAtrac3plus", "sceAtracGetMaxSample",       hle_AtracGetMaxSample);
+    psp_hle_register(0xA2BBA8BE, "sceAtrac3plus", "sceAtracGetSoundSample",     hle_AtracGetSoundSample);
+    psp_hle_register(0x868120B5, "sceAtrac3plus", "sceAtracSetLoopNum",         hle_AtracSetLoopNum);
+    psp_hle_register(0x644E5607, "sceAtrac3plus", "sceAtracResetPlayPosition",  hle_AtracResetPlayPosition);
+    psp_hle_register(0xFAA4F89B, "sceAtrac3plus", "sceAtracGetLoopStatus",      hle_AtracGetLoopStatus);
+    psp_hle_register(0x6A8C3CD5, "sceAtrac3plus", "sceAtracDecodeData",         hle_AtracDecodeData);
+}
