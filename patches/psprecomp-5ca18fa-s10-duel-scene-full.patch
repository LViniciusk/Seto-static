+static void test_dmac_rtc_stat_async_ef_fpl(void) {
+    /* 1. sceDmacMemcpy (incl. overlap + SRAM/RAM->VRAM copy). */
+    psp_mem_bad_access = 0;
+    const uint32_t SRC = 0x08910000u, DST = 0x08910040u;
+    for (uint32_t i = 0; i < 64u; i++) psp_write8(SRC + i, (uint8_t)(i ^ 0x5Au));
+    CHECK(call(psp_nid("sceDmacMemcpy"), DST, SRC, 64u, 0) == 0, "sceDmacMemcpy returns 0");
+    CHECK(psp_read8(DST + 0) == (0 ^ 0x5Au) && psp_read8(DST + 63) == (63 ^ 0x5Au),
+          "sceDmacMemcpy copies bytes");
+    CHECK(call(psp_nid("sceDmacMemcpy"), 0x04088000u, SRC, 64u, 0) == 0, "sceDmacMemcpy to VRAM");
+    CHECK(psp_read8(0x04088000u + 17) == (17 ^ 0x5Au), "sceDmacMemcpy to upper VRAM");
+    CHECK(call(psp_nid("sceDmacMemcpy"), SRC + 16u, SRC, 32u, 0) == 0, "sceDmacMemcpy overlap");
+    CHECK(psp_read8(SRC + 16u + 31u) == (31 ^ 0x5Au), "sceDmacMemcpy overlap preserves source");
+
+    /* 2. sceRtcGetCurrentClockLocalTime. */
+    const uint32_t TM = 0x08910200u;
+    zero_guest(TM, 16u);
+    CHECK(call(psp_nid("sceRtcGetCurrentClockLocalTime"), TM, 0, 0, 0) == 0, "localtime ok");
+    uint16_t year = psp_read16(TM + 0), mon = psp_read16(TM + 2), day = psp_read16(TM + 4);
+    CHECK(year >= 2020u && mon >= 1u && mon <= 12u && day >= 1u && day <= 31u,
+          "localtime reasonable date (%u-%02u-%02u)", year, mon, day);
+
+    /* 3. sceUtilityGetSystemParamString. */
+    const uint32_t STR = 0x08910240u;
+    zero_guest(STR, 32u);
+    CHECK(call(psp_nid("sceUtilityGetSystemParamString"), 1u, STR, 32u, 0) == 0, "sysparam nickname ok");
+    CHECK(psp_read8(STR) != 0, "sysparam nickname non-empty");
+    CHECK(call(psp_nid("sceUtilityGetSystemParamString"), 999u, STR, 32u, 0) == 0x80110103u,
+          "sysparam bad id returns error");
+
+    /* 4. sceIoOpenAsync / sceIoReadAsync / sceIoWaitAsyncCB / sceIoGetstat. */
+    psp_io_reset();
+    TEST_MKDIR("hle_io_test");
+    TEST_MKDIR("hle_io_test/ms");
+    psp_io_set_root("hle_io_test");
+    const uint32_t PATH = 0x08910300u, IOBUF = 0x08910400u, RES = 0x08910500u, ST = 0x08910520u;
+    write_gstr(PATH, "ms0:/async_probe.bin");
+    /* Create file synchronously, write 5 bytes, close, then stat + async read. */
+    uint32_t wfd = call(psp_nid("sceIoOpen"), PATH, 0x0602u /*CREAT|TRUNC|WRONLY*/, 0777u, 0);
+    CHECK((int32_t)wfd >= 3, "open for write ok (%d)", (int32_t)wfd);
+    for (uint32_t i = 0; i < 5u; i++) psp_write8(IOBUF + i, (uint8_t)('A' + i));
+    CHECK(call(psp_nid("sceIoWrite"), wfd, IOBUF, 5u, 0) == 5u, "write 5 bytes ok");
+    CHECK(call(psp_nid("sceIoClose"), wfd, 0, 0, 0) == 0, "close write fd ok");
+
+    zero_guest(ST, 88u);
+    CHECK(call(psp_nid("sceIoGetstat"), PATH, ST, 0, 0) == 0, "sceIoGetstat ok");
+    CHECK(psp_read32(ST + 8u) == 5u && psp_read32(ST + 12u) == 0u, "sceIoGetstat st_size == 5");
+
+    uint32_t afd = call(psp_nid("sceIoOpenAsync"), PATH, 0x0001u, 0, 0);
+    CHECK((int32_t)afd >= 3, "sceIoOpenAsync fd >= 3");
+    zero_guest(RES, 8u);
+    CHECK(call(psp_nid("sceIoWaitAsyncCB"), afd, RES, 0, 0) == 0, "WaitAsyncCB after open ok");
+    CHECK(psp_read32(RES) == afd, "WaitAsyncCB open res == fd");
+    zero_guest(IOBUF, 16u);
+    CHECK(call(psp_nid("sceIoReadAsync"), afd, IOBUF, 5u, 0) == 0, "sceIoReadAsync queued == 0");
+    zero_guest(RES, 8u);
+    CHECK(call(psp_nid("sceIoWaitAsyncCB"), afd, RES, 0, 0) == 0, "WaitAsyncCB after read ok");
