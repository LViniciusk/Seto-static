+static void sw_tri_stencil_mask_only(const psp_vertex *a, const psp_vertex *b, const psp_vertex *c,
+                                     const psp_draw_state * restrict st, int minx, int maxx, int miny, int maxy,
+                                     int area, float h0, float h1, float h2) {
+    uint8_t * restrict fb_base = g_fb_span.data + (uint32_t)(g_fb_addr - g_fb_span.addr);
+    const int have_z = st->zaddr && st->zbw > 0;
+    const int ztest = st->ztest && have_z && g_z_span.data != NULL;
+    const int zwrite = ztest && st->zwrite;
+    uint8_t * restrict z_base = ztest ? (g_z_span.data + (uint32_t)(st->zaddr - g_z_span.addr)) : NULL;
+    const uint32_t fb_stride = g_fb_stride;
+    const int dy0 = b->y - a->y, dy1 = c->y - b->y, dy2 = a->y - c->y;
+    const double inv_d = 1.0 / (double)area;
+    const float dzdx = ztest ? (float)((-(double)dy1 * a->z - (double)dy2 * b->z - (double)dy0 * c->z) * inv_d) : 0.0f;
+    const int sref = st->stencil_ref;
+    const int smask = st->stencil_mask;
+    const int sfunc = st->stencil_func;
+    const int sfail = st->stencil_fail;
+    const int szfail = st->stencil_zfail;
+    const int szpass = st->stencil_zpass;
+    const int zfunc = st->zfunc;
+    uint64_t px_drawn = 0;
+
+    for (int y = miny; y <= maxy; y++) {
+        int xs, xe, w0, w1, w2;
+        if (!tri_row_span(a, b, c, area, minx, maxx, y, &xs, &xe, &w0, &w1, &w2)) continue;
+        px_drawn += (uint64_t)(xe - xs + 1);
+        uint8_t * restrict px_ptr = fb_base + ((uint32_t)(y * (int)fb_stride) + (uint32_t)xs) * 4u;
+        const uint32_t z_row_off = ztest ? (uint32_t)(y * st->zbw) : 0u;
+        float zf = 0.0f;
+        if (ztest) {
+            const double la = ((double)w1 + (double)h1) * inv_d;
+            const double lb = ((double)w2 + (double)h2) * inv_d;
+            const double lc = ((double)w0 + (double)h0) * inv_d;
+            zf = (float)(a->z * la + b->z * lb + c->z * lc);
+        }
+        for (int x = xs; x <= xe; x++, px_ptr += 4, zf += dzdx) {
+            int stencil = (int)px_ptr[3];
+            if (!depth_pass(sfunc, sref & smask, stencil & smask)) {
+                px_ptr[3] = (uint8_t)stencil_op(sfail, stencil, sref);
+                continue;
+            }
+            if (ztest) {
+                const int zv = zf < 0.0f ? 0 : (zf > 65535.0f ? 65535 : (int)(zf + 0.5f));
+                uint16_t zd;
+                memcpy(&zd, z_base + (z_row_off + (uint32_t)x) * 2u, 2);
+                if (!depth_pass(zfunc, zv, zd)) {
+                    px_ptr[3] = (uint8_t)stencil_op(szfail, stencil, sref);
+                    continue;
+                }
+                if (zwrite) {
+                    const uint16_t zw = (uint16_t)zv;
+                    memcpy(z_base + (z_row_off + (uint32_t)x) * 2u, &zw, 2);
+                }
+            }
+            px_ptr[3] = (uint8_t)stencil_op(szpass, stencil, sref);
+        }
+    }
+    g_pixels += px_drawn;
+}
