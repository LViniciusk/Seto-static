+static inline __attribute__((always_inline)) __m128i bilinear_mix_2px_16_sse2(
+    __m128i r0a, __m128i r0b, __m128i r1a, __m128i r1b,
+    __m128i fx01, __m128i fy16) {
+    const __m128i zero = _mm_setzero_si128();
+    const __m128i c128 = _mm_set1_epi16(128);
+    const __m128i t0 = _mm_unpacklo_epi32(r0a, r0b);
+    const __m128i t1 = _mm_unpacklo_epi32(r1a, r1b);
+    const __m128i v00 = _mm_unpacklo_epi8(t0, zero);
+    const __m128i v10 = _mm_unpackhi_epi8(t0, zero);
+    const __m128i v01 = _mm_unpacklo_epi8(t1, zero);
+    const __m128i v11 = _mm_unpackhi_epi8(t1, zero);
+    const __m128i top = _mm_add_epi16(_mm_slli_epi16(v00, 4), _mm_mullo_epi16(_mm_sub_epi16(v10, v00), fx01));
+    const __m128i bot = _mm_add_epi16(_mm_slli_epi16(v01, 4), _mm_mullo_epi16(_mm_sub_epi16(v11, v01), fx01));
+    const __m128i res = _mm_add_epi16(_mm_add_epi16(_mm_slli_epi16(top, 4), c128),
+                                      _mm_mullo_epi16(_mm_sub_epi16(bot, top), fy16));
+    return _mm_srli_epi16(res, 8);
+}
