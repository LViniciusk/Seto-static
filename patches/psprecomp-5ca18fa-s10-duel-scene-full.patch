+static void sw_sprite_solid_8888(int x0, int y0, int x1, int y1, uint32_t col, int bmode) {
+    uint8_t * restrict fb_base = g_fb_span.data + (uint32_t)(g_fb_addr - g_fb_span.addr);
+    const uint32_t fb_stride = g_fb_stride;
+    const uint32_t al = bmode ? A(col) : 255u;
+    g_pixels += (uint64_t)(x1 - x0) * (uint64_t)(y1 - y0);
+    if (bmode == 1 && al == 0u) return;
+    if (bmode == 2 && al == 0u) return;
+    if (bmode == 3 || (bmode == 2 && al == 255u)) {
+#ifdef __SSE2__
+        const __m128i src4 = _mm_set1_epi32((int)(col & 0x00FFFFFFu));
+#endif
+        for (int y = y0; y < y1; y++) {
+            uint8_t * restrict p = fb_base + ((uint32_t)(y * (int)fb_stride) + (uint32_t)x0) * 4u;
+            int x = x0;
+#ifdef __SSE2__
+            for (; x + 4 <= x1; x += 4, p += 16) {
+                _mm_storeu_si128((__m128i *)p, _mm_adds_epu8(_mm_loadu_si128((const __m128i *)p), src4));
+            }
+#endif
+            for (; x < x1; x++, p += 4) {
+                uint32_t dst;
+                memcpy(&dst, p, 4);
+                uint32_t c = swar_add_one(col, dst);
+                dst = (c & 0x00FFFFFFu) | (dst & 0xFF000000u);
+                memcpy(p, &dst, 4);
+            }
+        }
+        return;
+    }
+    if (bmode == 2) {
+        const uint32_t rb_s = (col & 0x00FF00FFu) * al + 0x00800080u;
+        const uint32_t rb_sc = ((rb_s + ((rb_s >> 8) & 0x00FF00FFu)) >> 8) & 0x00FF00FFu;
+        const uint32_t g_s = ((col >> 8) & 0xFFu) * al + 128u;
+        const uint32_t g_sc = (((g_s + (g_s >> 8)) >> 8) << 8) & 0x0000FF00u;
+        const uint32_t scaled = rb_sc | g_sc;
+#ifdef __SSE2__
+        const __m128i scaled4 = _mm_set1_epi32((int)scaled);
+#endif
+        for (int y = y0; y < y1; y++) {
+            uint8_t * restrict p = fb_base + ((uint32_t)(y * (int)fb_stride) + (uint32_t)x0) * 4u;
+            int x = x0;
+#ifdef __SSE2__
+            for (; x + 4 <= x1; x += 4, p += 16) {
+                _mm_storeu_si128((__m128i *)p, _mm_adds_epu8(_mm_loadu_si128((const __m128i *)p), scaled4));
+            }
+#endif
+            for (; x < x1; x++, p += 4) {
+                uint32_t dst;
+                memcpy(&dst, p, 4);
+                uint32_t c = swar_add_one(scaled, dst);
+                dst = (c & 0x00FFFFFFu) | (dst & 0xFF000000u);
+                memcpy(p, &dst, 4);
+            }
+        }
+        return;
+    }
+    if (al == 255u) {
+        const uint32_t rgb = col & 0x00FFFFFFu;
+#ifdef __SSE2__
+        const __m128i rgb4 = _mm_set1_epi32((int)rgb);
+        const __m128i amask = _mm_set1_epi32((int)0xFF000000u);
+#endif
+        for (int y = y0; y < y1; y++) {
+            uint8_t * restrict p = fb_base + ((uint32_t)(y * (int)fb_stride) + (uint32_t)x0) * 4u;
+            int x = x0;
+#ifdef __SSE2__
+            for (; x + 4 <= x1; x += 4, p += 16) {
+                __m128i d4 = _mm_loadu_si128((const __m128i *)p);
+                _mm_storeu_si128((__m128i *)p, _mm_or_si128(rgb4, _mm_and_si128(d4, amask)));
+            }
+#endif
+            for (; x < x1; x++, p += 4) {
+                uint32_t dst;
+                memcpy(&dst, p, 4);
+                dst = rgb | (dst & 0xFF000000u);
+                memcpy(p, &dst, 4);
+            }
+        }
+        return;
+    }
+    const uint32_t inv_a = 255u - al;
+    const uint32_t rb_s = (col & 0x00FF00FFu) * al + 0x00800080u;
+    const uint32_t rb_sc = ((rb_s + ((rb_s >> 8) & 0x00FF00FFu)) >> 8) & 0x00FF00FFu;
+    const uint32_t g_s = ((col >> 8) & 0xFFu) * al + 128u;
+    const uint32_t g_sc = (g_s + (g_s >> 8)) >> 8;
+#ifdef __SSE2__
+    const __m128i zero = _mm_setzero_si128();
+    const __m128i amask = _mm_set1_epi32((int)0xFF000000u);
+    const __m128i inv_a16 = _mm_set1_epi16((int16_t)inv_a);
+    const __m128i c128 = _mm_set1_epi16(128);
+    const uint32_t scaled_px = (rb_sc & 0x00FF00FFu) | ((g_sc << 8) & 0x0000FF00u);
+    const __m128i src_sc16 = _mm_unpacklo_epi8(_mm_set1_epi32((int)scaled_px), zero);
+#endif
+    for (int y = y0; y < y1; y++) {
+        uint8_t * restrict p = fb_base + ((uint32_t)(y * (int)fb_stride) + (uint32_t)x0) * 4u;
+        int x = x0;
+#ifdef __SSE2__
+        for (; x + 4 <= x1; x += 4, p += 16) {
+            __m128i d4 = _mm_loadu_si128((const __m128i *)p);
+            __m128i d_lo = _mm_unpacklo_epi8(d4, zero);
+            __m128i d_hi = _mm_unpackhi_epi8(d4, zero);
+            d_lo = _mm_add_epi16(_mm_mullo_epi16(d_lo, inv_a16), c128);
+            d_lo = _mm_add_epi16(src_sc16, _mm_srli_epi16(_mm_add_epi16(d_lo, _mm_srli_epi16(d_lo, 8)), 8));
+            d_hi = _mm_add_epi16(_mm_mullo_epi16(d_hi, inv_a16), c128);
+            d_hi = _mm_add_epi16(src_sc16, _mm_srli_epi16(_mm_add_epi16(d_hi, _mm_srli_epi16(d_hi, 8)), 8));
+            __m128i out4 = _mm_packus_epi16(d_lo, d_hi);
+            out4 = _mm_or_si128(_mm_andnot_si128(amask, out4), _mm_and_si128(d4, amask));
+            _mm_storeu_si128((__m128i *)p, out4);
+        }
+#endif
+        for (; x < x1; x++, p += 4) {
+            uint32_t dst;
+            memcpy(&dst, p, 4);
+            const uint32_t rb_d = (dst & 0x00FF00FFu) * inv_a + 0x00800080u;
+            const uint32_t rb = rb_sc + (((rb_d + ((rb_d >> 8) & 0x00FF00FFu)) >> 8) & 0x00FF00FFu);
+            const uint32_t g_d = ((dst >> 8) & 0xFFu) * inv_a + 128u;
+            const uint32_t g = (g_sc + ((g_d + (g_d >> 8)) >> 8)) << 8;
+            dst = (rb & 0x00FF00FFu) | (g & 0x0000FF00u) | (dst & 0xFF000000u);
+            memcpy(p, &dst, 4);
+        }
+    }
+}
+
+static void sw_sprite_simple(int x0, int y0, int x1, int y1,
+                             const psp_vertex *a, const psp_vertex *b,
+                             const psp_draw_state *st, float du, float dv) {
+    const int have_z = st->zaddr && st->zbw > 0;
+    const int ztest = st->ztest && have_z && g_z_span.data != NULL;
+    const int eff_stencil = effective_stencil(st, ztest);
+    const int eff_atest = effective_atest(st);
+    const int bmode = fast_blend_mode(st);
+    const int std_blend = (bmode == 1);
+    if (!st->tex_enable && !eff_stencil && !ztest && g_fb_fmt == 3 && bmode >= 0) {
+        if (eff_atest && !alpha_pass(st, b->rgba)) return;
+        sw_sprite_solid_8888(x0, y0, x1, y1, b->rgba, bmode);
+        return;
+    }
+    const int mod_white = st->tex_enable && !st->tex_double && st->tex_func == 0 && b->rgba == 0xFFFFFFFFu;
+    const float u_lim = 1e6f;
+    const int use_fp = st->tex_enable && a->u > -u_lim && a->u < u_lim && b->u > -u_lim && b->u < u_lim &&
+                       a->v > -u_lim && a->v < u_lim && b->v > -u_lim && b->v < u_lim;
+    const int bilin = (st->tex_filter & 0x101) != 0;
+    const int is_t4 = st->tex_fmt == PSP_TPSM_T4;
+    const int swz_fmt = (use_fp && g_tex_base && (st->tex_fmt == PSP_TPSM_T8 || is_t4) && g_clut_fast &&
+        st->tex_swizzle && st->tex_bw >= st->tex_w && g_tex_rowb >= 16u && st->tex_w > 0 && st->tex_h > 0)
+        ? (is_t4 ? 2 : 1) : 0;
+    const int st_z_ok = fast_stencil_z_ok(st, eff_stencil, ztest, st->zwrite);
+    const uint32_t *lin = (st_z_ok && use_fp && g_fb_fmt == 3 && bmode >= 0)
+        ? sw_tex_resolve_linear(st) : NULL;
+    if (lin) {
+        if (!eff_stencil && !ztest && !eff_atest && bmode == 0) {
+            if (bilin) sw_sprite_lin_op_bilin(x0, y0, x1, y1, a, b, st, du, dv, mod_white);
+            else       sw_sprite_lin_op_near(x0, y0, x1, y1, a, b, st, du, dv, mod_white);
+        } else if (!eff_stencil && !ztest && !eff_atest && bmode == 1) {
+            if (bilin) sw_sprite_lin_bl_bilin(x0, y0, x1, y1, a, b, st, du, dv, mod_white);
+            else       sw_sprite_lin_bl_near(x0, y0, x1, y1, a, b, st, du, dv, mod_white);
+        } else if (!eff_stencil && !ztest && !eff_atest && bmode == 2 && bilin) {
+            sw_sprite_lin_add_bilin(x0, y0, x1, y1, a, b, st, du, dv, mod_white);
+        } else if (!eff_stencil && !ztest && eff_atest && bmode == 0) {
+            if (bilin) sw_sprite_lin_op_at_bilin(x0, y0, x1, y1, a, b, st, du, dv, mod_white);
+            else       sw_sprite_lin_op_at_near(x0, y0, x1, y1, a, b, st, du, dv, mod_white);
+        } else if (!eff_stencil && !ztest && eff_atest && bmode == 1) {
+            if (bilin) sw_sprite_lin_bl_at_bilin(x0, y0, x1, y1, a, b, st, du, dv, mod_white);
+            else       sw_sprite_lin_bl_at_near(x0, y0, x1, y1, a, b, st, du, dv, mod_white);
+        } else {
+            sw_sprite_swz_fn(x0, y0, x1, y1, a, b, st, du, dv,
+                             3, bmode, eff_stencil, ztest, ztest && st->zwrite, eff_atest, bilin, mod_white);
+        }
+        return;
+    }
+    if (swz_fmt == 1 && bilin && !ztest && !eff_atest && g_fb_fmt == 3 && std_blend) {
+        if (!eff_stencil) {
+            if (mod_white) sw_sprite_simple_kernel(x0, y0, x1, y1, a, b, st, du, dv, 1, 1, 0, 1, 1, 0, 0, 0, 1);
+            else           sw_sprite_simple_kernel(x0, y0, x1, y1, a, b, st, du, dv, 1, 1, 0, 1, 0, 0, 0, 0, 1);
+        } else {
+            sw_sprite_simple_kernel(x0, y0, x1, y1, a, b, st, du, dv, 1, 1, 1, 1, mod_white, 0, 0, 0, 1);
+        }
+        return;
+    }
+    if (swz_fmt && st_z_ok && g_fb_fmt == 3 && bmode >= 0) {
+        sw_sprite_swz_fn(x0, y0, x1, y1, a, b, st, du, dv,
+                         swz_fmt, bmode, eff_stencil, ztest, ztest && st->zwrite, eff_atest, bilin, mod_white);
+        return;
+    }
+    sw_sprite_simple_kernel(x0, y0, x1, y1, a, b, st, du, dv, 0, 0, eff_stencil, 0, mod_white, 0, 0, 0, 1);
+}
+
+static void sw_sprite(const psp_vertex *a, const psp_vertex *b, const psp_draw_state *st) {
+    int x0 = a->x < b->x ? a->x : b->x, x1 = a->x > b->x ? a->x : b->x;
+    int y0 = a->y < b->y ? a->y : b->y, y1 = a->y > b->y ? a->y : b->y;
+    if (x0 == x1 || y0 == y1) return;
+    const float du = (b->u - a->u) / (float)(b->x - a->x);
+    const float dv = (b->v - a->v) / (float)(b->y - a->y);
+    if (x0 < 0) x0 = 0;
+    if (y0 < 0) y0 = 0;
+    if (x1 > 480) x1 = 480;
+    if (y1 > 272) y1 = 272;
+    if (x0 < st->sc_x0) x0 = st->sc_x0;
+    if (y0 < st->sc_y0) y0 = st->sc_y0;
+    if (st->sc_x1 < x1 - 1) x1 = st->sc_x1 + 1;
+    if (st->sc_y1 < y1 - 1) y1 = st->sc_y1 + 1;
+    if (st->reg_enable) {
