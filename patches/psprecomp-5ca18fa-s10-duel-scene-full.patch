+static inline __attribute__((always_inline)) void sw_lin_near_span_fast(
+    uint8_t * restrict px_ptr, const uint32_t * restrict lin_tex,
+    int tex_w, int tex_h, int clamp_u, int clamp_v,
+    int64_t fu, int64_t fv, int64_t dfudx, int count,
+    uint32_t flat_col, int k_blend, int k_mod_white, int k_tex_alpha) {
+    const int y0 = (int)(fv >> 24);
+    const int64_t fu_end = fu + (int64_t)(count - 1) * dfudx;
+    const int x0_a = (int)(fu >> 24);
+    const int x0_b = (int)(fu_end >> 24);
+    const uint32_t wy0 = (unsigned)y0 < (unsigned)tex_h ? (uint32_t)y0 : (uint32_t)wrap(y0, tex_h, clamp_v);
+    const uint32_t * restrict lin_y0 = lin_tex + wy0 * (uint32_t)tex_w;
+    const int pow2_wrap_u = !clamp_u && ((tex_w & (tex_w - 1)) == 0);
+    const uint32_t wmask = (uint32_t)(tex_w - 1);
+    if (dfudx == (1LL << 24)) {
+        if ((unsigned)x0_a < (unsigned)tex_w && (unsigned)x0_b < (unsigned)tex_w) {
+            sw_lin_span_1to1(px_ptr, lin_y0 + (uint32_t)x0_a, count, flat_col, k_blend, k_mod_white, k_tex_alpha);
+            return;
+        }
+        if (pow2_wrap_u) {
+            uint32_t wx = (uint32_t)x0_a & wmask;
+            int rem = count;
+            while (rem > 0) {
+                const int chunk = (rem <= tex_w - (int)wx) ? rem : (tex_w - (int)wx);
+                sw_lin_span_1to1(px_ptr, lin_y0 + wx, chunk, flat_col, k_blend, k_mod_white, k_tex_alpha);
+                px_ptr += chunk * 4;
+                rem -= chunk;
+                wx = 0;
+            }
+            return;
+        }
+    }
+    const int inbounds = (unsigned)x0_a < (unsigned)tex_w && (unsigned)x0_b < (unsigned)tex_w;
+    if (inbounds || pow2_wrap_u) {
+        int i = 0;
+#ifdef __SSE2__
+        const __m128i zero = _mm_setzero_si128();
+        const __m128i flat_lo = !k_mod_white ? _mm_unpacklo_epi8(_mm_set1_epi32((int)flat_col), zero) : zero;
+        for (; i + 4 <= count; i += 4, px_ptr += 16) {
+            const uint32_t ux0 = inbounds ? (uint32_t)(fu >> 24) : ((uint32_t)(fu >> 24) & wmask);
+            fu += dfudx;
+            const uint32_t ux1 = inbounds ? (uint32_t)(fu >> 24) : ((uint32_t)(fu >> 24) & wmask);
+            fu += dfudx;
+            const uint32_t ux2 = inbounds ? (uint32_t)(fu >> 24) : ((uint32_t)(fu >> 24) & wmask);
+            fu += dfudx;
+            const uint32_t ux3 = inbounds ? (uint32_t)(fu >> 24) : ((uint32_t)(fu >> 24) & wmask);
+            fu += dfudx;
+            const __m128i s4 = _mm_set_epi32((int)lin_y0[ux3], (int)lin_y0[ux2], (int)lin_y0[ux1], (int)lin_y0[ux0]);
+            sw_store_4px_sse2(px_ptr, s4, flat_lo, k_blend, k_mod_white, k_tex_alpha);
+        }
+#endif
+        for (; i < count; i++, px_ptr += 4, fu += dfudx) {
+            const uint32_t ux = inbounds ? (uint32_t)(fu >> 24) : ((uint32_t)(fu >> 24) & wmask);
+            uint32_t col = lin_y0[ux];
+            if (!k_tex_alpha) col |= 0xFF000000u;
+            if (!k_mod_white) col = swar_modulate(col, flat_col);
+            sw_tri_t8_write_ptr(NULL, px_ptr, col, k_blend, 0);
+        }
+        return;
+    }
+    for (int i = 0; i < count; i++, px_ptr += 4, fu += dfudx) {
+        uint32_t col = tex_lin_near_fp(lin_tex, tex_w, tex_h, clamp_u, clamp_v, fu, fv);
+        if (!k_tex_alpha) col |= 0xFF000000u;
+        if (!k_mod_white) col = swar_modulate(col, flat_col);
+        sw_tri_t8_write_ptr(NULL, px_ptr, col, k_blend, 0);
+    }
+}
