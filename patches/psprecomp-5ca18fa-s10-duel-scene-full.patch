+static void test_points_lines_and_narrow_swizzle(void) {
+    /* PSP_PRIM_POINTS (0) */
+    psp_ge_reset();
+    clear_fb();
+    begin_list();
+    vertex(0, 10, 10, 0xFF0000FFu);
+    vertex(1, 20, 15, 0xFF00FF00u);
+    cmd(0x04, (0u << 16) | 2);
+    end_list();
+    CHECK(psp_ge_pixels() == 2, "points pixel count: %llu", (unsigned long long)psp_ge_pixels());
+    CHECK(pixel(10, 10) == 0x000000FFu && pixel(20, 15) == 0x0000FF00u,
+          "points pixels: %08X %08X", pixel(10, 10), pixel(20, 15));
+
+    /* PSP_PRIM_LINES (1) and PSP_PRIM_LINE_STRIP (2) */
+    psp_ge_reset();
+    clear_fb();
+    begin_list();
+    vertex(0, 30, 10, 0xFF0000FFu);
+    vertex(1, 34, 10, 0xFF0000FFu);
+    vertex(2, 40, 10, 0xFF00FF00u);
+    vertex(3, 40, 13, 0xFF00FF00u);
+    cmd(0x04, (1u << 16) | 4);
+    vertex(4, 50, 20, 0xFFFF0000u);
+    vertex(5, 53, 20, 0xFFFF0000u);
+    vertex(6, 53, 23, 0xFFFF0000u);
+    cmd(0x01, (VERTS + 4u * 12u) & 0xFFFFFF);
+    cmd(0x04, (2u << 16) | 3);
+    end_list();
+    CHECK(pixel(32, 10) == 0x000000FFu && pixel(35, 10) == 0,
+          "lines horizontal: %08X next=%08X", pixel(32, 10), pixel(35, 10));
+    CHECK(pixel(40, 12) == 0x0000FF00u && pixel(40, 14) == 0,
+          "lines vertical: %08X next=%08X", pixel(40, 12), pixel(40, 14));
+    CHECK(pixel(51, 20) == 0x00FF0000u && pixel(53, 22) == 0x00FF0000u && pixel(54, 20) == 0,
+          "line strip: %08X %08X out=%08X", pixel(51, 20), pixel(53, 22), pixel(54, 20));
+
+    /* Narrow swizzled T8 texture (tex_bw = 8 -> rowb = 8 < 16 -> blocks = 1):
+     * row 1 col 3 lives at byte 1*16+3 = 19, while row 9 col 3 lives at
+     * ((9>>3)*1)*128 + 1*16 + 3 = 147. Before clamping blocks >= 1 both mapped
+     * to block 0 (offset 19). */
+    psp_ge_reset();
+    clear_fb();
+    for (int i = 0; i < 256; i++) psp_write8(TEX + (uint32_t)i, 0);
+    psp_write8(TEX + 19, 1);
+    psp_write8(TEX + 147, 2);
+    psp_write32(CLUT + 0, 0xFF000000u);
+    psp_write32(CLUT + 4, 0xFF00FF00u);  /* 1 = green */
+    psp_write32(CLUT + 8, 0xFF0000FFu);  /* 2 = red */
+    begin_tex_list(5, 3, 4, 1);          /* T8, 8x16, swizzle */
+    cmd(0xB0, CLUT & 0xFFFFFF);
+    cmd(0xB1, (CLUT >> 8) & 0xF0000);
+    cmd(0xC5, (0xFFu << 8) | 3);         /* CMODE 8888, mask FF */
+    cmd(0xC4, 1);                        /* CLOAD 1 block = 8 entries */
+    tvertex(0, 0, 0, 0, 0, 0xFFFFFFFFu);
+    tvertex(1, 8, 16, 8, 16, 0xFFFFFFFFu);
+    cmd(0x04, (6u << 16) | 2);
+    end_list();
+    CHECK(pixel(3, 1) == 0x0000FF00u && pixel(3, 9) == 0x000000FFu,
+          "narrow swizzle T8: (3,1)=0x%08X (3,9)=0x%08X", pixel(3, 1), pixel(3, 9));
+}
+
+/* Pin specialized T8-swizzled bilinear triangle & sprite fast paths (SSE2,
+ * row-hoisted dfvdx==0, stencil) against the scalar fragment_clipped oracle. */
+static void test_t8_swizzle_bilinear_fast_oracle(void) {
+    static uint32_t fast_fb[64 * 64];
+    for (int i = 0; i < 256; i++)
+        psp_write32(CLUT + (uint32_t)i * 4u, 0x80000000u | ((uint32_t)i * 0x010101u));
+    for (int i = 0; i < 64 * 64; i++)
+        psp_write8(TEX + (uint32_t)i, (uint8_t)((i * 37 + (i >> 6) * 19) & 255));
+
+    for (int mode = 0; mode < 3; mode++) {
+        const int use_stencil = (mode == 1);
+        const int use_sprite = (mode == 2);
+        for (int pass = 0; pass < 2; pass++) {
+            const int oracle = pass;
+            psp_ge_reset();
+            for (int y = 0; y < 64; y++)
+                for (int x = 0; x < 64; x++)
+                    psp_write32(FB + (uint32_t)(y * 512 + x) * 4u, 0x40102030u);
+
+            begin_list();
+            cmd(0x9C, FB & 0xFFFFFF); cmd(0x9D, ((FB >> 8) & 0xFF0000) | 512);
+            cmd(0xD2, 3);
+            cmd(0xD4, 0); cmd(0xD5, (63u << 10) | 63u);
+            cmd(0x1E, 1);
+            cmd(0xC3, 5);                /* T8 */
+            cmd(0xB8, (6u << 8) | 6u);   /* 64x64 */
+            cmd(0xA0, TEX & 0xFFFFFF); cmd(0xA8, ((TEX >> 8) & 0xFF0000) | 64);
+            cmd(0xC2, 1);                /* swizzle */
+            cmd(0xC6, 0x0101);           /* bilinear */
+            cmd(0xC7, 0x0101);           /* clamp */
+            cmd(0xC9, 0x0100);           /* modulate + tex_alpha */
+            cmd(0xB0, CLUT & 0xFFFFFF); cmd(0xB1, (CLUT >> 8) & 0xFF0000);
+            cmd(0xC5, (0xFFu << 8) | 3u);
+            cmd(0xC4, 32);
+            cmd(0x21, 1); cmd(0xDF, 0x000032);
+            cmd(0x50, use_sprite ? 0u : 1u);
+            cmd(0x24, use_stencil ? 1u : 0u);
+            if (use_stencil) {
+                cmd(0xDC, (0xFFu << 16) | (0x80u << 8) | 1u);
+                cmd(0xDD, (1u << 16) | (1u << 8) | 1u);
+            }
+            if (oracle) {
+                cmd(0x28, 1); cmd(0xE6, 3); /* logic_enable=1 COPY forces fragment_clipped */
+            }
+            cmd(0x12, VTYPE_TEX);
+            cmd(0x10, (VERTS >> 8) & 0xFF0000);
+            cmd(0x01, VERTS & 0xFFFFFF);
+            if (use_sprite) {
+                tvertex(0, 2, 2, 0, 0, 0xFFE0C0A0u);
+                tvertex(1, 58, 56, 63, 63, 0xFFE0C0A0u);
+                cmd(0x04, (6u << 16) | 2u);
+            } else {
+                tvertex(0, 0, 0, 0, 0, 0xFFFFFFFFu);
+                tvertex(1, 60, 0, 63, 0, 0xE0C0FFE0u);
+                tvertex(2, 0, 60, 0, 63, 0xD0FFA0D0u);
+                tvertex(3, 60, 60, 63, 63, 0xA0B0C0D0u);
+                cmd(0x04, (4u << 16) | 4u);
+            }
+            end_list();
+
+            if (!oracle) {
+                for (int y = 0; y < 64; y++)
+                    for (int x = 0; x < 64; x++)
+                        fast_fb[y * 64 + x] = pixel(x, y);
+            } else {
+                int bad = 0, maxd = 0;
+                for (int y = 0; y < 64; y++) {
+                    for (int x = 0; x < 64; x++) {
+                        uint32_t pf = fast_fb[y * 64 + x];
+                        uint32_t po = pixel(x, y);
+                        if (use_stencil && (pf >> 24) != (po >> 24)) bad++;
+                        for (int s = 0; s < 24; s += 8) {
+                            int d = (int)((pf >> s) & 255) - (int)((po >> s) & 255);
+                            if (d < 0) d = -d;
+                            if (d > maxd) maxd = d;
+                        }
+                    }
+                }
+                CHECK(bad == 0 && maxd <= 1,
+                      "T8 swizzle fast vs oracle mode=%d: stencil_bad=%d max_chan_diff=%d",
+                      mode, bad, maxd);
+            }
+        }
+    }
 }
 
