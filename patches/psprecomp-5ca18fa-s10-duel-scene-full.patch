+/* Barycentric fill with integer edge functions, so a shared edge belongs to
+ * exactly one triangle: adjacent geometry neither double-draws nor leaves
+ * seams. Both windings are accepted — back-face culling is not implemented, and
+ * rejecting one winding would silently drop half of any real model. Colour is
+ * interpolated when the shade model is Gouraud; flat uses the last vertex. */
+static void sw_tri(const psp_vertex *a, const psp_vertex *b, const psp_vertex *c,
+                   const psp_draw_state *st) {
+    int minx = a->x < b->x ? (a->x < c->x ? a->x : c->x) : (b->x < c->x ? b->x : c->x);
+    int maxx = a->x > b->x ? (a->x > c->x ? a->x : c->x) : (b->x > c->x ? b->x : c->x);
+    int miny = a->y < b->y ? (a->y < c->y ? a->y : c->y) : (b->y < c->y ? b->y : c->y);
+    int maxy = a->y > b->y ? (a->y > c->y ? a->y : c->y) : (b->y > c->y ? b->y : c->y);
+
+    if (a->behind || b->behind || c->behind) return;   /* ponytail: no near-plane clipping */
+    if (minx < 0) minx = 0;
+    if (miny < 0) miny = 0;
+    if (maxx > 479) maxx = 479;
+    if (maxy > 271) maxy = 271;
+    if (minx < st->sc_x0) minx = st->sc_x0;
+    if (miny < st->sc_y0) miny = st->sc_y0;
+    if (maxx > st->sc_x1) maxx = st->sc_x1;
+    if (maxy > st->sc_y1) maxy = st->sc_y1;
+    if (st->reg_enable) {
+        if (minx < st->reg_x0) minx = st->reg_x0;
+        if (miny < st->reg_y0) miny = st->reg_y0;
+        if (maxx > st->reg_x1) maxx = st->reg_x1;
+        if (maxy > st->reg_y1) maxy = st->reg_y1;
+    }
+    if (minx > maxx || miny > maxy) return;
+
+    const int area = edge(a, b, c->x, c->y);
+    if (area == 0) return;
+    if (st->cull_enable && !st->clear) {
+        /* GE_CULL_CW (0) culls screen-CW (area > 0); GE_CULL_CCW (1) culls CCW (area < 0). */
+        if (st->cull_face ? (area <= 0) : (area >= 0)) return;
+    }
+    const float inv = 1.0f / (float)area;
+    const float h0 = 0.5f * (float)((b->x - a->x) - (b->y - a->y));
+    const float h1 = 0.5f * (float)((c->x - b->x) - (c->y - b->y));
+    const float h2 = 0.5f * (float)((a->x - c->x) - (a->y - c->y));
+    const int dy0 = b->y - a->y, dy1 = c->y - b->y, dy2 = a->y - c->y;
+    const int raw_gouraud = st->gouraud;
+    const int gouraud = raw_gouraud && (a->rgba != b->rgba || b->rgba != c->rgba);
+    const int has_spec = raw_gouraud && st->lmode && ((a->spec | b->spec | c->spec) & 0x00FFFFFFu);
+    const uint32_t flat_col = c->rgba, flat_spc = c->spec;
+
+    const int have_z = st->zaddr && st->zbw > 0;
+    const int eff_atest = effective_atest(st);
+    const int raw_fog = st->fog_enable && !st->through;
+    const int fog = raw_fog && !(a->fog >= 1.0f && b->fog >= 1.0f && c->fog >= 1.0f);
+    const int mask_atest_ok = !eff_atest ||
+        (!gouraud) ||
+        (st->atest_func == 6 && st->atest_mask == 0xFF && st->atest_ref == 0 &&
+         A(a->rgba) > 0u && A(b->rgba) > 0u && A(c->rgba) > 0u);
+    if (g_fb_span.data && g_fb_fmt == 3 && !st->clear && !st->tex_enable && !st->ctest &&
+        mask_atest_ok && !st->logic_enable && !fog && st->stencil &&
+        (st->write_mask & 0x00FFFFFFu) == 0x00FFFFFFu && (st->write_mask & 0xFF000000u) == 0u &&
+        !zrange_needed(a, b, c, st) && (!st->ztest || !have_z || g_z_span.data)) {
+        if (eff_atest && !gouraud && !alpha_pass(st, flat_col)) return;
+        sw_tri_stencil_mask_only(a, b, c, st, minx, maxx, miny, maxy, area, h0, h1, h2);
+        return;
+    }
+    const int simple_pipe = g_fb_span.data && !st->clear &&
+        !st->ctest && (!st->stencil || g_fb_fmt == 3) && !st->logic_enable &&
+        (st->write_mask & 0x00FFFFFFu) == 0 && (!st->stencil || st->write_mask == 0) &&
+        (!st->ztest || !have_z || g_z_span.data) &&
+        !(raw_gouraud ? has_spec : ((flat_spc & 0x00FFFFFFu) != 0));
+
+    if (simple_pipe && !st->tex_enable && !eff_atest && !st->blend && !st->stencil) {
+        if (sw_tri_opaque(a, b, c, st, minx, maxx, miny, maxy, area, inv, h0, h1, h2, gouraud, fog)) {
+            return;
+        }
+    }
+    if (simple_pipe && st->tex_enable && !st->blend && !eff_atest && !st->stencil) {
+        if (sw_tri_tex(a, b, c, st, minx, maxx, miny, maxy, area, inv, h0, h1, h2, gouraud, fog))
+            return;
+    }
+    if (simple_pipe && (eff_atest || st->blend || st->stencil)) {
+        if (sw_tri_tex_ab(a, b, c, st, minx, maxx, miny, maxy, area, inv, h0, h1, h2, gouraud, fog))
+            return;
+    }
+
+    for (int y = miny; y <= maxy; y++) {
+        int w0 = edge(a, b, minx, y);   /* weight of c */
+        int w1 = edge(b, c, minx, y);   /* weight of a */
+        int w2 = edge(c, a, minx, y);   /* weight of b */
+        int entered = 0;
+        for (int x = minx; x <= maxx; x++, w0 -= dy0, w1 -= dy1, w2 -= dy2) {
+            if (!((w0 >= 0 && w1 >= 0 && w2 >= 0) || (w0 <= 0 && w1 <= 0 && w2 <= 0))) {
