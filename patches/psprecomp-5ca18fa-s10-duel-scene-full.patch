+static void test_ctest_fog_logic_trx_tgen(void) {
+    /* 1. Color test + logic op */
+    psp_ge_reset();
+    clear_fb();
+    begin_list();
+    cmd(0x27, 1); cmd(0xD8, 2);                    /* CTE=1, CTST=EQUAL */
+    cmd(0xD9, 0x00112233u); cmd(0xDA, 0x00FFFFFFu);
+    vertex(0, 0, 0, 0xFF112233u); vertex(1, 4, 4, 0xFF112233u);
+    cmd(0x04, (6u << 16) | 2);
+    vertex(2, 4, 0, 0xFF445566u); vertex(3, 8, 4, 0xFF445566u);
+    cmd(0x01, (VERTS + 24) & 0xFFFFFFu);
+    cmd(0x04, (6u << 16) | 2);
+    end_list();
+    CHECK(pixel(2, 2) == 0x00112233u, "COLORTEST EQUAL kept matching pixel: 0x%08X", pixel(2, 2));
+    CHECK(pixel(6, 2) == 0u, "COLORTEST EQUAL rejected mismatching pixel: 0x%08X", pixel(6, 2));
+
+    /* LogicOp XOR against (0x00112233) with (0x00FF00FF) -> 0x00EE22CC */
+    begin_list();
+    cmd(0x27, 0);
+    cmd(0x28, 1); cmd(0xE6, 6);                    /* LOE=1, LOP=XOR */
+    vertex(0, 0, 0, 0xFFFF00FFu); vertex(1, 4, 4, 0xFFFF00FFu);
+    cmd(0x04, (6u << 16) | 2);
+    end_list();
+    CHECK(pixel(2, 2) == 0x00EE22CCu, "LOGICOP XOR produced 0x%08X, want 0x00EE22CC", pixel(2, 2));
+
+    /* 2. Block transfer (32-bit copy from TEX RAM to FB at (10,10), stride 480) */
+    psp_ge_reset();
+    clear_fb();
+    const uint32_t TRX_SRC = 0x08B00000u;
+    psp_write32(TRX_SRC + 0, 0xFF00AABBu);
+    psp_write32(TRX_SRC + 4, 0xFFCCDD00u);
+    begin_list();
+    cmd(0xB2, TRX_SRC & 0xFFFFFFu); cmd(0xB3, ((TRX_SRC >> 8) & 0xFF0000u) | 2u);
+    cmd(0xB4, FB & 0xFFFFFFu);      cmd(0xB5, ((FB >> 8) & 0xFF0000u) | 480u);
+    cmd(0xEB, 0);                   cmd(0xEC, (10u << 10) | 10u);
+    cmd(0xEE, (0u << 10) | 1u);     /* 2x1 pixels */
+    cmd(0xEA, 1);                   /* 32-bit transfer */
+    end_list();
+    CHECK(pixel(10, 10) == 0xFF00AABBu && pixel(11, 10) == 0xFFCCDD00u,
+          "TRXKICK 32-bit copied pixels: 0x%08X 0x%08X", pixel(10, 10), pixel(11, 10));
+
+    /* 3. Fog + TGEN matrix texture generation */
+    psp_ge_reset();
+    clear_fb();
+    /* 2x2 texture: (0,0)=red, (1,0)=green, (0,1)=blue, (1,1)=white */
+    psp_write32(TEX + 0,  0xFF0000FFu);
+    psp_write32(TEX + 4,  0xFF00FF00u);
+    psp_write32(TEX + 8,  0xFFFF0000u);
+    psp_write32(TEX + 12, 0xFFFFFFFFu);
+    begin_list();
+    fcmd(0x42, 240.0f); fcmd(0x43, -136.0f); fcmd(0x44, 0.0f);
+    fcmd(0x45, 2048.0f); fcmd(0x46, 2048.0f); fcmd(0x47, 50.0f);
+    cmd(0x4C, (2048 - 240) << 4); cmd(0x4D, (2048 - 136) << 4);
+    cmd(0x1E, 1);                                  /* TME=1 */
+    cmd(0xA0, TEX & 0xFFFFFF); cmd(0xA8, ((TEX >> 8) & 0xFF0000) | 2);
+    cmd(0xB8, (1u << 8) | 1u); cmd(0xC3, 3); cmd(0xC9, 3); /* replace */
+    /* Map position -> UV via TGEN: u = 0.75, v = 0.25 -> texel (1, 0) = green */
+    cmd(0xC0, 1);                                  /* TEXMAPMODE: Matrix, proj=pos */
+    cmd(0x40, 0);
+    for (int i = 0; i < 9; i++) fcmd(0x41, 0.0f);
+    fcmd(0x41, 0.75f); fcmd(0x41, 0.25f); fcmd(0x41, 1.0f);
+    /* Fog enabled: vz=0, fog_end=10, fog_slope=0.05 -> f = 0.5 -> 50% blue fog over green */
+    cmd(0x1F, 1); fcmd(0xCD, 10.0f); fcmd(0xCE, 0.05f); cmd(0xCF, 0x00FF0000u);
+    cmd(0x12, (7u << 2) | (3u << 7));
+    const float tri[3][2] = { {-0.9f, 0.9f}, {-0.5f, 0.9f}, {-0.9f, 0.5f} };
+    for (int i = 0; i < 3; i++) {
+        uint32_t va = VERTS + (uint32_t)i * 16;
+        psp_write32(va + 0,  0xFFFFFFFFu);
+        psp_write32(va + 4,  fbits(tri[i][0]));
+        psp_write32(va + 8,  fbits(tri[i][1]));
+        psp_write32(va + 12, 0);
+    }
+    cmd(0x04, (3u << 16) | 3);
+    end_list();
+    uint32_t fp = pixel(40, 30);
+    uint8_t fg = (uint8_t)((fp >> 8) & 0xFF), fb = (uint8_t)((fp >> 16) & 0xFF);
+    CHECK(fg > 110 && fg < 145 && fb > 110 && fb < 145,
+          "TGEN green + 50%% blue fog: got 0x%08X (G=%d B=%d)", fp, fg, fb);
+}
