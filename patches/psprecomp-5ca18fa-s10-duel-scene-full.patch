+    psp_vrnds(0x00);
+    psp_vrnd(PSP_VRND_F1, 0x04, 4);
+    get_quad(0x04, out);
+    for (int i = 0; i < 4; i++)
+        CHECK(out[i] >= 1.0f && out[i] < 2.0f, "vrndf1 lane %d in [1,2): %f", i, out[i]);
+
+    psp_vrnd(PSP_VRND_F2, 0x08, 4);
+    get_quad(0x08, out);
+    for (int i = 0; i < 4; i++)
+        CHECK(out[i] >= 2.0f && out[i] < 4.0f, "vrndf2 lane %d in [2,4): %f", i, out[i]);
+
+    float first_f1[4], replay[4];
+    psp_vrnds(0x00);
+    psp_vrnd(PSP_VRND_F1, 0x0C, 4);
+    get_quad(0x0C, first_f1);
+    psp_vrnds(0x00);
+    psp_vrnd(PSP_VRND_F1, 0x0C, 4);
+    get_quad(0x0C, replay);
+    for (int i = 0; i < 4; i++)
+        CHECK(psp_f32_to_bits(replay[i]) == psp_f32_to_bits(first_f1[i]), "replay f1 lane %d ok", i);
+    CHECK(psp_f32_to_bits(psp_cpu.v[r[0]]) == 0x12345678u, "seed preserved");
+
+    psp_vrnds(0x00);
+    float first_i[4], second_i[4];
+    psp_vrnd(PSP_VRND_I, 0x04, 4);
+    get_quad(0x04, first_i);
+    psp_vrnds(0x00);
+    psp_vrnd(PSP_VRND_I, 0x04, 4);
+    get_quad(0x04, second_i);
+    for (int i = 0; i < 4; i++)
+        CHECK(psp_f32_to_bits(first_i[i]) == psp_f32_to_bits(second_i[i]),
+              "vrndi deterministic replay lane %d", i);
+
+    /* vfad / vavg across widths, including PSP's vavg.s == 0.0f hardware behavior.
+     * Destination S100 (0x04) is in matrix 1 so it does not alias source C000 (0x00). */
+    const float v4[4] = { 2.0f, 4.0f, 6.0f, 8.0f };
+    set_quad(0x00, v4);
+    psp_vfad(0x04, 0x00, 4);
