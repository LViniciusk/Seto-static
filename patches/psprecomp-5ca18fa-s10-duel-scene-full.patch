+/* psprecomp — sceUtilitySavedata and sceUtilityMsgDialog HLE.
+ *
+ * Implements the PSP's Savedata utility (`sceUtilitySavedata*`) backed by real
+ * files under `<psp_io_get_root()>/ms/PSP/SAVEDATA/<gameName><saveName>/` and
+ * the companion Message Dialog utility (`sceUtilityMsgDialog*`).
+ *
+ * Struct offsets and error codes match PPSSPP `SavedataParam.h` / `PSPMsgDialog.h`
+ * and PSPSDK `<psputility_savedata.h>` / `<psputility_msgdialog.h>`.
+ */
+
+#include "psprecomp/hle.h"
+#include "psprecomp/mem.h"
+
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+
+#ifdef _WIN32
+#  include <direct.h>
+#  include <io.h>
+#else
+#  include <dirent.h>
+#  include <unistd.h>
+#endif
+
+/* Dialog status values (PPSSPP PSPDialog::DialogStatus). */
+enum {
+    UTIL_STATUS_NONE       = 0,
+    UTIL_STATUS_INITIALIZE = 1,
+    UTIL_STATUS_RUNNING    = 2,
+    UTIL_STATUS_FINISHED   = 3,
+    UTIL_STATUS_SHUTDOWN   = 4
+};
+
+/* Utility generic / dialog error codes (PPSSPP ErrorCodes.h). */
+enum {
+    ERR_UTIL_INVALID_STATUS     = 0x80110001u,
+    ERR_UTIL_INVALID_ADDRESS    = 0x80110002u,
+    ERR_UTIL_INVALID_PARAM_SIZE = 0x80110004u,
+    ERR_UTIL_WRONG_TYPE         = 0x80110005u,
+    ERR_MSG_BADOPTION           = 0x80110501u,
+    ERR_MSG_ERRORCODEINVALID    = 0x80110502u
+};
+
+/* Savedata error codes (PPSSPP ErrorCodes.h / PSPSDK). */
+enum {
+    ERR_SAVE_LOAD_DATA_BROKEN = 0x80110306u,
+    ERR_SAVE_LOAD_NO_DATA     = 0x80110307u,
+    ERR_SAVE_LOAD_PARAM       = 0x80110308u,
+    ERR_SAVE_RW_DATA_BROKEN   = 0x80110326u,
+    ERR_SAVE_RW_NO_DATA       = 0x80110327u,
+    ERR_SAVE_RW_BAD_PARAMS    = 0x80110328u,
+    ERR_SAVE_DELETE_NO_DATA   = 0x80110347u,
+    ERR_SAVE_SAVE_MS_NOSPACE  = 0x80110383u,
+    ERR_SAVE_SAVE_PARAM       = 0x80110388u,
+    ERR_SAVE_SIZES_NO_DATA    = 0x801103C7u
+};
+
+/* Savedata modes (SceUtilitySavedataType). */
+enum {
+    MODE_AUTOLOAD        = 0,
+    MODE_AUTOSAVE        = 1,
+    MODE_LOAD            = 2,
+    MODE_SAVE            = 3,
+    MODE_LISTLOAD        = 4,
+    MODE_LISTSAVE        = 5,
+    MODE_LISTDELETE      = 6,
+    MODE_LISTALLDELETE   = 7,
+    MODE_SIZES           = 8,
+    MODE_AUTODELETE      = 9,
+    MODE_DELETE          = 10,
+    MODE_LIST            = 11,
+    MODE_FILES           = 12,
+    MODE_MAKEDATASECURE  = 13,
+    MODE_MAKEDATA        = 14,
+    MODE_READDATASECURE  = 15,
+    MODE_READDATA        = 16,
+    MODE_WRITEDATASECURE = 17,
+    MODE_WRITEDATA       = 18,
+    MODE_ERASESECURE     = 19,
+    MODE_ERASE           = 20,
+    MODE_DELETEDATA      = 21,
+    MODE_GETSIZE         = 22
+};
+
+/* Byte offsets inside SceUtilitySavedataParam (0x600 = 1536 bytes). */
+enum {
+    OFF_SIZE          = 0,
+    OFF_RESULT        = 28,
+    OFF_MODE          = 48,
+    OFF_BIND          = 52,
+    OFF_OVERWRITE     = 56,
+    OFF_GAMENAME      = 60,   /* char[13] (+3 pad) */
+    OFF_SAVENAME      = 76,   /* char[20] */
+    OFF_SAVENAMELIST  = 96,   /* u32 ptr */
+    OFF_FILENAME      = 100,  /* char[13] (+3 pad) */
+    OFF_DATABUF       = 116,  /* u32 ptr */
+    OFF_DATABUFSIZE   = 120,
+    OFF_DATASIZE      = 124,
+    OFF_SFO_TITLE     = 128,  /* char[128] */
+    OFF_SFO_SAVETITLE = 256,  /* char[128] */
+    OFF_SFO_DETAIL    = 384,  /* char[1024] */
+    OFF_SFO_PARENTAL  = 1408, /* u8 */
+    OFF_ICON0         = 1412, /* PspUtilitySavedataFileData (16B each) */
+    OFF_ICON1         = 1428,
+    OFF_PIC1          = 1444,
+    OFF_SND0          = 1460,
+    OFF_NEWDATA       = 1476, /* u32 ptr to PspUtilitySavedataFileData */
+    OFF_FOCUS         = 1480,
+    OFF_MSFREE        = 1488, /* u32 ptr */
+    OFF_MSDATA        = 1492, /* u32 ptr */
+    OFF_UTILITYDATA   = 1496, /* u32 ptr */
+    OFF_KEY           = 1500, /* u8[16] */
+    OFF_IDLIST        = 1524, /* u32 ptr */
+    OFF_FILELIST      = 1528, /* u32 ptr */
+    OFF_SIZEINFO      = 1532, /* u32 ptr */
+    SAVEDATA_PARAM_SIZE = 1536
+};
+
+/* Byte offsets inside pspMessageDialog (572 / 580 / 708 bytes). */
+enum {
+    MSG_SIZE_V1       = 572,
+    MSG_SIZE_V2       = 580,
+    MSG_SIZE_V3       = 708,
+    MSG_OFF_RESULT    = 48,
+    MSG_OFF_TYPE      = 52,
+    MSG_OFF_ERRORNUM  = 56,
+    MSG_OFF_STRING    = 60,
+    MSG_OFF_OPTIONS   = 572,
+    MSG_OFF_BUTTON    = 576
+};
+
+enum {
+    MSG_OPT_YESNO      = 0x00000010u,
+    MSG_OPT_OK         = 0x00000020u,
+    MSG_OPT_DEFAULT_NO = 0x00000100u,
+    MSG_OPT_SUPPORTED  = 0x000001B3u,
+    MSG_BTN_NONE       = 0u,
+    MSG_BTN_YES        = 1u,
+    MSG_BTN_NO         = 2u
+};
+
+#define MS_CLUSTER_SIZE  32768u
+#define MS_VIRTUAL_FREE  (512ull * 1024ull * 1024ull)
+
+typedef enum {
+    DIALOG_NONE = 0,
+    DIALOG_SAVEDATA,
+    DIALOG_MSG
+} active_dialog_type;
+
+typedef struct {
+    int status;
+    uint32_t param_addr;
+    uint32_t param_size;
+    int executed;
+} dialog_state;
+
+static active_dialog_type g_active_dialog = DIALOG_NONE;
+static dialog_state g_save_dlg;
+static dialog_state g_msg_dlg;
+
+void psp_savedata_reset(void) {
+    g_active_dialog = DIALOG_NONE;
+    memset(&g_save_dlg, 0, sizeof g_save_dlg);
+    memset(&g_msg_dlg, 0, sizeof g_msg_dlg);
+}
+
+void psp_savedata_init(void) { psp_savedata_reset(); }
+
+static void read_guest_str(uint32_t addr, char *dst, size_t cap) {
+    if (!cap) return;
+    if (!addr) { dst[0] = '\0'; return; }
+    size_t i = 0;
+    for (; i + 1 < cap; i++) {
+        uint8_t c = psp_read8(addr + (uint32_t)i);
+        dst[i] = (char)c;
+        if (!c) return;
+    }
+    dst[cap - 1] = '\0';
+}
+
+static void write_guest_str(uint32_t addr, const char *src, size_t cap) {
+    if (!addr || !cap) return;
+    size_t n = src ? strlen(src) : 0;
+    if (n >= cap) n = cap - 1;
+    for (size_t i = 0; i < n; i++) psp_write8(addr + (uint32_t)i, (uint8_t)src[i]);
+    for (size_t i = n; i < cap; i++) psp_write8(addr + (uint32_t)i, 0);
+}
+
+static int sanitize_component(const char *src, char *dst, size_t cap) {
+    if (!cap) return 0;
+    size_t o = 0;
+    for (size_t i = 0; src && src[i] && o + 1 < cap; i++) {
+        unsigned char c = (unsigned char)src[i];
+        if (c == '/' || c == '\\' || c < 0x20) continue;
+        if (c == '.' && src[i + 1] == '.') return 0;
+        dst[o++] = (char)c;
+    }
+    dst[o] = '\0';
+    return 1;
+}
+
+static int make_dir_one(const char *path) {
+#ifdef _WIN32
+    return _mkdir(path);
+#else
+    return mkdir(path, 0755);
+#endif
+}
+
+static void ensure_dir_p(const char *path) {
+    char buf[1024];
+    snprintf(buf, sizeof buf, "%s", path);
+    size_t len = strlen(buf);
+    for (size_t i = 1; i < len; i++) {
+        if (buf[i] == '/' || buf[i] == '\\') {
+            if (i == 2 && buf[1] == ':') continue;
+            buf[i] = '\0';
+            make_dir_one(buf);
+            buf[i] = '/';
+        }
+    }
+    make_dir_one(buf);
+}
+
+static int path_is_dir(const char *path) {
+    struct stat st;
+    if (stat(path, &st) != 0) return 0;
+    return S_ISDIR(st.st_mode);
+}
+
+static int valid_mem_span(uint32_t addr, uint32_t size) {
+    return addr != 0u && (size == 0u || psp_mem_ptr(addr, size) != NULL);
+}
+
+#ifndef _WIN32
+static int path_file_size(const char *path, uint64_t *out_size, time_t *out_mtime) {
+    struct stat st;
+    if (stat(path, &st) != 0 || S_ISDIR(st.st_mode)) return 0;
+    if (out_size) *out_size = (uint64_t)st.st_size;
+    if (out_mtime) *out_mtime = st.st_mtime;
+    return 1;
+}
+#endif
+
+static void savedata_base_dir(char *out, size_t cap) {
+    snprintf(out, cap, "%s/ms/PSP/SAVEDATA", psp_io_get_root());
+}
+
+static void format_space_str(uint64_t bytes, char out[8]) {
+    uint64_t kb = bytes / 1024ull;
+    if (kb >= 1024ull * 1024ull) {
+        snprintf(out, 8, "%lluGB", (unsigned long long)(kb / (1024ull * 1024ull)));
+    } else if (kb >= 1024ull) {
+        snprintf(out, 8, "%lluMB", (unsigned long long)(kb / 1024ull));
+    } else {
+        snprintf(out, 8, "%lluKB", (unsigned long long)kb);
+    }
+}
+
+static void write_psp_datetime(uint32_t addr, time_t t) {
+    struct tm tm_buf;
+    struct tm *ptm = localtime(&t);
+    if (ptm) tm_buf = *ptm;
+    else memset(&tm_buf, 0, sizeof tm_buf);
+
+    psp_write16(addr + 0, (uint16_t)(tm_buf.tm_year + 1900));
+    psp_write16(addr + 2, (uint16_t)(tm_buf.tm_mon + 1));
+    psp_write16(addr + 4, (uint16_t)tm_buf.tm_mday);
+    psp_write16(addr + 6, (uint16_t)tm_buf.tm_hour);
+    psp_write16(addr + 8, (uint16_t)tm_buf.tm_min);
+    psp_write16(addr + 10, (uint16_t)tm_buf.tm_sec);
+    psp_write32(addr + 12, 0u);
+}
+
+static void fill_used_info(uint32_t addr, uint64_t bytes) {
+    uint32_t clusters = (uint32_t)((bytes + MS_CLUSTER_SIZE - 1u) / MS_CLUSTER_SIZE);
+    uint32_t kb = clusters * (MS_CLUSTER_SIZE / 1024u);
+    char str[8];
+    format_space_str((uint64_t)kb * 1024ull, str);
+    psp_write32(addr + 0, clusters);
+    psp_write32(addr + 4, kb);
+    write_guest_str(addr + 8, str, 8);
+    psp_write32(addr + 16, kb);
+    write_guest_str(addr + 20, str, 8);
+}
+
+static int wildcard_match(const char *pat, const char *str) {
+    if (!*pat) return !*str;
+    if (*pat == '*') {
+        while (*pat == '*') pat++;
+        if (!*pat) return 1;
+        while (*str) {
+            if (wildcard_match(pat, str)) return 1;
+            str++;
+        }
+        return wildcard_match(pat, str);
+    }
+    if (*pat == '?' && *str) return wildcard_match(pat + 1, str + 1);
+    if (*pat == *str) return wildcard_match(pat + 1, str + 1);
+    return 0;
+}
+
+static uint64_t sum_dir_bytes(const char *dir) {
+    uint64_t total = 0;
+#ifdef _WIN32
+    char pat[1080];
+    snprintf(pat, sizeof pat, "%s/*", dir);
+    struct _finddata_t fd;
+    intptr_t h = _findfirst(pat, &fd);
+    if (h == -1) return 0;
+    do {
+        if (strcmp(fd.name, ".") == 0 || strcmp(fd.name, "..") == 0) continue;
+        if (!(fd.attrib & _A_SUBDIR)) total += (uint64_t)fd.size;
+    } while (_findnext(h, &fd) == 0);
+    _findclose(h);
+#else
+    DIR *d = opendir(dir);
+    if (!d) return 0;
+    struct dirent *de;
+    while ((de = readdir(d)) != NULL) {
+        if (strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0) continue;
+        char full[1080];
+        uint64_t sz = 0;
+        snprintf(full, sizeof full, "%s/%s", dir, de->d_name);
+        if (path_file_size(full, &sz, NULL)) total += sz;
+    }
+    closedir(d);
+#endif
+    return total;
+}
+
+static void delete_dir_recursive(const char *dir) {
+#ifdef _WIN32
+    char pat[1080];
+    snprintf(pat, sizeof pat, "%s/*", dir);
+    struct _finddata_t fd;
+    intptr_t h = _findfirst(pat, &fd);
+    if (h != -1) {
+        do {
+            if (strcmp(fd.name, ".") == 0 || strcmp(fd.name, "..") == 0) continue;
+            char full[1400];
+            snprintf(full, sizeof full, "%s/%s", dir, fd.name);
+            remove(full);
+        } while (_findnext(h, &fd) == 0);
+        _findclose(h);
+    }
+    _rmdir(dir);
+#else
+    DIR *d = opendir(dir);
+    if (d) {
+        struct dirent *de;
+        while ((de = readdir(d)) != NULL) {
+            if (strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0) continue;
+            char full[1080];
+            snprintf(full, sizeof full, "%s/%s", dir, de->d_name);
+            unlink(full);
+        }
+        closedir(d);
+    }
+    rmdir(dir);
+#endif
+}
+
+static void resolve_save_name(uint32_t param, const char *game, char out[32]) {
+    char raw[20];
+    read_guest_str(param + OFF_SAVENAME, raw, sizeof raw);
+    if (raw[0] && strcmp(raw, "<>") != 0) {
+        sanitize_component(raw, out, 32);
+        return;
+    }
+
+    uint32_t list = psp_read32(param + OFF_SAVENAMELIST);
+    if (list) {
+        char base[960];
+        savedata_base_dir(base, sizeof base);
+        for (int i = 0; i < 64; i++) {
+            char cand[20];
+            read_guest_str(list + (uint32_t)i * 20u, cand, sizeof cand);
+            if (!cand[0]) break;
+            char clean[32], dir[1024];
+            if (!sanitize_component(cand, clean, sizeof clean)) continue;
+            snprintf(dir, sizeof dir, "%s/%s%s", base, game, clean);
+            if (path_is_dir(dir)) {
+                snprintf(out, 32, "%s", clean);
+                return;
+            }
+        }
+        read_guest_str(list, raw, sizeof raw);
+        if (raw[0] && sanitize_component(raw, out, 32)) return;
+    }
+    snprintf(out, 32, "DATA0");
+}
+
+static void write_le32_buf(uint8_t *p, uint32_t v) {
+    p[0] = (uint8_t)(v & 0xFFu);
+    p[1] = (uint8_t)((v >> 8) & 0xFFu);
+    p[2] = (uint8_t)((v >> 16) & 0xFFu);
+    p[3] = (uint8_t)((v >> 24) & 0xFFu);
+}
+
+static void write_le16_buf(uint8_t *p, uint16_t v) {
+    p[0] = (uint8_t)(v & 0xFFu);
+    p[1] = (uint8_t)((v >> 8) & 0xFFu);
+}
+
+static uint32_t read_le32_buf(const uint8_t *p) {
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+           ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static uint16_t read_le16_buf(const uint8_t *p) {
+    return (uint16_t)p[0] | ((uint16_t)p[1] << 8);
+}
+
+/* Write a minimal valid PSP PARAM.SFO holding title/subtitle/detail/dir. */
+static void save_param_sfo(const char *dir, uint32_t param, const char *dir_name) {
+    static const char *const keys[6] = {
+        "CATEGORY", "PARENTAL_LEVEL", "SAVEDATA_DETAIL",
+        "SAVEDATA_DIRECTORY", "SAVEDATA_TITLE", "TITLE"
+    };
+    char title[128], save_title[128], detail[1024];
+    read_guest_str(param + OFF_SFO_TITLE, title, sizeof title);
+    read_guest_str(param + OFF_SFO_SAVETITLE, save_title, sizeof save_title);
+    read_guest_str(param + OFF_SFO_DETAIL, detail, sizeof detail);
+    uint32_t parental = psp_read8(param + OFF_SFO_PARENTAL);
+
+    const uint16_t fmt[6] = { 0x0204, 0x0404, 0x0204, 0x0204, 0x0204, 0x0204 };
+    const uint32_t mlen[6] = { 4, 4, 1024, 64, 128, 128 };
+    const uint8_t *vals[6] = {
+        (const uint8_t *)"MS", (const uint8_t *)&parental, (const uint8_t *)detail,
+        (const uint8_t *)dir_name, (const uint8_t *)save_title, (const uint8_t *)title
+    };
+    uint32_t slen[6] = {
+        3, 4,
+        (uint32_t)strlen(detail) + 1u,
+        (uint32_t)strlen(dir_name) + 1u,
+        (uint32_t)strlen(save_title) + 1u,
+        (uint32_t)strlen(title) + 1u
+    };
+    for (int i = 0; i < 6; i++) if (slen[i] > mlen[i]) slen[i] = mlen[i];
+
+    uint8_t key_tbl[256];
+    uint32_t kt_len = 0;
+    uint16_t k_off[6];
+    for (int i = 0; i < 6; i++) {
+        k_off[i] = (uint16_t)kt_len;
+        size_t l = strlen(keys[i]) + 1u;
+        memcpy(key_tbl + kt_len, keys[i], l);
+        kt_len += (uint32_t)l;
+    }
+    while (kt_len & 3u) key_tbl[kt_len++] = 0;
+
+    uint32_t key_table_off = 20u + 6u * 16u;
+    uint32_t data_table_off = key_table_off + kt_len;
+    uint32_t data_len = 0;
+    for (int i = 0; i < 6; i++) data_len += mlen[i];
+
+    uint8_t *buf = (uint8_t *)calloc(1, data_table_off + data_len);
+    if (!buf) return;
+    write_le32_buf(buf + 0, 0x46535000u);
+    write_le32_buf(buf + 4, 0x00000101u);
+    write_le32_buf(buf + 8, key_table_off);
+    write_le32_buf(buf + 12, data_table_off);
+    write_le32_buf(buf + 16, 6u);
+    memcpy(buf + key_table_off, key_tbl, kt_len);
+
+    uint32_t d_off = 0;
+    for (int i = 0; i < 6; i++) {
+        uint8_t *e = buf + 20u + (uint32_t)i * 16u;
+        write_le16_buf(e + 0, k_off[i]);
+        write_le16_buf(e + 2, fmt[i]);
+        write_le32_buf(e + 4, slen[i]);
+        write_le32_buf(e + 8, mlen[i]);
+        write_le32_buf(e + 12, d_off);
+        if (i == 1) write_le32_buf(buf + data_table_off + d_off, parental);
+        else memcpy(buf + data_table_off + d_off, vals[i], slen[i] ? slen[i] - 1u : 0u);
+        d_off += mlen[i];
+    }
+
+    char path[1080];
+    snprintf(path, sizeof path, "%s/PARAM.SFO", dir);
+    FILE *f = fopen(path, "wb");
+    if (f) {
+        fwrite(buf, 1, data_table_off + data_len, f);
+        fclose(f);
+    }
+    free(buf);
+}
+
+static void load_param_sfo(const char *dir, uint32_t param) {
+    char path[1080];
+    snprintf(path, sizeof path, "%s/PARAM.SFO", dir);
+    FILE *f = fopen(path, "rb");
+    if (!f) return;
+    fseek(f, 0, SEEK_END);
+    long sz = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if (sz < 20 || sz > 65536) { fclose(f); return; }
+    uint8_t *buf = (uint8_t *)malloc((size_t)sz);
+    if (!buf) { fclose(f); return; }
+    if (fread(buf, 1, (size_t)sz, f) != (size_t)sz) {
+        free(buf);
+        fclose(f);
+        return;
+    }
+    fclose(f);
+
+    if (read_le32_buf(buf) != 0x46535000u) { free(buf); return; }
+    uint32_t kt = read_le32_buf(buf + 8);
+    uint32_t dt = read_le32_buf(buf + 12);
+    uint32_t cnt = read_le32_buf(buf + 16);
+    for (uint32_t i = 0; i < cnt && 20u + (i + 1u) * 16u <= (uint32_t)sz; i++) {
+        const uint8_t *e = buf + 20u + i * 16u;
+        uint32_t ko = kt + read_le16_buf(e + 0);
+        uint32_t dl = read_le32_buf(e + 4);
+        uint32_t doff = dt + read_le32_buf(e + 12);
+        if (ko >= (uint32_t)sz || doff + dl > (uint32_t)sz) continue;
+        const char *k = (const char *)(buf + ko);
+        const char *v = (const char *)(buf + doff);
+        if (strcmp(k, "TITLE") == 0) write_guest_str(param + OFF_SFO_TITLE, v, 128);
+        else if (strcmp(k, "SAVEDATA_TITLE") == 0) write_guest_str(param + OFF_SFO_SAVETITLE, v, 128);
+        else if (strcmp(k, "SAVEDATA_DETAIL") == 0) write_guest_str(param + OFF_SFO_DETAIL, v, 1024);
+        else if (strcmp(k, "PARENTAL_LEVEL") == 0 && dl >= 4)
+            psp_write8(param + OFF_SFO_PARENTAL, (uint8_t)read_le32_buf(buf + doff));
+    }
+    free(buf);
+}
+
+static void save_subfile(const char *dir, const char *name, uint32_t fdata_addr) {
+    uint32_t buf = psp_read32(fdata_addr + 0);
+    uint32_t size = psp_read32(fdata_addr + 8);
+    if (!buf || !size || !valid_mem_span(buf, size)) return;
+    uint8_t *tmp = (uint8_t *)malloc(size);
+    if (!tmp) return;
+    if (psp_mem_read_block(tmp, buf, size) == 0) {
+        char path[1080];
+        snprintf(path, sizeof path, "%s/%s", dir, name);
+        FILE *f = fopen(path, "wb");
+        if (f) {
+            fwrite(tmp, 1, size, f);
+            fclose(f);
+        }
+    }
+    free(tmp);
+}
+
+static void load_subfile(const char *dir, const char *name, uint32_t fdata_addr) {
+    uint32_t buf = psp_read32(fdata_addr + 0);
+    uint32_t cap = psp_read32(fdata_addr + 4);
+    if (!buf || !cap || !valid_mem_span(buf, cap)) return;
+    char path[1080];
+    snprintf(path, sizeof path, "%s/%s", dir, name);
+    FILE *f = fopen(path, "rb");
+    if (!f) return;
+    fseek(f, 0, SEEK_END);
+    long sz = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if (sz > 0) {
+        uint32_t to_read = (uint32_t)sz;
+        if (to_read > cap) to_read = cap;
+        uint8_t *tmp = (uint8_t *)malloc(to_read);
+        if (tmp) {
+            size_t got = fread(tmp, 1, to_read, f);
+            if (got > 0) psp_mem_write_block(buf, tmp, (uint32_t)got);
+            psp_write32(fdata_addr + 8, (uint32_t)got);
+            free(tmp);
+        }
+    }
+    fclose(f);
+}
+
+static uint32_t do_save(uint32_t param, const char *dir, const char *dir_name, const char *file) {
+    uint32_t data_buf = psp_read32(param + OFF_DATABUF);
+    uint32_t buf_size = psp_read32(param + OFF_DATABUFSIZE);
+    uint32_t data_size = psp_read32(param + OFF_DATASIZE);
+    if (data_size > buf_size) return ERR_SAVE_RW_BAD_PARAMS;
+    if (data_buf && data_size && !valid_mem_span(data_buf, data_size)) return ERR_SAVE_RW_BAD_PARAMS;
+
+    ensure_dir_p(dir);
+    save_param_sfo(dir, param, dir_name);
+    save_subfile(dir, "ICON0.PNG", param + OFF_ICON0);
+    save_subfile(dir, "ICON1.PMF", param + OFF_ICON1);
+    save_subfile(dir, "PIC1.PNG",  param + OFF_PIC1);
+    save_subfile(dir, "SND0.AT3",  param + OFF_SND0);
+
+    if (data_buf && file[0]) {
+        char path[1080];
+        snprintf(path, sizeof path, "%s/%s", dir, file);
+        uint8_t *tmp = data_size ? (uint8_t *)malloc(data_size) : NULL;
+        if (data_size && (!tmp || psp_mem_read_block(tmp, data_buf, data_size) != 0)) {
+            free(tmp);
+            return ERR_SAVE_SAVE_MS_NOSPACE;
+        }
+        FILE *f = fopen(path, "wb");
+        if (!f) { free(tmp); return ERR_SAVE_SAVE_MS_NOSPACE; }
+        size_t wr = data_size ? fwrite(tmp, 1, data_size, f) : 0;
+        fclose(f);
+        free(tmp);
+        if (wr != data_size) return ERR_SAVE_SAVE_MS_NOSPACE;
+    }
+    return 0;
+}
+
+static uint32_t do_load(uint32_t param, const char *dir, const char *file, int rw_mode) {
+    uint32_t no_data = rw_mode ? ERR_SAVE_RW_NO_DATA : ERR_SAVE_LOAD_NO_DATA;
+    uint32_t broken  = rw_mode ? ERR_SAVE_RW_DATA_BROKEN : ERR_SAVE_LOAD_DATA_BROKEN;
+    if (!path_is_dir(dir)) return no_data;
+
+    load_param_sfo(dir, param);
+    load_subfile(dir, "ICON0.PNG", param + OFF_ICON0);
+    load_subfile(dir, "ICON1.PMF", param + OFF_ICON1);
+    load_subfile(dir, "PIC1.PNG",  param + OFF_PIC1);
+    load_subfile(dir, "SND0.AT3",  param + OFF_SND0);
+
+    if (!file[0]) return 0;
+    char path[1080];
+    snprintf(path, sizeof path, "%s/%s", dir, file);
+    FILE *f = fopen(path, "rb");
+    if (!f) return no_data;
+
+    fseek(f, 0, SEEK_END);
+    long sz = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if (sz < 0) { fclose(f); return broken; }
+
+    uint32_t data_buf = psp_read32(param + OFF_DATABUF);
+    uint32_t buf_size = psp_read32(param + OFF_DATABUFSIZE);
+    uint32_t fsize = (uint32_t)sz;
+    if (data_buf) {
+        if (fsize > buf_size || !valid_mem_span(data_buf, fsize)) {
+            fclose(f);
+            return broken;
+        }
+        if (fsize > 0) {
+            uint8_t *tmp = (uint8_t *)malloc(fsize);
+            if (!tmp) { fclose(f); return broken; }
+            size_t got = fread(tmp, 1, fsize, f);
+            for (size_t i = 0; i < got; i++) psp_write8(data_buf + (uint32_t)i, tmp[i]);
+            free(tmp);
+            if (got != fsize) { fclose(f); return broken; }
+        }
+        psp_write32(param + OFF_DATASIZE, fsize);
+    }
+    fclose(f);
+    return 0;
+}
+
+static uint32_t do_sizes(uint32_t param, const char *game) {
+    uint32_t ms_free = psp_read32(param + OFF_MSFREE);
+    if (ms_free && valid_mem_span(ms_free, 20)) {
+        char txt[8];
+        format_space_str(MS_VIRTUAL_FREE, txt);
+        psp_write32(ms_free + 0, MS_CLUSTER_SIZE);
+        psp_write32(ms_free + 4, (uint32_t)(MS_VIRTUAL_FREE / MS_CLUSTER_SIZE));
+        psp_write32(ms_free + 8, (uint32_t)(MS_VIRTUAL_FREE / 1024ull));
+        write_guest_str(ms_free + 12, txt, 8);
+    }
+
+    int missing = 0;
+    uint32_t ms_data = psp_read32(param + OFF_MSDATA);
+    if (ms_data && valid_mem_span(ms_data, 64)) {
+        char mg[14], ms[21], cg[16], cs[32], base[960], dir[1024];
+        read_guest_str(ms_data + 0, mg, sizeof mg);
+        read_guest_str(ms_data + 16, ms, sizeof ms);
+        sanitize_component(mg[0] ? mg : game, cg, sizeof cg);
+        sanitize_component(strcmp(ms, "<>") == 0 ? "" : ms, cs, sizeof cs);
+        savedata_base_dir(base, sizeof base);
+        snprintf(dir, sizeof dir, "%s/%s%s", base, cg, cs);
+        if (path_is_dir(dir)) fill_used_info(ms_data + 36, sum_dir_bytes(dir));
+        else {
+            fill_used_info(ms_data + 36, 0);
+            missing = 1;
+        }
+    }
+
+    uint32_t util_data = psp_read32(param + OFF_UTILITYDATA);
+    if (util_data && valid_mem_span(util_data, 28)) {
+        uint64_t bytes = (uint64_t)psp_read32(param + OFF_DATASIZE) + MS_CLUSTER_SIZE;
+        fill_used_info(util_data, bytes);
+    }
+    return missing ? ERR_SAVE_SIZES_NO_DATA : 0u;
+}
+
+static uint32_t do_getsize(uint32_t param, const char *dir) {
+    uint32_t size_info = psp_read32(param + OFF_SIZEINFO);
+    int exists = path_is_dir(dir);
+    if (size_info && valid_mem_span(size_info, 60)) {
+        char txt[8];
+        format_space_str(MS_VIRTUAL_FREE, txt);
+        psp_write32(size_info + 16, MS_CLUSTER_SIZE);
+        psp_write32(size_info + 20, (uint32_t)(MS_VIRTUAL_FREE / MS_CLUSTER_SIZE));
+        psp_write32(size_info + 24, (uint32_t)(MS_VIRTUAL_FREE / 1024ull));
+        write_guest_str(size_info + 28, txt, 8);
+        psp_write32(size_info + 36, 0u);
+        psp_write32(size_info + 48, 0u);
+    }
+    return exists ? 0u : ERR_SAVE_RW_NO_DATA;
+}
+
+static uint32_t do_list(uint32_t param, const char *game) {
+    uint32_t id_list = psp_read32(param + OFF_IDLIST);
+    if (!id_list || !valid_mem_span(id_list, 12)) return 0u;
+    uint32_t max_cnt = psp_read32(id_list + 0);
+    uint32_t entries = psp_read32(id_list + 8);
+    char pat_raw[20], pat_clean[32], pat[64], base[960];
+    read_guest_str(param + OFF_SAVENAME, pat_raw, sizeof pat_raw);
+    sanitize_component(pat_raw[0] ? pat_raw : "*", pat_clean, sizeof pat_clean);
+    snprintf(pat, sizeof pat, "%s%s", game, pat_clean);
+    savedata_base_dir(base, sizeof base);
+    size_t glen = strlen(game);
+
+    uint32_t found = 0;
+    if (entries && max_cnt && path_is_dir(base)) {
+#ifdef _WIN32
+        char glob[1024];
+        snprintf(glob, sizeof glob, "%s/*", base);
+        struct _finddata_t fd;
+        intptr_t h = _findfirst(glob, &fd);
+        if (h != -1) {
+            do {
+                if (found >= max_cnt) break;
+                if (!(fd.attrib & _A_SUBDIR)) continue;
+                if (fd.name[0] == '.') continue;
+                if (!wildcard_match(pat, fd.name)) continue;
+                uint32_t e = entries + found * 72u;
+                if (!valid_mem_span(e, 72)) break;
+                psp_write32(e + 0, 0x11FFu);
+                write_psp_datetime(e + 4, fd.time_create);
+                write_psp_datetime(e + 20, fd.time_access);
+                write_psp_datetime(e + 36, fd.time_write);
+                write_guest_str(e + 52, strlen(fd.name) > glen ? fd.name + glen : fd.name, 20);
+                found++;
+            } while (_findnext(h, &fd) == 0);
+            _findclose(h);
+        }
+#else
+        DIR *d = opendir(base);
+        if (d) {
+            struct dirent *de;
+            while ((de = readdir(d)) != NULL && found < max_cnt) {
+                if (de->d_name[0] == '.') continue;
+                char full[1080];
+                struct stat st;
+                snprintf(full, sizeof full, "%s/%s", base, de->d_name);
+                if (stat(full, &st) != 0 || !S_ISDIR(st.st_mode)) continue;
+                if (!wildcard_match(pat, de->d_name)) continue;
+                uint32_t e = entries + found * 72u;
+                if (!valid_mem_span(e, 72)) break;
+                psp_write32(e + 0, 0x11FFu);
+                write_psp_datetime(e + 4, st.st_ctime);
+                write_psp_datetime(e + 20, st.st_atime);
+                write_psp_datetime(e + 36, st.st_mtime);
+                write_guest_str(e + 52, strlen(de->d_name) > glen ? de->d_name + glen : de->d_name, 20);
+                found++;
+            }
+            closedir(d);
+        }
+#endif
+    }
+    psp_write32(id_list + 4, found);
+    return 0u;
+}
+
+static uint32_t do_files(uint32_t param, const char *dir) {
+    uint32_t flist = psp_read32(param + OFF_FILELIST);
+    if (!flist || !valid_mem_span(flist, 36)) return 0u;
+    if (!path_is_dir(dir)) return ERR_SAVE_RW_NO_DATA;
+
+    uint32_t max_sec = psp_read32(flist + 0);
+    uint32_t max_nor = psp_read32(flist + 4);
+    uint32_t max_sys = psp_read32(flist + 8);
+    uint32_t p_sec = psp_read32(flist + 24);
+    uint32_t p_nor = psp_read32(flist + 28);
+    uint32_t p_sys = psp_read32(flist + 32);
+    uint32_t n_sec = 0, n_nor = 0, n_sys = 0;
+
+    char req_file[20];
+    read_guest_str(param + OFF_FILENAME, req_file, sizeof req_file);
+
+#ifdef _WIN32
+    char glob[1080];
+    snprintf(glob, sizeof glob, "%s/*", dir);
+    struct _finddata_t fd;
+    intptr_t h = _findfirst(glob, &fd);
+    if (h != -1) {
+        do {
+            if (fd.attrib & _A_SUBDIR) continue;
+            int is_sys = (strcmp(fd.name, "PARAM.SFO") == 0 || strcmp(fd.name, "ICON0.PNG") == 0 ||
+                          strcmp(fd.name, "ICON1.PMF") == 0 || strcmp(fd.name, "PIC1.PNG") == 0 ||
+                          strcmp(fd.name, "SND0.AT3") == 0);
+            int is_sec = (!is_sys && strcmp(fd.name, req_file) == 0);
+            uint32_t arr = is_sys ? p_sys : (is_sec ? p_sec : p_nor);
+            uint32_t *cnt = is_sys ? &n_sys : (is_sec ? &n_sec : &n_nor);
+            uint32_t cap = is_sys ? max_sys : (is_sec ? max_sec : max_nor);
+            if (arr && *cnt < cap && valid_mem_span(arr + (*cnt) * 80u, 80)) {
+                uint32_t e = arr + (*cnt) * 80u;
+                psp_write32(e + 0, 0x21FFu);
+                psp_write32(e + 4, 0u);
+                psp_write32(e + 8, (uint32_t)fd.size);
+                psp_write32(e + 12, 0u);
+                write_psp_datetime(e + 16, fd.time_create);
+                write_psp_datetime(e + 32, fd.time_access);
+                write_psp_datetime(e + 48, fd.time_write);
+                write_guest_str(e + 64, fd.name, 16);
+                (*cnt)++;
+            }
+        } while (_findnext(h, &fd) == 0);
+        _findclose(h);
+    }
+#else
+    DIR *d = opendir(dir);
+    if (d) {
+        struct dirent *de;
+        while ((de = readdir(d)) != NULL) {
+            char full[1080];
+            struct stat st;
+            snprintf(full, sizeof full, "%s/%s", dir, de->d_name);
+            if (stat(full, &st) != 0 || S_ISDIR(st.st_mode)) continue;
+            int is_sys = (strcmp(de->d_name, "PARAM.SFO") == 0 || strcmp(de->d_name, "ICON0.PNG") == 0 ||
+                          strcmp(de->d_name, "ICON1.PMF") == 0 || strcmp(de->d_name, "PIC1.PNG") == 0 ||
+                          strcmp(de->d_name, "SND0.AT3") == 0);
+            int is_sec = (!is_sys && strcmp(de->d_name, req_file) == 0);
+            uint32_t arr = is_sys ? p_sys : (is_sec ? p_sec : p_nor);
+            uint32_t *cnt = is_sys ? &n_sys : (is_sec ? &n_sec : &n_nor);
+            uint32_t cap = is_sys ? max_sys : (is_sec ? max_sec : max_nor);
+            if (arr && *cnt < cap && valid_mem_span(arr + (*cnt) * 80u, 80)) {
+                uint32_t e = arr + (*cnt) * 80u;
+                psp_write32(e + 0, 0x21FFu);
+                psp_write32(e + 4, 0u);
+                psp_write32(e + 8, (uint32_t)st.st_size);
+                psp_write32(e + 12, 0u);
+                write_psp_datetime(e + 16, st.st_ctime);
+                write_psp_datetime(e + 32, st.st_atime);
+                write_psp_datetime(e + 48, st.st_mtime);
+                write_guest_str(e + 64, de->d_name, 16);
+                (*cnt)++;
+            }
+        }
+        closedir(d);
+    }
+#endif
+    psp_write32(flist + 12, n_sec);
+    psp_write32(flist + 16, n_nor);
+    psp_write32(flist + 20, n_sys);
+    return 0u;
+}
+
+static uint32_t execute_savedata(uint32_t param) {
+    uint32_t mode = psp_read32(param + OFF_MODE);
+    char game_raw[16], file_raw[16], game[20], save[32], file[20], base[960], dir[1024], dir_name[64];
+
+    read_guest_str(param + OFF_GAMENAME, game_raw, sizeof game_raw);
+    read_guest_str(param + OFF_FILENAME, file_raw, sizeof file_raw);
+    if (!sanitize_component(game_raw, game, sizeof game)) return ERR_SAVE_LOAD_PARAM;
+    if (!sanitize_component(file_raw, file, sizeof file)) return ERR_SAVE_LOAD_PARAM;
+    resolve_save_name(param, game, save);
+    savedata_base_dir(base, sizeof base);
+    snprintf(dir_name, sizeof dir_name, "%s%s", game, save);
+    snprintf(dir, sizeof dir, "%s/%s", base, dir_name);
+
+    uint32_t result = 0;
+    switch (mode) {
+    case MODE_AUTOLOAD:
+    case MODE_LOAD:
+    case MODE_LISTLOAD:
+        result = do_load(param, dir, file, 0);
+        break;
+    case MODE_READDATASECURE:
+    case MODE_READDATA:
+        result = do_load(param, dir, file, 1);
+        break;
+    case MODE_AUTOSAVE:
+    case MODE_SAVE:
+    case MODE_LISTSAVE:
+    case MODE_MAKEDATASECURE:
+    case MODE_MAKEDATA:
+    case MODE_WRITEDATASECURE:
+    case MODE_WRITEDATA:
+        result = do_save(param, dir, dir_name, file);
+        break;
+    case MODE_LISTDELETE:
+    case MODE_LISTALLDELETE:
+    case MODE_AUTODELETE:
+    case MODE_DELETE:
+    case MODE_DELETEDATA:
+        if (!path_is_dir(dir)) {
+            result = (mode == MODE_DELETEDATA) ? ERR_SAVE_RW_NO_DATA : ERR_SAVE_DELETE_NO_DATA;
+        } else {
+            delete_dir_recursive(dir);
+            result = 0;
+        }
+        break;
+    case MODE_ERASESECURE:
+    case MODE_ERASE: {
+        char fpath[1080];
+        snprintf(fpath, sizeof fpath, "%s/%s", dir, file);
+        result = (file[0] && remove(fpath) == 0) ? 0u : ERR_SAVE_RW_NO_DATA;
+        break;
+    }
+    case MODE_SIZES:
+        result = do_sizes(param, game);
+        break;
+    case MODE_LIST:
+        result = do_list(param, game);
+        break;
+    case MODE_FILES:
+        result = do_files(param, dir);
+        break;
+    case MODE_GETSIZE:
+        result = do_getsize(param, dir);
+        break;
+    default:
+        result = ERR_SAVE_SAVE_PARAM;
+        break;
+    }
+    return result;
