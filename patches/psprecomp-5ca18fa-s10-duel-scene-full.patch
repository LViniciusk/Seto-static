+static void sw_tex_decode_linear(const psp_draw_state *st, uint32_t * restrict dst) {
+    const int w = st->tex_w, h = st->tex_h, fmt = st->tex_fmt, swz = st->tex_swizzle;
+    const uint8_t * restrict src = g_tex_base;
+    const uint32_t rowb = g_tex_rowb, blocks = g_tex_blocks;
+    if (fmt == PSP_TPSM_T8) {
+        const uint32_t * restrict clut = g_clut_lut;
+        for (int y = 0; y < h; y++) {
+            uint32_t * restrict out = dst + (uint32_t)y * (uint32_t)w;
+            if (!swz) {
+                const uint8_t * restrict row = src + (uint32_t)y * rowb;
+                for (int x = 0; x < w; x++) out[x] = clut[row[x]];
+            } else {
+                const uint8_t * restrict ry = tex_swz_row_ptr(src, blocks, (uint32_t)y);
+                for (int bx = 0; bx < w; bx += 16) {
+                    const uint8_t * restrict blk = ry + ((uint32_t)bx << 3);
+                    const int n = (w - bx) < 16 ? (w - bx) : 16;
+                    for (int k = 0; k < n; k++) out[bx + k] = clut[blk[k]];
+                }
+            }
+        }
+    } else if (fmt == PSP_TPSM_T4) {
+        const uint32_t * restrict clut = g_clut_lut;
+        for (int y = 0; y < h; y++) {
+            uint32_t * restrict out = dst + (uint32_t)y * (uint32_t)w;
+            if (!swz) {
+                const uint8_t * restrict row = src + (uint32_t)y * rowb;
+                int x = 0;
+                for (; x + 1 < w; x += 2) {
+                    const uint8_t b = row[x >> 1];
+                    out[x] = clut[b & 0xFu];
+                    out[x + 1] = clut[b >> 4];
+                }
+                if (x < w) out[x] = clut[row[x >> 1] & 0xFu];
+            } else {
+                const uint8_t * restrict ry = tex_swz_row_ptr(src, blocks, (uint32_t)y);
+                for (int bx = 0; bx < w; bx += 32) {
+                    const uint8_t * restrict blk = ry + ((uint32_t)bx << 2);
+                    const int n = (w - bx) < 32 ? (w - bx) : 32;
+                    int k = 0;
+                    for (; k + 1 < n; k += 2) {
+                        const uint8_t b = blk[k >> 1];
+                        out[bx + k] = clut[b & 0xFu];
+                        out[bx + k + 1] = clut[b >> 4];
+                    }
+                    if (k < n) out[bx + k] = clut[blk[k >> 1] & 0xFu];
+                }
+            }
+        }
+    } else if (fmt == PSP_TPSM_8888) {
+        for (int y = 0; y < h; y++) {
+            uint32_t * restrict out = dst + (uint32_t)y * (uint32_t)w;
+            if (!swz) {
+                memcpy(out, src + (uint32_t)y * rowb, (size_t)w * 4u);
+            } else {
+                const uint8_t * restrict ry = tex_swz_row_ptr(src, blocks, (uint32_t)y);
+                for (int bx = 0; bx < w; bx += 4) {
+                    const int n = (w - bx) < 4 ? (w - bx) : 4;
+                    memcpy(out + bx, ry + ((uint32_t)bx << 5), (size_t)n * 4u);
+                }
+            }
+        }
+    } else if (fmt >= PSP_TPSM_DXT1 && fmt <= PSP_TPSM_DXT5) {
+        const uint32_t blk_sz = (fmt == PSP_TPSM_DXT1) ? 8u : 16u;
+        const uint32_t bw_blks = (uint32_t)(st->tex_bw >> 2);
+        for (int by = 0; by < h; by += 4) {
+            const uint32_t row_blk = (uint32_t)(by >> 2) * bw_blks;
+            for (int bx = 0; bx < w; bx += 4) {
+                const uint8_t * restrict blk = src + (row_blk + (uint32_t)(bx >> 2)) * blk_sz;
+                uint32_t cbits; uint16_t c0, c1;
+                memcpy(&cbits, blk, 4);
+                memcpy(&c0, blk + 4, 2);
+                memcpy(&c1, blk + 6, 2);
+                const uint32_t a = psp_color_expand(c0, 0), b = psp_color_expand(c1, 0);
+                uint32_t pal[4];
+                pal[0] = a;
+                pal[1] = b;
+                if (c0 > c1 || fmt != PSP_TPSM_DXT1) {
+                    pal[2] = rgba((2 * (int)R(a) + (int)R(b)) / 3, (2 * (int)G(a) + (int)G(b)) / 3,
+                                  (2 * (int)B(a) + (int)B(b)) / 3, 255);
+                    pal[3] = rgba(((int)R(a) + 2 * (int)R(b)) / 3, ((int)G(a) + 2 * (int)G(b)) / 3,
+                                  ((int)B(a) + 2 * (int)B(b)) / 3, 255);
+                } else {
+                    pal[2] = rgba(((int)R(a) + (int)R(b)) / 2, ((int)G(a) + (int)G(b)) / 2,
+                                  ((int)B(a) + (int)B(b)) / 2, 255);
+                    pal[3] = 0;
+                }
+                int al5[8];
+                uint64_t abits = 0;
+                if (fmt == PSP_TPSM_DXT5) {
+                    uint32_t ab0; uint16_t ab1;
+                    memcpy(&ab0, blk + 8, 4);
+                    memcpy(&ab1, blk + 12, 2);
+                    abits = (uint64_t)ab1 | ((uint64_t)ab0 << 16);
+                    const int a0 = blk[14], a1 = blk[15];
+                    al5[0] = a0; al5[1] = a1;
+                    for (int k = 2; k < 8; k++) {
+                        if (a0 > a1) al5[k] = ((8 - k) * a0 + (k - 1) * a1) / 7;
+                        else if (k < 6) al5[k] = ((6 - k) * a0 + (k - 1) * a1) / 5;
+                        else al5[k] = k == 6 ? 0 : 255;
+                    }
+                }
+                const int rmax = (h - by) < 4 ? (h - by) : 4;
+                const int cmax = (w - bx) < 4 ? (w - bx) : 4;
+                for (int r = 0; r < rmax; r++) {
+                    uint32_t * restrict out = dst + (uint32_t)(by + r) * (uint32_t)w + (uint32_t)bx;
+                    uint16_t arow = 0;
+                    if (fmt == PSP_TPSM_DXT3) memcpy(&arow, blk + 8 + (uint32_t)r * 2u, 2);
+                    for (int c = 0; c < cmax; c++) {
+                        const uint32_t idx = (uint32_t)(r * 4 + c);
+                        uint32_t px = pal[(cbits >> (2u * idx)) & 3u];
+                        if (fmt == PSP_TPSM_DXT3) {
+                            const uint32_t al = ((uint32_t)(arow >> (c * 4)) & 0xFu) * 17u;
+                            px = (px & 0x00FFFFFFu) | (al << 24);
+                        } else if (fmt == PSP_TPSM_DXT5) {
+                            const uint32_t al = (uint32_t)al5[(abits >> (3u * idx)) & 7u];
+                            px = (px & 0x00FFFFFFu) | (al << 24);
+                        }
+                        out[c] = px;
+                    }
+                }
+            }
+        }
+    } else {
+        for (int y = 0; y < h; y++) {
+            uint32_t * restrict out = dst + (uint32_t)y * (uint32_t)w;
+            if (!swz) {
+                const uint8_t * restrict row = src + (uint32_t)y * rowb;
+                for (int x = 0; x < w; x++) {
+                    uint16_t p;
+                    memcpy(&p, row + (uint32_t)x * 2u, 2);
+                    out[x] = psp_color_expand(p, fmt);
+                }
+            } else {
+                const uint8_t * restrict ry = tex_swz_row_ptr(src, blocks, (uint32_t)y);
+                for (int bx = 0; bx < w; bx += 8) {
+                    const uint8_t * restrict blk = ry + ((uint32_t)bx << 4);
+                    const int n = (w - bx) < 8 ? (w - bx) : 8;
+                    for (int k = 0; k < n; k++) {
+                        uint16_t p;
+                        memcpy(&p, blk + (uint32_t)k * 2u, 2);
+                        out[bx + k] = psp_color_expand(p, fmt);
+                    }
+                }
+            }
+        }
+    }
+}
