+static void test_culling(void) {
+    /* Screen CW triangle (10,10)->(110,10)->(10,110) has positive edge area:
+     * GE_CULL_CW (0) drops it; GE_CULL_CCW (1) keeps it. */
+    for (int fface = 0; fface <= 1; fface++) {
+        psp_ge_reset();
+        clear_fb();
+        begin_list();
+        cmd(0x1D, 1);                              /* BCE */
+        cmd(0x9B, (uint32_t)fface);                /* FFACE */
+        vertex(0, 10, 10, 0xFF00FF00u);
+        vertex(1, 110, 10, 0xFF00FF00u);
+        vertex(2, 10, 110, 0xFF00FF00u);
+        cmd(0x04, (3u << 16) | 3);
+        end_list();
+        CHECK(pixel(20, 20) == (fface ? 0x0000FF00u : 0u),
+              "CW triangle with fface=%d: 0x%08X", fface, pixel(20, 20));
+    }
+
+    /* Triangle strip must preserve orientation across odd triangles. */
+    psp_ge_reset();
+    clear_fb();
+    begin_list();
+    cmd(0x1D, 1);
+    cmd(0x9B, 1);                                  /* keep screen-CW */
+    vertex(0, 10, 10, 0xFFFFFFFFu);                /* v0..v3 form CW quad strip */
+    vertex(1, 60, 10, 0xFFFFFFFFu);
+    vertex(2, 10, 60, 0xFFFFFFFFu);
+    vertex(3, 60, 60, 0xFFFFFFFFu);
+    cmd(0x04, (4u << 16) | 4);
+    end_list();
+    CHECK(pixel(20, 20) == 0x00FFFFFFu && pixel(50, 50) == 0x00FFFFFFu,
+          "strip keeps both halves: TL=%08X BR=%08X", pixel(20, 20), pixel(50, 50));
+
+    /* Clear mode ignores culling. */
+    psp_ge_reset();
+    clear_fb();
+    begin_list();
+    cmd(0x1D, 1);
+    cmd(0x9B, 0);
+    cmd(0xD3, 0x101u);                             /* clear color */
+    vertex(0, 10, 10, 0xFF00FF00u);
+    vertex(1, 110, 10, 0xFF00FF00u);
+    vertex(2, 10, 110, 0xFF00FF00u);
+    cmd(0x04, (3u << 16) | 3);
+    end_list();
+    CHECK(pixel(20, 20) == 0x0000FF00u, "clear mode bypasses culling");
+}
