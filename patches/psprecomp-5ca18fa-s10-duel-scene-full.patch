+    const psp_draw_state *st, int minx, int maxx, int miny, int maxy,
+    int area, float h0, float h1, float h2);
+
+static __attribute__((noinline)) void sw_tri_lin_z_fog_opaque_mw(
+    const psp_vertex *a, const psp_vertex *b, const psp_vertex *c,
+    const psp_draw_state *st, int minx, int maxx, int miny, int maxy,
+    int area, float h0, float h1, float h2);
+
+static __attribute__((noinline)) void sw_tri_lin_z_fog_opaque_flat(
+    const psp_vertex *a, const psp_vertex *b, const psp_vertex *c,
+    const psp_draw_state *st, int minx, int maxx, int miny, int maxy,
+    int area, float h0, float h1, float h2);
+
+static __attribute__((noinline)) void sw_tri_lin_z_fog_opaque_gmw(
+    const psp_vertex *a, const psp_vertex *b, const psp_vertex *c,
+    const psp_draw_state *st, int minx, int maxx, int miny, int maxy,
+    int area, float h0, float h1, float h2);
+
+static __attribute__((noinline)) void sw_tri_lin_z_fog_opaque_gouraud(
+    const psp_vertex *a, const psp_vertex *b, const psp_vertex *c,
+    const psp_draw_state *st, int minx, int maxx, int miny, int maxy,
+    int area, float h0, float h1, float h2);
+
+static __attribute__((noinline)) void sw_tri_lin_za_opaque_fn(
+    const psp_vertex *a, const psp_vertex *b, const psp_vertex *c,
+    const psp_draw_state *st, int minx, int maxx, int miny, int maxy,
+    int area, float h0, float h1, float h2,
+    int ztest, int zwrite, int bilin, int gouraud, int mod_white, int fog, int decal);
+
+#define DECL_TRI_GM(NAME) \
+static __attribute__((noinline)) void NAME( \
+    const psp_vertex *a, const psp_vertex *b, const psp_vertex *c, \
+    const psp_draw_state *st, int minx, int maxx, int miny, int maxy, \
+    int area, float h0, float h1, float h2, int gouraud, int mod_white);
+DECL_TRI_GM(sw_tri_lin_near_opaque_gm)
+DECL_TRI_GM(sw_tri_lin_near_z_opaque_gm)
+DECL_TRI_GM(sw_tri_lin_znw_opaque_gm)
+DECL_TRI_GM(sw_tri_lin_decal_opaque_gm)
+DECL_TRI_GM(sw_tri_lin_z_fog_decal_gm)
+DECL_TRI_GM(sw_tri_t8_z_opaque_gm)
+DECL_TRI_GM(sw_tri_t8_z_fog_opaque_gm)
+#undef DECL_TRI_GM
