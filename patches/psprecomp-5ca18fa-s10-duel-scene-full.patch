+static void test_color_pack_16bit(void) {
+    /* Pure red (ABGR 0xFF0000FF) written to a 16-bit target must pack R in
+     * the high bits and B in the low bits, matching psp_color_expand(). */
+    const int fmts[] = { 0, 1, 2 };
+    const uint16_t want_red[]  = { 0xF800u, 0xFC00u, 0xFF00u };
+    const uint16_t want_blue[] = { 0x001Fu, 0x801Fu, 0xF00Fu };
+    for (int i = 0; i < 3; i++) {
+        psp_ge_reset();
+        psp_write32(FB, 0);
+        g_pc = 0;
+        cmd(0x10, (VERTS >> 8) & 0xFF0000);
+        cmd(0x9C, FB & 0xFFFFFF);
+        cmd(0x9D, ((FB >> 8) & 0xFF0000) | 480);
+        cmd(0xD2, (uint32_t)fmts[i]);             /* PSM */
+        cmd(0xD3, 0x301u);                        /* clear color+alpha to pack A too */
+        cmd(0x12, VTYPE_2D);
+        cmd(0x01, VERTS & 0xFFFFFF);
+        vertex(0, 0, 0, 0xFF0000FFu); vertex(1, 2, 2, 0xFF0000FFu);
+        vertex(2, 2, 0, 0xFFFF0000u); vertex(3, 4, 2, 0xFFFF0000u);
+        cmd(0x04, (6u << 16) | 4);
+        end_list();
+        uint16_t pr = psp_read16(FB);
+        uint16_t pb = psp_read16(FB + 4);
+        CHECK(pr == want_red[i],  "16-bit fmt %d red pack: 0x%04X != 0x%04X", fmts[i], pr, want_red[i]);
+        CHECK(pb == want_blue[i], "16-bit fmt %d blue pack: 0x%04X != 0x%04X", fmts[i], pb, want_blue[i]);
+    }
+}
