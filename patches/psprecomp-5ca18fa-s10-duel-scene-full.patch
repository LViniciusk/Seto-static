+static void test_edram_rtc_utility_atrac(void) {
+    /* sceGeEdramSetAddrTranslation: default 0x400, power-of-two in [0x200..0x1000] or 0. */
+    CHECK(call(psp_nid("sceGeEdramSetAddrTranslation"), 0x800u, 0, 0, 0) == 0x400u,
+          "default edram translation is 0x400");
+    CHECK(call(psp_nid("sceGeEdramSetAddrTranslation"), 0x400u, 0, 0, 0) == 0x800u,
+          "returns previous translation width");
+    CHECK(call(psp_nid("sceGeEdramSetAddrTranslation"), 0x300u, 0, 0, 0) == 0x800201FEu,
+          "rejects non-power-of-two translation width");
+
+    /* sceRtcGetCurrentTick: returns >= 1970-01-01 in PSP RTC microseconds. */
+    const uint32_t TICK_PTR = 0x08901000u;
+    CHECK(call(psp_nid("sceRtcGetCurrentTick"), TICK_PTR, 0, 0, 0) == 0, "sceRtcGetCurrentTick ok");
+    uint64_t tick = (uint64_t)psp_read32(TICK_PTR) | ((uint64_t)psp_read32(TICK_PTR + 4) << 32);
+    CHECK(tick >= 0x00DCDDB30F2F8000ULL, "RTC tick includes PSP epoch offset");
+
+    /* sceUtilityLoadAvModule / UnloadAvModule */
+    CHECK(call(psp_nid("sceUtilityLoadAvModule"), 2, 0, 0, 0) == 0, "load AV ATRAC3PLUS module");
+    CHECK(call(psp_nid("sceUtilityLoadAvModule"), 99, 0, 0, 0) == 0x80110F01u, "reject invalid AV id");
+    CHECK(call(psp_nid("sceUtilityUnloadAvModule"), 2, 0, 0, 0) == 0, "unload AV module");
+
+    /* sceAtrac3plus: minimal RIFF/WAVE AT3+ buffer with fmt + fact + smpl + data. */
+    const uint32_t BUF = 0x08902000u;
+    const uint32_t OUT = 0x08904000u;
+    const uint32_t VARS = 0x08908000u;
+    for (uint32_t i = 0; i < 512; i += 4) psp_write32(BUF + i, 0);
+    psp_write32(BUF + 0,  0x46464952u); /* RIFF */
+    psp_write32(BUF + 4,  400);
+    psp_write32(BUF + 8,  0x45564157u); /* WAVE */
+    psp_write32(BUF + 12, 0x20746D66u); /* fmt  */
+    psp_write32(BUF + 16, 16);
+    psp_write16(BUF + 20, 0xFFFEu);     /* ATRAC3+ */
+    psp_write16(BUF + 22, 2);
+    psp_write32(BUF + 24, 44100);
+    psp_write16(BUF + 32, 240);         /* bytesPerFrame */
+    psp_write32(BUF + 36, 0x74636166u); /* fact */
+    psp_write32(BUF + 40, 4);
+    psp_write32(BUF + 44, 4096);        /* total samples = 2 frames of 2048 */
+    psp_write32(BUF + 48, 0x6C706D73u); /* smpl */
+    psp_write32(BUF + 52, 60);
+    psp_write32(BUF + 56 + 28, 1);      /* numLoops */
+    psp_write32(BUF + 56 + 44, 2048);   /* loopStart */
+    psp_write32(BUF + 56 + 48, 4095);   /* loopEnd */
+    psp_write32(BUF + 116, 0x61746164u);/* data */
+    psp_write32(BUF + 120, 480);
+
+    int32_t aid = (int32_t)call(psp_nid("sceAtracSetDataAndGetID"), BUF, 600, 0, 0);
+    CHECK(aid >= 0, "sceAtracSetDataAndGetID returned valid id %d", aid);
+    CHECK(call(psp_nid("sceAtracGetMaxSample"), (uint32_t)aid, VARS, 0, 0) == 0 &&
+          psp_read32(VARS) == 2048u, "AT3+ maxSample == 2048");
+    CHECK(call(psp_nid("sceAtracGetSoundSample"), (uint32_t)aid, VARS, VARS + 4, VARS + 8) == 0 &&
+          psp_read32(VARS) == 4095u && psp_read32(VARS + 4) == 2048u && psp_read32(VARS + 8) == 4095u,
+          "sound sample metadata parsed (0-based inclusive endSample)");
+    /* Play once to end without looping: 2 calls of 2048 samples -> finish=1, 3rd returns ALL_DATA_DECODED. */
+    CHECK(call5(psp_nid("sceAtracDecodeData"), (uint32_t)aid, OUT, VARS, VARS + 4, VARS + 8) == 0 &&
+          psp_read32(VARS) == 2048u && psp_read32(VARS + 4) == 0u, "decode frame 1");
+    CHECK(call5(psp_nid("sceAtracDecodeData"), (uint32_t)aid, OUT, VARS, VARS + 4, VARS + 8) == 0 &&
+          psp_read32(VARS) == 2048u && psp_read32(VARS + 4) == 1u, "decode frame 2 hits finish=1");
+    CHECK(call5(psp_nid("sceAtracDecodeData"), (uint32_t)aid, OUT, VARS, VARS + 4, VARS + 8) == 0x80630024u,
+          "decode past end returns SCE_ERROR_ATRAC_ALL_DATA_DECODED");
+    CHECK(call(psp_nid("sceAtracResetPlayPosition"), (uint32_t)aid, 0, 0, 0) == 0, "reset pos ok");
+    CHECK(call(psp_nid("sceAtracSetLoopNum"), (uint32_t)aid, 1, 0, 0) == 0, "set loop num ok");
+    CHECK(call(psp_nid("sceAtracGetLoopStatus"), (uint32_t)aid, VARS, VARS + 4, 0) == 0 &&
+          psp_read32(VARS) == 1u && psp_read32(VARS + 4) == 1u, "loop status reported");
+    CHECK(call(psp_nid("sceAtracResetPlayPosition"), (uint32_t)aid, 4096, 0, 0) == 0x80630015u,
+          "reset pos == total samples returns SCE_ERROR_ATRAC_BAD_SAMPLE");
+    CHECK(call(psp_nid("sceAtracResetPlayPosition"), (uint32_t)aid, 4095, 0, 0) == 0,
+          "reset pos == endSample (4095) ok");
+    CHECK(call(psp_nid("sceAtracReleaseAtracID"), (uint32_t)aid, 0, 0, 0) == 0, "release atrac id");
+
+    /* Encoder delay (fact[1]) adjusts smpl loop points; DecodeData decodes endSample + 1 samples. */
+    psp_write32(BUF + 40, 8);
+    psp_write32(BUF + 44, 5000);        /* fact[0]: playable samples */
+    psp_write32(BUF + 48, 2048);        /* fact[1]: encoder delay */
+    psp_write32(BUF + 52, 0x6C706D73u); /* smpl */
+    psp_write32(BUF + 56, 60);
+    psp_write32(BUF + 60 + 28, 1);
+    psp_write32(BUF + 60 + 44, 4048);   /* 2000 + 2048 */
+    psp_write32(BUF + 60 + 48, 7047);   /* 4999 + 2048 */
+    psp_write32(BUF + 120, 0x61746164u);/* data */
+    psp_write32(BUF + 124, 720);
+    int32_t aid2 = (int32_t)call(psp_nid("sceAtracSetDataAndGetID"), BUF, 600, 0, 0);
+    CHECK(aid2 >= 0, "atrac with fact[1] delay opened (%d)", aid2);
+    CHECK(call(psp_nid("sceAtracGetSoundSample"), (uint32_t)aid2, VARS, VARS + 4, VARS + 8) == 0 &&
+          psp_read32(VARS) == 4999u && psp_read32(VARS + 4) == 2000u && psp_read32(VARS + 8) == 4999u,
+          "fact[1] subtracted from smpl loop points and endSample is N-1");
+    uint32_t total_dec = 0, end_f = 0;
+    for (int iter = 0; iter < 5 && !end_f; iter++) {
+        CHECK(call5(psp_nid("sceAtracDecodeData"), (uint32_t)aid2, OUT, VARS, VARS + 4, VARS + 8) == 0,
+              "decode non-loop frame %d ok", iter);
+        total_dec += psp_read32(VARS);
+        end_f = psp_read32(VARS + 4);
+    }
+    CHECK(end_f == 1u && total_dec == 5000u,
+          "decoded exact endSample+1 (%u) samples without 1-sample gap", total_dec);
+    CHECK(call(psp_nid("sceAtracReleaseAtracID"), (uint32_t)aid2, 0, 0, 0) == 0, "release aid2");
+}
+
+static void write_gstr(uint32_t addr, const char *s) {
+    while (*s) psp_write8(addr++, (uint8_t)*s++);
+    psp_write8(addr, 0);
+}
+
+static void zero_guest(uint32_t addr, uint32_t len) {
+    for (uint32_t i = 0; i < len; i++) psp_write8(addr + i, 0);
+}
+
+static void run_savedata_op(uint32_t param) {
+    CHECK(call(psp_nid("sceUtilitySavedataInitStart"), param, 0, 0, 0) == 0, "savedata init ok");
+    CHECK(call(psp_nid("sceUtilitySavedataGetStatus"), 0, 0, 0, 0) == 1u, "savedata status INIT");
+    CHECK(call(psp_nid("sceUtilitySavedataGetStatus"), 0, 0, 0, 0) == 2u, "savedata status RUNNING");
+    CHECK(call(psp_nid("sceUtilitySavedataUpdate"), 1, 0, 0, 0) == 0, "savedata update ok");
+    CHECK(call(psp_nid("sceUtilitySavedataGetStatus"), 0, 0, 0, 0) == 3u, "savedata status FINISHED");
+    CHECK(call(psp_nid("sceUtilitySavedataShutdownStart"), 0, 0, 0, 0) == 0, "savedata shutdown ok");
+    CHECK(call(psp_nid("sceUtilitySavedataGetStatus"), 0, 0, 0, 0) == 4u, "savedata status SHUTDOWN");
+    CHECK(call(psp_nid("sceUtilitySavedataGetStatus"), 0, 0, 0, 0) == 0u, "savedata status NONE after shutdown");
+    CHECK(call(psp_nid("sceUtilitySavedataGetStatus"), 0, 0, 0, 0) == 0x80110005u, "savedata status WRONG_TYPE when idle");
+}
