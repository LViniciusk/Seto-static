+static int stencil_op(int op, int old, int ref) {
+    const int step = g_fb_fmt == 1 ? 255 : g_fb_fmt == 2 ? 17 : 1;
+    switch (op) {
+    case 1: return 0;
+    case 2: return ref;
+    case 3: return old ^ 255;
+    case 4: return old + step > 255 ? 255 : old + step;
+    case 5: return old < step ? 0 : old - step;
+    default: return old;
+    }
