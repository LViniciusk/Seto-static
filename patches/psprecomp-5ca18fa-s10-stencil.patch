+
+/* Field composition: mark room pixels, then fill only the unmarked background. */
+static void test_stencil_composition(void) {
+    psp_ge_reset();
+    clear_fb();
+    begin_list();
+    vertex(0, 0, 0, 0);
+    vertex(1, 8, 8, 0);
+    cmd(0xD3, 0x000201);                          /* clear stencil, not RGB */
+    cmd(0x04, (6u << 16) | 2);
+    cmd(0xD3, 0);
+    cmd(0x24, 1);                                 /* STE */
+    cmd(0xDC, 0xFF0201);                          /* ALWAYS, ref 2 */
+    cmd(0xDD, 0x020000);                          /* KEEP/KEEP/REPLACE */
+    vertex(2, 2, 2, 0xFF0000FFu);
+    vertex(3, 6, 6, 0xFF0000FFu);
+    cmd(0x04, (6u << 16) | 2);
+    cmd(0xDC, 0xFF0002);                          /* EQUAL, ref 0 */
+    cmd(0xDD, 0);                                 /* KEEP */
+    vertex(4, 0, 0, 0xFF00FF00u);
+    vertex(5, 8, 8, 0xFF00FF00u);
+    cmd(0x04, (6u << 16) | 2);
+    end_list();
+    CHECK(pixel(3, 3) == 0x020000FFu, "background must not cover room: %08X", pixel(3, 3));
+    CHECK(pixel(1, 1) == 0x0000FF00u, "background fills unmarked pixels: %08X", pixel(1, 1));
+
+    /* Disabling stencil must preserve it, and write masks must protect RGB/alpha. */
+    begin_list();
+    cmd(0x24, 0);
+    cmd(0xE8, 0xFFFFFF);
+    vertex(0, 2, 2, 0xFFFFFFFFu);
+    vertex(1, 6, 6, 0xFFFFFFFFu);
+    cmd(0x04, (6u << 16) | 2);
+    end_list();
+    CHECK(pixel(3, 3) == 0x020000FFu, "disabled stencil and RGB mask preserve room");
+    begin_list();
+    cmd(0x24, 1);
+    cmd(0xDC, 0xFF0701);
+    cmd(0xDD, 0x020000);
+    cmd(0xE9, 0xFF);
+    cmd(0x04, (6u << 16) | 2);
+    end_list();
+    CHECK(pixel(3, 3) == 0x020000FFu, "alpha mask protects stencil replacement");
+}
+
+static void test_stencil_ops(void) {
+    const int expected[] = { 0x55, 0, 0x23, 0xAA, 0x56, 0x54 };
+    for (int outcome = 0; outcome < 3; outcome++) {
+        for (int op = 0; op < 6; op++) {
+            psp_ge_reset();
+            psp_write32(FB, 0x550000FFu);
+            begin_list();
+            cmd(0x24, 1);
+            cmd(0xDC, 0xFF2300 | (outcome != 0)); /* NEVER on stencil failure */
+            cmd(0xDD, (uint32_t)op << (outcome * 8));
+            cmd(0x9E, 0x110000);
+            cmd(0x9F, 480);
+            cmd(0x23, 1);
+            cmd(0xDE, outcome == 1 ? 0 : 1);    /* NEVER on depth failure */
+            vertex(0, 0, 0, 0xFF00FF00u);
+            vertex(1, 1, 1, 0xFF00FF00u);
+            cmd(0x04, (6u << 16) | 2);
+            end_list();
+            const uint32_t want = ((uint32_t)expected[op] << 24) |
+                                  (outcome == 2 ? 0x00FF00u : 0x0000FFu);
+            CHECK(pixel(0, 0) == want, "stencil outcome %d op %d: %08X != %08X",
+                  outcome, op, pixel(0, 0), want);
+        }
+    }
 }
 
