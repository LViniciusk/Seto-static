+
+static void fb_write(uint32_t at, uint32_t c, uint32_t mask) {
+    if (g_fb_fmt == 3) psp_write32(at, (c & ~mask) | (psp_read32(at) & mask));
+    else {
+        mask = color_pack(mask, g_fb_fmt);
+        psp_write16(at, (uint16_t)((color_pack(c, g_fb_fmt) & ~mask) | (psp_read16(at) & mask)));
+    }
+    g_pixels++;
