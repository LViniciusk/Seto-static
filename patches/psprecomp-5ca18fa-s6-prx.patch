+/* disc0:/sce_lbn0x<lbn>_size0x<size> names a byte range of the UMD image. Open
+ * the image at that sector and remember the extent so a read cannot wander
+ * into the next file. Offsets stay below 2 GB (the disc image does), which is
+ * what a 32-bit host fseek can address. */
+static FILE *open_lbn(const char *guest, uint64_t *start, uint64_t *end) {
+    unsigned long lbn, size;
+    if (sscanf(guest, "disc0:/sce_lbn0x%lx_size0x%lx", &lbn, &size) != 2)
+        return NULL;
+    if (!g_umd[0]) return NULL;
+    FILE *f = fopen(g_umd, "rb");
+    if (!f) return NULL;
+    uint64_t off = (uint64_t)lbn * 2048u;
+    if (off > 0x7FFFFFFFull || fseek(f, (long)off, SEEK_SET) != 0) {
+        fclose(f);
+        return NULL;
+    }
+    *start = off;
+    *end = off + (uint64_t)size;
+    return f;
+}
