+/* VFPU9 butterfly: each input pair becomes (sum, difference). Used by the
+ * game's colour conversion; the four-lane form handles both pairs. */
+void psp_vbfy1(uint32_t vd, uint32_t vs, int size) {
+    float s[4], out[4];
+    int n = size == 4 ? 4 : 2;
+    read_src(0, vs, n, s);
+    out[0] = s[0] + s[1];
+    out[1] = s[0] - s[1];
+    if (n == 4) {
+        out[2] = s[2] + s[3];
+        out[3] = s[2] - s[3];
+    }
+    write_dst(vd, n, out);
+    end_op();
+}
+
