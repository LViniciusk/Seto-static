+/* Resolve once per draw, never across guest writes, module reloads or watches. */
+typedef struct { uint32_t addr; uint8_t *data; } render_span;
+static render_span g_fb_span, g_z_span, g_tex_span;
+
+static void map_span(render_span *s, uint32_t addr, uint64_t size) {
+    s->addr = addr;
+    s->data = size && size <= UINT32_MAX ? psp_mem_unwatched_ptr(addr, (uint32_t)size) : NULL;
+}
+
+static uint32_t span_read32(const render_span *s, uint32_t addr) {
+    uint32_t v;
+    if (!s->data) return psp_read32(addr);
+    memcpy(&v, s->data + (uint32_t)(addr - s->addr), sizeof v);
+    return v;
+}
+
+static uint16_t span_read16(const render_span *s, uint32_t addr) {
+    uint16_t v;
+    if (!s->data) return psp_read16(addr);
+    memcpy(&v, s->data + (uint32_t)(addr - s->addr), sizeof v);
+    return v;
+}
+
+static uint8_t span_read8(const render_span *s, uint32_t addr) {
+    return s->data ? s->data[(uint32_t)(addr - s->addr)] : psp_read8(addr);
+}
+
+static void span_write32(const render_span *s, uint32_t addr, uint32_t value) {
+    if (s->data) memcpy(s->data + (uint32_t)(addr - s->addr), &value, sizeof value);
+    else psp_write32(addr, value);
+}
+
+static void span_write16(const render_span *s, uint32_t addr, uint16_t value) {
+    if (s->data) memcpy(s->data + (uint32_t)(addr - s->addr), &value, sizeof value);
+    else psp_write16(addr, value);
+}
 
