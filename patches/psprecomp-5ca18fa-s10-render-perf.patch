+void *psp_mem_unwatched_ptr(uint32_t addr, uint32_t size) {
+    if (g_wwatch || g_rwatch) return NULL;
+    const uint32_t a = addr & PSP_ADDR_MASK;
+    /* A span must not jump over a higher-priority module mapping. */
+    if (g_module_size && g_module_base > a && g_module_base - a < size) return NULL;
+    for (int i = 0; i < PSP_MAX_EXTRA; i++)
+        if (g_extra[i].size && g_extra[i].base > a && g_extra[i].base - a < size) return NULL;
+    return psp_mem_ptr(addr, size);
+}
+
